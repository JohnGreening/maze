 904  9938 22 61 91             ld (baddie_x), hl
 905  993B 7D                   ld a, l
 906  993C E6 07                and 7
 907  993E FD 67                ld iyh, a
 908  9940                      DIV_HL_8                                    ; div by 8 to get tile Y
 908  9940             >; simple 16-bit divide without the CALL/RET overhead
 908  9940 CB 3C       >        srl h                                       ; divide by 2
 908  9942 CB 1D       >        rr l
 908  9944 CB 3C       >        srl h                                       ; divide by 4
 908  9946 CB 1D       >        rr l
 908  9948 CB 3C       >        srl h                                       ; divide by 8
 908  994A CB 1D       >        rr l
 909  994C 45                   ld b, l                                     ; save in B, see newTile below
 910  994D
 911  994D DD 66 04             ld h, (ix +baddieRecord.highY)              ; get baddie Y
 912  9950 DD 6E 03             ld l, (ix +baddieRecord.lowY)
 913  9953 22 63 91             ld (baddie_y), hl
 914  9956 7D                   ld a, l
 915  9957 E6 07                and 7
 916  9959 FD 6F                ld iyl, a
 917  995B                      DIV_HL_8                                    ; divide by 8 to get tile Y
 917  995B             >; simple 16-bit divide without the CALL/RET overhead
 917  995B CB 3C       >        srl h                                       ; divide by 2
 917  995D CB 1D       >        rr l
 917  995F CB 3C       >        srl h                                       ; divide by 4
 917  9961 CB 1D       >        rr l
 917  9963 CB 3C       >        srl h                                       ; divide by 8
 917  9965 CB 1D       >        rr l
 918  9967 4D                   ld c, l                                     ; save in C, see newTile below
 919  9968
 920  9968              ; Decide only when grid-aligned (iyh==0 AND iyl==0) - the only
 921  9968                      ; moment a turn is possible. "Tile changed" fired at the far tile
 922  9968                      ; edge when moving up/left, where the turn check is gated out.
 923  9968 FD 7C                ld a, iyh
 924  996A FD B5                or iyl                                      ; both zero => on grid intersection
 925  996C 28 07                jr z, newTile                               ; aligned -> run the decision
 926  996E
 927  996E DD 7E 07             ld a, (ix +baddieRecord.dir)                ; not aligned -> continue current dir
 928  9971 47                   ld b, a
 929  9972 C3 EC 99             jp reverse
 930  9975
 931  9975              newTile:
 932  9975 DD 70 05             ld (ix +baddieRecord.tileX), b              ; save the tile X
 933  9978 DD 71 06             ld (ix +baddieRecord.tileY), c              ; save the tile Y
 934  997B
 935  997B                      ; get reverse direction
 936  997B DD 7E 07             ld a, (ix + baddieRecord.dir)               ; Load current direction
 937  997E 47                   ld b, a                                     ; Backup original direction to B
 938  997F E6 03                and %00000011                               ; Check for Left (1) / Right (2)
 939  9981 28 05                jr z, .vertMask                             ; If 0, it must be vertical (Up/Down)
 940  9983
 941  9983                      ; Horizontal Path: Swap 1 <-> 2
 942  9983                      ; 'A' already contains ONLY the horizontal bits here
 943  9983 EE 03                xor %00000011                               ; 1 becomes 2, 2 becomes 1
 944  9985 47                   ld b, a                                     ; Store final result in B
 945  9986 18 04                jr .done
 946  9988
 947  9988              .vertMask:
 948  9988                      ; Vertical Path: Swap 4 <-> 8
 949  9988                      ; Because 'A' was 0, 'B' still holds the unaltered original vertical value
 950  9988 78                   ld a, b                                     ; Bring original back to A to process
 951  9989 EE 0C                xor %00001100                               ; 4 becomes 8, 8 becomes 4
 952  998B 47                   ld b, a                                     ; Store final result in B
 953  998C
 954  998C              .done:
 955  998C                      ; d holds current direction (bitmask)
 956  998C C5                   push bc                                     ; save reverse on stack for use later
 957  998D 3E 0F                ld a, %00001111                             ; start with all directions
 958  998F A8                   xor b                                       ; mask out reverse
 959  9990
 960  9990              ; -----------------------------------------------
 961  9990              ; Test each direction to see if a move is allowed
 962  9990              ; -----------------------------------------------
 963  9990 57                   ld d, a                                     ; D = directions to test (all except reverse)
 964  9991 1E 00                ld e, 0                                     ; E = available directions found
 965  9993
 966  9993 CB 42                bit dir_left, d
 967  9995 C4 C3 9A             call nz, chkLeft1
 968  9998
 969  9998 CB 4A                bit dir_right, d
 970  999A C4 2C 9B             call nz, chkRight1
 971  999D
 972  999D CB 52                bit dir_down, d
 973  999F C4 99 9B             call nz, chkDown1
 974  99A2
 975  99A2 CB 5A                bit dir_up, d
 976  99A4 C4 06 9C             call nz, chkUp1
 977  99A7
 978  99A7              ;-----------------------
 979  99A7              ; pick direction to take
 980  99A7              ; ----------------------
 981  99A7 C1                   pop bc                                      ; retrieve the saved reverse direction
 982  99A8 7B                   ld a, e                                     ; get what moves were possible
 983  99A9 A7                   and a                                       ; are there any?
 984  99AA 28 40                jr z, reverse
