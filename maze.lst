1482  F380
1483  F380              ; ----------------------------------------------------------------
1484  F380              ; Tilemap data - 48 KB stored directly in Pages 40 - 45
1485  F380              ; ----------------------------------------------------------------
1486  F380              TILEMAP_PAGE    EQU     40
1487  F380
1488  F380              ; === Chunk 1 (bytes 0-16383) -> 8 KB Page 40/41 ===
1489  F380              MMU     6, TILEMAP_PAGE                             ; map page 40 into slot 6
1490  F380              MMU     7, TILEMAP_PAGE + 1                         ; map page 41 into slot 7
1491  F380              ORG     $C000
1492  C000              tilemap_part1:
1493  C000              INCBIN  "testmaze.map", 0, 16384                    ; first 16 KB
1494  0000
1495  0000              ; === Chunk 2 (bytes 16384-32767) -> 8 KB Page 42/43 ===
1496  0000              MMU     6, TILEMAP_PAGE + 2
1497  0000              MMU     7, TILEMAP_PAGE + 3
1498  0000              ORG     $C000
1499  C000              tilemap_part2:
1500  C000              INCBIN  "testmaze.map", 16384, 16384
1501  0000
1502  0000              ; === Chunk 3 (bytes 32768-49151) -> 8 KB Page 44/45 ===
1503  0000              MMU     6, TILEMAP_PAGE + 4
1504  0000              MMU     7, TILEMAP_PAGE + 5
1505  0000              ORG     $C000
1506  C000              tilemap_part3:
1507  C000              INCBIN  "testmaze.map", 32768, 16384
1508  0000
1509  0000              ; ----------------------------------------------------------------
1510  0000              ; Distance field - 48 KB, one byte per maze cell (256x192).
1511  0000              ; Same layout as the map (256-byte rows) but in pages 46-51, so the
1512  0000              ; tile (x,y) -> address arithmetic is identical to GET_WORLD_VALUE
1513  0000              ; with base page DFIELD_PAGE instead of TILEMAP_PAGE.
1514  0000              ; Filled by the flood-fill; 255 = wall/unvisited/unreachable.
1515  0000              ; ----------------------------------------------------------------
1516  0000              DFIELD_PAGE     EQU     TILEMAP_PAGE + 6
1517  0000
1518  0000              ; reserve the six pages so they exist in the .nex (contents set at runtime)
1519  0000              MMU     6, DFIELD_PAGE
1520  0000              MMU     7, DFIELD_PAGE + 1
1521  0000              ORG     $C000
1522  C000              dfield_part1:
1523  C000 00 00 00...  DEFS    16384
1524  0000
1525  0000              MMU     6, DFIELD_PAGE + 2
1526  0000              MMU     7, DFIELD_PAGE + 3
1527  0000              ORG     $C000
1528  C000              dfield_part2:
1529  C000 00 00 00...  DEFS    16384
1530  0000
1531  0000              MMU     6, DFIELD_PAGE + 4
1532  0000              MMU     7, DFIELD_PAGE + 5
1533  0000              ORG     $C000
1534  C000              dfield_part3:
1535  C000 00 00 00...  DEFS    16384
1536  0000
1537  0000              ; --- radar / Layer 2 ---
1538  0000              MAP_PAGE        equ TILEMAP_PAGE        ; map data lives here (40)
1539  0000              L2_PAGE         equ DFIELD_PAGE + 6     ; Layer 2 image pages (52-57), after the field
1540  0000              L2_BANK16       equ L2_PAGE / 2         ; 16K bank number for reg $12 (=26)
1541  0000
1542  0000              MMU 6, L2_PAGE
1543  0000              MMU 7, L2_PAGE + 1
1544  0000              org $C000
1545  C000 00 00 00...  DEFS 16384
1546  0000
1547  0000              MMU 6, L2_PAGE + 2
1548  0000              MMU 7, L2_PAGE + 3
1549  0000              org $C000
1550  C000 00 00 00...  DEFS 16384
1551  0000
1552  0000              MMU 6, L2_PAGE + 4
1553  0000              MMU 7, L2_PAGE + 5
1554  0000              org $C000
1555  C000 00 00 00...  DEFS 16384
1556  0000
1557  0000              ; ----------------------------------------------------------------
1558  0000              ; Build the .nex file (automatically includes all used banks)
1559  0000              ; ----------------------------------------------------------------
1560  0000              SAVENEX OPEN "maze.nex", progStart, $FF40           ; entry point + stack
1561  0000              SAVENEX AUTO                                        ; include all pages we used
1562  0000              SAVENEX CLOSE
