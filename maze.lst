 400  9506              ; ============================================================
 401  9506              ; updateCameraXY - recompute camera from player, clamped to map.
 402  9506              ;   cam = player - CENTRE, then clamped to [0 .. CAM_MAX]
 403  9506              ; Low clamp: if (player - CENTRE) < 0  -> 0   (sign test)
 404  9506              ; High clamp: if value > CAM_MAX       -> CAM_MAX
 405  9506              ; ============================================================
 406  9506              updateCameraXY:
 407  9506 CD E9 80             call addScore
 408  9509
 409  9509                      ; ---------- X ----------
 410  9509 2A D0 8E             ld hl, (player_px)
 411  950C 01 98 00             ld bc, CENTRE_X
 412  950F B7                   or a
 413  9510 ED 42                sbc hl, bc                      ; hl = player_px - CENTRE_X
 414  9512 F2 18 95             jp p, .camXLowOK                ; >= 0 -> keep
 415  9515 21 00 00             ld hl, 0                        ; negative -> clamp to 0
 416  9518              .camXLowOK:
 417  9518 01 C0 06             ld bc, CAM_MAX_X
 418  951B B7                   or a
 419  951C ED 42                sbc hl, bc                      ; hl = value - CAM_MAX_X
 420  951E 38 03                jr c, .camXHighOK               ; carry set => value < max -> keep (after add back)
 421  9520 21 00 00             ld hl, 0                        ; value >= max -> result = max (after add back)
 422  9523              .camXHighOK:
 423  9523 09                   add hl, bc                      ; add CAM_MAX_X back
 424  9524 22 BF 8E             ld (cam_px), hl
 425  9527
 426  9527                      ; ---------- Y ----------
 427  9527 2A D2 8E             ld hl, (player_py)
 428  952A 01 78 00             ld bc, CENTRE_Y
 429  952D B7                   or a
 430  952E ED 42                sbc hl, bc                      ; hl = player_py - CENTRE_Y
 431  9530 F2 36 95             jp p, .camYLowOK
 432  9533 21 00 00             ld hl, 0
