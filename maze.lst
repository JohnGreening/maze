1086  9BD6             >; version 2, 40 t-states (8 t-states quicker than DIV_HL_8)
1086  9BD6             >; simple 16-bit divide without the CALL/RET overhead
1086  9BD6 7D          >        ld a, l                                     ; get low byte into a ready for rotate from carry   4t
1086  9BD7 CB 3C       >        srl h                                       ;                                                   8t
