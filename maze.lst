 985  9A00              ; ============================================================
 986  9A00              ; pickByField - of the available directions (mask in E), choose the
 987  9A00              ; neighbour with the lowest field distance. Returns vdir flag in A,
 988  9A00              ; or 0 if none usable. Reads tileX/tileY from the record.
 989  9A00              ; ============================================================
 990  9A00              pickByField:
 991  9A00 DD 46 05             ld b, (ix + baddieRecord.tileX)             ; get baddie tile X
 992  9A03 DD 4E 06             ld c, (ix + baddieRecord.tileY)             ; get baddie tile Y
 993  9A06 DD 7E 0A             ld a, (ix + baddieRecord.lastDist)          ; own-cell distance
 994  9A09 32 A9 9A             ld (pf_best), a                             ; save best found
 995  9A0C
 996  9A0C AF                   xor a                                       ; A = 0
 997  9A0D 32 AA 9A             ld (pf_dir), a                              ; current direction is nothing
 998  9A10
 999  9A10 CB 43                bit dir_left, e                             ; is a turn left permitted
1000  9A12 28 1E                jr z, .noL                                  ; branch if not
1001  9A14 78                   ld a, b                                     ; get tile X
1002  9A15 3D                   dec a                                       ; look left
1003  9A16 6F                   ld l, a                                     ; put test tile X in H for lookup
1004  9A17 61                   ld h, c                                     ; put tile Y in L for lookup
