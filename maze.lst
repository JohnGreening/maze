 419  959B B7                   or a
 420  959C ED 42                sbc hl, bc                                  ; hl = player_px - CENTRE_X
 421  959E F2 A4 95             jp p, .camXLowOK                            ; >= 0 -> keep
 422  95A1 21 00 00             ld hl, 0                                    ; negative -> clamp to 0
 423  95A4              .camXLowOK:
 424  95A4 01 C0 06             ld bc, CAM_MAX_X
 425  95A7 B7                   or a
 426  95A8 ED 42                sbc hl, bc                                  ; hl = value - CAM_MAX_X
 427  95AA 38 03                jr c, .camXHighOK                           ; carry set => value < max -> keep (after add back)
 428  95AC 21 00 00             ld hl, 0                                    ; value >= max -> result = max (after add back)
 429  95AF              .camXHighOK:
 430  95AF 09                   add hl, bc                                  ; add CAM_MAX_X back
 431  95B0 22 56 8F             ld (cam_px), hl
