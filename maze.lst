 152+ 8815                      GET_WORLD_VALUE DFIELD_PAGE, USE_HL
 152+ 8815             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 152+ 8815             >;
 152+ 8815             >;       arg  is TILEMAP_PAGE
 152+ 8815             >;            or DFIELD_PAGE
 152+ 8815             >;
 152+ 8815             >;       arg1 decides if input comes from BC or directly from HL
 152+ 8815             >;            NB if directly from HL then L = tile X, H = tile Y
 152+ 8815             >;
 152+ 8815             >        if USE_HL = 0
 152+ 8815 ~           >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 152+ 8815 ~           >                                                    ; put it in H (this is the same as multiplying by 256)
 152+ 8815 ~           >        ld l, b                                     ; read the X tile coordinate into L
 152+ 8815 ~           >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 152+ 8815 ~           >                                                    ; This is the byte offset into "world" map.
 152+ 8815             >        endif
 152+ 8815             >
 152+ 8815             >    ; STEP 2: Calculate which 8K physical page the data lives in
 152+ 8815 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 152+ 8816             >;        srl  a                                      ; divide by 2
 152+ 8816             >;        srl  a                                      ; divide by 2 again  → now /4
 152+ 8816             >;        srl  a                                      ; /8
 152+ 8816             >;        srl  a                                      ; /16
 152+ 8816             >;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 152+ 8816             >; ------------------------------------------------------------------------
 152+ 8816             >; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
 152+ 8816             >; saves 21 t-state
 152+ 8816             >; ------------------------------------------------------------------------
 152+ 8816 07          >        rlca
 152+ 8817 07          >        rlca
 152+ 8818 07          >        rlca
 152+ 8819 E6 07       >        and 7
 152+ 881B             >                                                    ; Why divide by 32?
 152+ 881B             >                                                    ;   Each page is 8192 bytes.
 152+ 881B             >                                                    ;   Each row is 256 bytes.
 152+ 881B             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 152+ 881B             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 152+ 881B             >
 152+ 881B C6 2E       >        add  a, DFIELD_PAGE                                 ; add the starting page number
 152+ 881D 32 01 90    >        ld (curWorldPage), a                        ; save page for subsequent reads - likely no need to reload
 152+ 8820 ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 152+ 8823             >
 152+ 8823             >
 152+ 8823             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 152+ 8823 7C          >        ld   a,h                                    ; get the high byte again
 152+ 8824 E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 152+ 8826             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 152+ 8826             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 152+ 8826 F6 C0       >        or $C0                                      ; "add" page offset
 152+ 8828 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 152+ 8829             >
 152+ 8829             >    ; STEP 4: read the byte
 152+ 8829             >                                                    ; HL now points directly at the first byte we want to copy
 152+ 8829 7E          >        ld a, (hl)                                  ; so get the byte
