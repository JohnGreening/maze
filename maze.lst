 661  9760                      ; --- choose pattern from facing direction + animation frame ---
 662  9760 3A E2 8E             ld a, (lastMove)                            ; vdir flag: 1=L 2=R 4=D 8=U
 663  9763 06 04                ld b, PAT_DOWN                              ; default down
 664  9765 FE 01                cp vdir_left
 665  9767 20 04                jr nz, .notL
 666  9769 06 0C                ld b, PAT_LEFT
 667  976B 18 0E                jr .haveBase
 668  976D              .notL:
 669  976D FE 02                cp vdir_right
 670  976F 20 04                jr nz, .notR
 671  9771 06 08                ld b, PAT_RIGHT
 672  9773 18 06                jr .haveBase
 673  9775              .notR:
 674  9775 FE 08                cp vdir_up
 675  9777 20 02                jr nz, .haveBase                            ; else stays PAT_DOWN
 676  9779 06 10                ld b, PAT_UP
 677  977B              .haveBase:
 678  977B 3A E3 8E             ld a, (playerAnimFrame)                     ; 0-3
 679  977E 80                   add a, b                                    ; base + frame = pattern
 680  977F
 681  977F F6 80                OR %10000000                                ; bit 7 = visible
 682  9781 ED 92 38             NEXTREG $38, A
 683  9784 C9                   RET
