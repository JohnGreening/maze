1087  9A58             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
1087  9A58             >;
1087  9A58             >;       arg  is TILEMAP_PAGE
1087  9A58             >;            or DFIELD_PAGE
1087  9A58             >;
1087  9A58             >;       arg1 decides if input comes from BC or directly from HL
1087  9A58             >;            NB if directly from HL then L = tile X, H = tile Y
1087  9A58             >;
1087  9A58             >        if USE_HL = 0
1087  9A58 ~           >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
1087  9A58 ~           >                                                    ; put it in H (this is the same as multiplying by 256)
1087  9A58 ~           >        ld l, b                                     ; read the X tile coordinate into L
1087  9A58 ~           >                                                    ; Result: HL now holds tile_y * 256 + tile_x
1087  9A58 ~           >                                                    ; This is the byte offset into "world" map.
1087  9A58             >        endif
1087  9A58             >
1087  9A58             >    ; STEP 2: Calculate which 8K physical page the data lives in
1087  9A58 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
1087  9A59 CB 3F       >        srl  a                                      ; divide by 2
1087  9A5B CB 3F       >        srl  a                                      ; divide by 2 again  → now /4
1087  9A5D CB 3F       >        srl  a                                      ; /8
1087  9A5F CB 3F       >        srl  a                                      ; /16
1087  9A61 CB 3F       >        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
1087  9A63             >                                                    ; Why divide by 32?
1087  9A63             >                                                    ;   Each page is 8192 bytes.
1087  9A63             >                                                    ;   Each row is 256 bytes.
1087  9A63             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
1087  9A63             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
1087  9A63             >
1087  9A63 C6 2E       >        add  a, DFIELD_PAGE                                 ; add the starting page number
1087  9A65             >
1087  9A65 ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
1087  9A68             >
1087  9A68             >
1087  9A68             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
1087  9A68 7C          >        ld   a,h                                    ; get the high byte again
1087  9A69 E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
1087  9A6B             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
1087  9A6B             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
1087  9A6B 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
1087  9A6C             >
1087  9A6C             >    ; STEP 4: add the page offset so we can read it
1087  9A6C ED 34 00 C0 >        add  hl, $C000                              ; HL = $C000 + offset_inside_page
1087  9A70             >                                                    ; HL now points directly at the first byte we want to copy
1087  9A70 7E          >        ld a, (hl)                                  ; so get the byte
