  21+ 8657              displayText:
  22+ 8657              ; IY = text string, terminate with $FF, set AT with 22, Y, X
  23+ 8657              ; corrupts IY, AF, BC
  24+ 8657 01 00 00             ld bc, 0                                    ; set B (y) = 0 and C (x) = 0
  25+ 865A              .loop
  26+ 865A FD 7E 00             ld a, (IY +0)                               ; get control or char to display
  27+ 865D FE FF                cp $ff                                      ; end of string
  28+ 865F C8                   ret z                                       ; return if so
  29+ 8660
  30+ 8660 FE 16                cp 22                                       ; AT control
  31+ 8662 28 07                jr z, .at                                   ; branch if so
  32+ 8664
  33+ 8664 CD 79 86             call displayChar                            ; display char and advance column
  34+ 8667 FD 23                inc iy                                      ; point to next in string
  35+ 8669 18 EF                jr .loop                                    ; and loop
  36+ 866B              .at
  37+ 866B FD 23                inc iy                                      ; point to YX parameters
  38+ 866D FD 46 00             ld b, (iy +0)                               ; store Y
  39+ 8670 FD 23                inc iy                                      ; point to next in string
  40+ 8672 FD 4E 00             ld c, (iy +0)                               ; store X
  41+ 8675 FD 23                inc iy                                      ; point to next in string
  42+ 8677 18 E1                jr .loop                                    ; loop
  43+ 8679
  44+ 8679              displayChar:
  45+ 8679              ; B = char row (0..23), C = char col (0..31), A = char (32..127)
  46+ 8679              ; corrupts AF, DE, HL
  47+ 8679 C5                   push bc                                     ; save the running Y/X screen positions
  48+ 867A D5                   push de                                     ; save DE in case of call from Bin8ToDec
  49+ 867B
  50+ 867B CB 20                sla b                                       ; multiply Y by 8 to get pixel Y
  51+ 867D CB 20                sla b
  52+ 867F CB 20                sla b
  53+ 8681 50                   ld d, b                                     ; put Y in D for pixelad
  54+ 8682 CB 21                sla c                                       ; multiply X by 8 to get pixel X
  55+ 8684 CB 21                sla c
  56+ 8686 CB 21                sla c
  57+ 8688 59                   ld e, c                                     ; put X in D for pixelad
  58+ 8689 ED 94                pixelad                                     ; HL -> address of the cell's top pixel line
  59+ 868B
  60+ 868B FE 80                cp 128
  61+ 868D 30 0D                jr nc, .udg
  62+ 868F
  63+ 868F D6 20                sub 32                                      ; calc index into charset
  64+ 8691 1E 08                ld e, 8                                     ; each char is 8 bytes
  65+ 8693 57                   ld d, a                                     ; get index
  66+ 8694 ED 30                mul d, e                                    ; DE = index * 8
