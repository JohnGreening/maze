 231+ 8244              ; ============================================================
 232+ 8244              ; Clear the flood field area completely
 233+ 8244              ; set all 49152 field bytes to 255
 234+ 8244              ; (255 = unvisited/wall).
 235+ 8244              ; ============================================================
 236+ 8244 ~            /*
 237+ 8244 ~            clearFloodField:
 238+ 8244 ~                    ld a, DFIELD_PAGE           ; first field page
 239+ 8244 ~                    ld b, 6                     ; six pages to clear
 240+ 8244 ~            .clrPage:
 241+ 8244 ~                    push bc
 242+ 8244 ~                    nextreg $56, a              ; page this 8K bank into slot 6 ($C000)
 243+ 8244 ~                    push af
 244+ 8244 ~                    ; smear 255 across $C000..$DFFF (8192 bytes)
 245+ 8244 ~                    ld hl, $C000
 246+ 8244 ~                    ld (hl), 255
 247+ 8244 ~                    ld de, $C001
 248+ 8244 ~                    ld bc, 8192 - 1
 249+ 8244 ~                    ldir
 250+ 8244 ~                    pop af
 251+ 8244 ~                    inc a                       ; next page
 252+ 8244 ~                    pop bc
 253+ 8244 ~                    djnz .clrPage
 254+ 8244 ~                    ret
 255+ 8244 ~            */
