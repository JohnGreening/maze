 154+ 7F15             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 154+ 7F15             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 154+ 7F15 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 154+ 7F16             >
