 619  980E              showSprite:
 620  980E              ; ============================================================
 621  980E              ; Returns the floodfill distance for the player's tile in A.
 622  980E              ; 255 = wall / unreached. Lower = closer to flood target.
 623  980E              ; Trashes: AF, HL, BC
 624  980E              ; ============================================================
 625  980E 2A 6A 8F             ld hl, (player_py)
 626  9811                      DIV_HL_8A                                    ; A = tileY (player_py / 8)
 626  9811             >; version 2, 40 t-states (8 t-states quicker than DIV_HL_8)
 626  9811             >; simple 16-bit divide without the CALL/RET overhead
 626  9811 7D          >        ld a, l                                     ; get low byte into a ready for rotate from carry   4t
 626  9812 CB 3C       >        srl h                                       ;                                                   8t
 626  9814 1F          >        rra                                         ;                                                   4t
 626  9815 CB 3C       >        srl h                                       ;                                                   8t
 626  9817 1F          >        rra                                         ;                                                   4t
 626  9818 CB 3C       >        srl h                                       ;                                                   8t
 626  981A 1F          >        rra                                         ;                                                   4t
 627  981B 32 6D 8F             ld (player_tile_y), a
 628  981E
 629  981E 2A 68 8F             ld hl, (player_px)
 630  9821                      DIV_HL_8A                                    ; A = tileX (player_px / 8)
 630  9821             >; version 2, 40 t-states (8 t-states quicker than DIV_HL_8)
 630  9821             >; simple 16-bit divide without the CALL/RET overhead
 630  9821 7D          >        ld a, l                                     ; get low byte into a ready for rotate from carry   4t
 630  9822 CB 3C       >        srl h                                       ;                                                   8t
 630  9824 1F          >        rra                                         ;                                                   4t
 630  9825 CB 3C       >        srl h                                       ;                                                   8t
 630  9827 1F          >        rra                                         ;                                                   4t
 630  9828 CB 3C       >        srl h                                       ;                                                   8t
