 486  972B              moveSprite1:
 487  972B              ; ================================================
 488  972B                  ; FINE SCROLLING (pixel-level smooth scroll)
 489  972B                  ; Set hardware tilemap scroll registers using player_px/py
 490  972B                  ; ================================================
 491  972B CD FF 97             call wait_vblank
 492  972E
 493  972E 3A 64 8F             ld a, (cam_px)                              ; get LOW byte of camera X position
 494  9731 E6 07                and 7                                       ; keep only the bottom 3 bits (0-7 pixels)
 495  9733 ED 92 30             nextreg $30, a                              ; ← X fine offset (MUST be every frame)
 496  9736
 497  9736 3A 66 8F             ld a, (cam_py)                              ; get LOW byte of camera Y position
 498  9739 E6 07                and 7                                       ; keep only the bottom 3 bits (0-7 pixels)
 499  973B ED 92 31             nextreg $31, a                              ; ← Y fine offset (MUST be every frame)
 500  973E
 501  973E              ; ================================================
 502  973E                  ; COPY DECISION - copy ONLY when X or Y is aligned to tile boundary
 503  973E                  ; ================================================
 504  973E 2A 64 8F             ld hl, (cam_px)
 505  9741                      DIV_HL_8A
 505  9741             >; version 2, 40 t-states (8 t-states quicker than DIV_HL_8)
 505  9741             >; simple 16-bit divide without the CALL/RET overhead
 505  9741 7D          >        ld a, l                                     ; get low byte into a ready for rotate from carry   4t
 505  9742 CB 3C       >        srl h                                       ;                                                   8t
 505  9744 1F          >        rra                                         ;                                                   4t
 505  9745 CB 3C       >        srl h                                       ;                                                   8t
 505  9747 1F          >        rra                                         ;                                                   4t
 505  9748 CB 3C       >        srl h                                       ;                                                   8t
 505  974A 1F          >        rra                                         ;                                                   4t
 506  974B 47                   ld b, a
 507  974C 2A 66 8F             ld hl, (cam_py)
 508  974F                      DIV_HL_8A
 508  974F             >; version 2, 40 t-states (8 t-states quicker than DIV_HL_8)
 508  974F             >; simple 16-bit divide without the CALL/RET overhead
 508  974F 7D          >        ld a, l                                     ; get low byte into a ready for rotate from carry   4t
 508  9750 CB 3C       >        srl h                                       ;                                                   8t
 508  9752 1F          >        rra                                         ;                                                   4t
 508  9753 CB 3C       >        srl h                                       ;                                                   8t
 508  9755 1F          >        rra                                         ;                                                   4t
 508  9756 CB 3C       >        srl h                                       ;                                                   8t
 508  9758 1F          >        rra                                         ;                                                   4t
 509  9759 4F                   ld c, a
 510  975A
 511  975A 3A 68 8F             ld a, (cam_tx)                              ; get last player tile X
 512  975D B8                   cp b                                        ; compare with current
 513  975E 20 07                jr nz, copy_visible_window                  ; branch if different
 514  9760
 515  9760 3A 69 8F             ld a, (cam_ty)                              ; get last player tile Y
 516  9763 B9                   cp c                                        ; compare with current
 517  9764 20 01                jr nz, copy_visible_window                  ; branch if different
 518  9766
 519  9766 C9                   ret                                         ; otherwise return, hardware scroll is enough
 520  9767
 521  9767              copy_visible_window:
 522  9767 78                   ld a, b                                     ; get current player tile X
 523  9768 32 68 8F             ld (cam_tx), a                              ; save it away
 524  976B 79                   ld a, c                                     ; get current player tile Y
 525  976C 32 69 8F             ld (cam_ty), a                              ; save it away
 526  976F
 527  976F                  ; STEP 1: Build the starting linear offset in the world map
 528  976F 61                   ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 529  9770                                                                  ; put it in H (this is the same as multiplying cam_tile_y by 256)
 530  9770 68                   ld l, b                                     ; read the X tile coordinate into L
 531  9771                                                                  ; Result: HL now holds  cam_tile_y * 256 + cam_tile_x
 532  9771                                                                  ; This is the byte offset into "world" map.
 533  9771
 534  9771                  ; STEP 2: Calculate which 8K physical page the data lives in
 535  9771 7C                   ld   a, h                                   ; take the high byte of the offset (which is cam_tile_y)
 536  9772              ;        srl  a                                      ; divide by 2
 537  9772              ;        srl  a                                      ; divide by 2 again  → now /4
 538  9772              ;        srl  a                                      ; /8
 539  9772              ;        srl  a                                      ; /16
 540  9772              ;        srl  a                                      ; /32   ← this is the same as cam_tile_y ÷ 32
 541  9772              ; ------------------------------------------------------------------------
 542  9772              ; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
 543  9772              ; saves 21 t-state
 544  9772              ; ------------------------------------------------------------------------
 545  9772 07                   rlca
 546  9773 07                   rlca
 547  9774 07                   rlca
 548  9775 E6 07                and 7
 549  9777                                                                  ; Why divide by 32?
 550  9777                                                                  ;   Each page is 8192 bytes.
 551  9777                                                                  ;   Each row is 256 bytes.
 552  9777                                                                  ;   8192 ÷ 256 = exactly 32 rows per page.
 553  9777                                                                  ;   Therefore page number = 40 + (cam_tile_y ÷ 32)
 554  9777 C6 28                add  a,40                                   ; add the starting page number (your world map begins at page 40)
 555  9779 32 6A 8F             ld   (tilemapPage), a                       ; save the page number in register C for later
 556  977C
 557  977C                  ; STEP 3: Keep only the part of the address that fits inside one 8K page
 558  977C 7C                   ld   a,h                                    ; get the high byte again
 559  977D E6 1F                and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 560  977F                                                                  ; This is exactly the same as (cam_tile_y * 256 + cam_tile_x) modulo 8192
 561  977F                                                                  ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 562  977F 67                   ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 563  9780
 564  9780                  ; STEP 4: Page the correct 8K bank into slot 6 so we can read it
 565  9780 3A 6A 8F             ld   a, (tilemapPage)                       ; A = page number we want
 566  9783 ED 92 56             nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 567  9786 01 00 C0             ld   bc,$C000                               ; $C000 is the start of slot 6
 568  9789 09                   add  hl,bc                                  ; HL = $C000 + offset_inside_page
 569  978A                                                                  ; HL now points directly at the first byte we want to copy
 570  978A
 571  978A                  ; STEP 5: Point DE at the hardware tilemap buffer (fixed location)
 572  978A 11 00 60             ld   de, tileMap                            ; destination is the hardware tilemap location
 573  978D
 574  978D                  ; STEP 6: Copy all 32 visible rows
 575  978D 01 00 05             ld   bc,40*32                               ; we need to copy 32 rows x 40 columns
 576  9790              .row_loop:
 577  9790              REPT 40
 578  9790 ED A0       >        LDI
 578  9792 ED A0       >        LDI
 578  9794 ED A0       >        LDI
 578  9796 ED A0       >        LDI
 578  9798 ED A0       >        LDI
 578  979A ED A0       >        LDI
