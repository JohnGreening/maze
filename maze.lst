  17+ 8EAC ED 31                ADD HL, A
  18+ 8EAE
  19+ 8EAE 3A 35 8F             LD A, (nextCH)                      ; whats the nextCH to use
  20+ 8EB1 FE 00                CP 0                                ; is it 0?
  21+ 8EB3 28 0B                JR Z, playCh1                       ; jump if so
  22+ 8EB5 FE 01                CP 1                                ; is it 1?
  23+ 8EB7 28 0C                JR Z, playCh2                       ; jump if so
  24+ 8EB9 3E FF                LD A, 255                           ; its 2, set next so its 0
  25+ 8EBB 11 4A 8F             LD DE, Ch3                          ; set AY channel to 3
  26+ 8EBE 18 08                JR play                             ; and branch to do the sound setup
  27+ 8EC0              playCh1:
  28+ 8EC0 11 36 8F             LD DE, Ch1                          ; set the AY channel to 1
  29+ 8EC3 18 03                JR play                             ; and branch to do the sound setup
  30+ 8EC5              playCh2:
  31+ 8EC5 11 40 8F             LD DE, Ch2                          ; set the AY channel to 2
  32+ 8EC8              play:
  33+ 8EC8 3C                   INC A                               ; roll on nextCH
  34+ 8EC9 32 35 8F             LD (nextCH), A                      ; and save it
  35+ 8ECC 01 0A 00             LD BC, 10                           ; we copy 10 bytes of sound setup
  36+ 8ECF ED B0                LDIR                                ; do the copy
  37+ 8ED1
  38+ 8ED1 C1                   POP BC
  39+ 8ED2 D1                   POP DE
  40+ 8ED3 E1                   POP HL
  41+ 8ED4 C9                   RET
