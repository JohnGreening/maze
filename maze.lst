1132  9C55              displayBaddie:
1133  9C55                  ; ============================================================
1134  9C55                  ; Draw baddie sprite (sprite #1) relative to the centred player.
1135  9C55                  ; Player is locked to screen centre, so:
1136  9C55                  ;     screenPos = baddieWorldPos - playerWorldPos + screenCentre
1137  9C55                  ; A 16x16 sprite is shown whenever ANY part overlaps the display,
1138  9C55                  ; so we allow up to 15px of overhang at each edge before hiding.
1139  9C55                  ; IX already points at the baddie record (set by processBaddies).
1140  9C55                  ; ============================================================
1141  9C55
1142  9C55 3A 05 94             ld a, (viewMode)
1143  9C58 B7                   or a
1144  9C59 C2 CB 9C             jp nz, radarBaddie
1145  9C5C
1146  9C5C                  ; ---------- SCREEN X ----------
1147  9C5C                      ; HL = baddie world X
1148  9C5C DD 6E 01             ld l, (ix + baddieRecord.lowX)
1149  9C5F DD 66 02             ld h, (ix + baddieRecord.highX)
1150  9C62 ED 4B 56 8F          ld bc, (cam_px)                             ; BC = player world X
1151  9C66 B7                   or a                                        ; clear carry for a clean subtract
1152  9C67 ED 42                sbc hl, bc                                  ; HL = baddieX - playerX  (signed)
1153  9C69                  ; add screen centre AND the 15px overhang bias in one go.
1154  9C69                  ; CENTER_SCREEN_X + 15 = 152 + 15 = 167, which fits in 8 bits,
1155  9C69                  ; so we can use the Z80N "add hl,a" (cheaper to set up than add hl,bc).
1156  9C69 3E 0F                ld a,  15                                   ; A = 167  (centre + bias)
1157  9C6B ED 31                add hl, a                                   ; Z80N: HL = biased screen X
1158  9C6D                  ; HL now holds (screenX + 15). Visible-with-overhang means the
1159  9C6D                  ; UN-biased X is in -15..319, i.e. the BIASED value is in 0..334.
1160  9C6D                  ; Reject anything outside 0..334 with an unsigned range test.
1161  9C6D 7C                   ld a, h                                     ; look at high byte of biased X
1162  9C6E FE 01                cp 1                                        ; H = 0 ?  (biased X = 0..255)
1163  9C70 38 07                jr c, .xInRange                             ; H = 0 -> definitely <= 334, in range
1164  9C72 20 4C                jr nz, .hideBaddie                          ; H >= 2 -> biased X >= 512 -> off right
1165  9C74                  ; H = 1 here, so biased X = 256..511; allowed only up to 334 ($014E),
1166  9C74                  ; meaning the low byte must be < 79 (334 - 256 = 78).
1167  9C74 7D                   ld a, l
1168  9C75 FE 4F                cp 79
1169  9C77 30 47                jr nc, .hideBaddie                          ; low byte >= 79 -> off right edge
1170  9C79              .xInRange:
1171  9C79 E5                   push hl                                     ; save biased X (we still need it later)
1172  9C7A
1173  9C7A                  ; ---------- SCREEN Y ----------
1174  9C7A                  ; HL = baddie world Y
1175  9C7A DD 6E 03             ld l, (ix + baddieRecord.lowY)
1176  9C7D DD 66 04             ld h, (ix + baddieRecord.highY)
1177  9C80 ED 4B 58 8F          ld bc, (cam_py)             ; BC = player world Y
1178  9C84 B7                   or a                           ; clear carry
1179  9C85 ED 42                sbc hl, bc                     ; HL = baddieY - playerY  (signed)
1180  9C87                  ; centre + bias again: CENTER_SCREEN_Y + 15 = 120 + 15 = 135, fits in 8 bits.
1181  9C87 3E 0F                ld a, 15     ; A = 135
1182  9C89 ED 31                add hl, a                      ; Z80N: HL = biased screen Y
1183  9C8B                  ; Visible-with-overhang: un-biased Y in -15..255, i.e. biased Y in 0..270.
1184  9C8B 7C                   ld a, h                        ; high byte of biased Y
1185  9C8C FE 01                cp 1                           ; H = 0 ?
1186  9C8E 38 07                jr c, .yInRange                ; H = 0 -> <= 270, in range
1187  9C90 20 2D                jr nz, .hidePop                ; H >= 2 -> off bottom
1188  9C92                  ; H = 1: biased Y = 256..511, allowed only up to 270 ($010E),
1189  9C92                  ; so low byte must be < 15 (270 - 256 = 14).
1190  9C92 7D                   ld a, l
1191  9C93 FE 0F                cp 15
1192  9C95 30 28                jr nc, .hidePop                ; low byte >= 15 -> off bottom edge
1193  9C97              .yInRange:
1194  9C97                  ; ---------- BADDIE IS ON SCREEN ----------
1195  9C97                  ; Un-bias Y by 15 to get the real Y the hardware wants.
1196  9C97                  ; The sprite Y register is 8-bit and takes the value mod 256,
1197  9C97                  ; which is exactly what we need: a baddie 15px above the top
1198  9C97                  ; (real Y = -15) writes 241, and the hardware draws it overhanging.
1199  9C97 7D                   ld a, l                        ; low byte of biased Y
1200  9C98 D6 0F                sub 15                         ; A = real screen Y (mod 256)
1201  9C9A 5F                   ld e, a                        ; stash Y in E for the moment
1202  9C9B
1203  9C9B E1                   pop hl                         ; recover biased X
1204  9C9C 01 0F 00             ld bc, 15
1205  9C9F B7                   or a                           ; clear carry
1206  9CA0 ED 42                sbc hl, bc                     ; HL = real screen X (full 9-bit value)
