 986  99AC              moveAvailable:
 987  99AC                      ; E = available-direction mask. Choose pick method by mode.
 988  99AC                      ; Read own-cell distance first (one field read) -> sets lastDist.
 989  99AC DD 46 05             ld b, (ix + baddieRecord.tileX)             ; B = tileX
 990  99AF DD 4E 06             ld c, (ix + baddieRecord.tileY)             ; C = tileY
 991  99B2              ;        ld l, b
 992  99B2              ;        ld h, c
 993  99B2              ;        call getFieldByte                           ; A = own-cell distance
 994  99B2                      GET_WORLD_VALUE DFIELD_PAGE, USE_BC
 994  99B2             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 994  99B2             >;
 994  99B2             >;       arg  is TILEMAP_PAGE
 994  99B2             >;            or DFIELD_PAGE
 994  99B2             >;
 994  99B2             >;       arg1 decides if input comes from BC or directly from HL
 994  99B2             >;            NB if directly from HL then L = tile X, H = tile Y
 994  99B2             >;
 994  99B2             >        if USE_BC = 0
 994  99B2 61          >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 994  99B3             >                                                    ; put it in H (this is the same as multiplying by 256)
 994  99B3 68          >        ld l, b                                     ; read the X tile coordinate into L
 994  99B4             >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 994  99B4             >                                                    ; This is the byte offset into "world" map.
 994  99B4             >        endif
 994  99B4             >
 994  99B4             >    ; STEP 2: Calculate which 8K physical page the data lives in
 994  99B4 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 994  99B5 CB 3F       >        srl  a                                      ; divide by 2
 994  99B7 CB 3F       >        srl  a                                      ; divide by 2 again  → now /4
 994  99B9 CB 3F       >        srl  a                                      ; /8
 994  99BB CB 3F       >        srl  a                                      ; /16
 994  99BD CB 3F       >        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 994  99BF             >                                                    ; Why divide by 32?
 994  99BF             >                                                    ;   Each page is 8192 bytes.
 994  99BF             >                                                    ;   Each row is 256 bytes.
 994  99BF             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 994  99BF             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 994  99BF             >
 994  99BF C6 2E       >        add  a, DFIELD_PAGE                                 ; add the starting page number
 994  99C1             >
 994  99C1 ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 994  99C4             >
 994  99C4             >
 994  99C4             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 994  99C4 7C          >        ld   a,h                                    ; get the high byte again
 994  99C5 E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 994  99C7             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 994  99C7             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 994  99C7 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 994  99C8             >
 994  99C8             >    ; STEP 4: add the page offset so we can read it
 994  99C8 ED 34 00 C0 >        add  hl, $C000                              ; HL = $C000 + offset_inside_page
 994  99CC             >                                                    ; HL now points directly at the first byte we want to copy
 994  99CC 7E          >        ld a, (hl)                                  ; so get the byte
 995  99CD
 996  99CD DD 77 0A             ld (ix + baddieRecord.lastDist), a
 997  99D0 4F                   ld c, a                                     ; keep own distance in C for the mode test
 998  99D1                                                                  ; (B no longer needed; pickByField re-reads tileX/Y)
 999  99D1
1000  99D1 DD 7E 09             ld a, (ix + baddieRecord.mode)
1001  99D4 FE 02                cp mode_wander
1002  99D6 28 0F                jr z, .pickWander                           ; forced wander
1003  99D8
1004  99D8 FE 01                cp mode_hunt
1005  99DA 28 05                jr z, .pickHunt                             ; forced hunt
1006  99DC
1007  99DC                      ; mode_auto: hunt only if own distance <= 253 (scent present)
1008  99DC 79                   ld a, c
1009  99DD FE FE                cp 254
1010  99DF 30 06                jr nc, .pickWander                          ; >=254 -> no scent -> wander
1011  99E1
1012  99E1              .pickHunt:
1013  99E1 CD F8 99             call pickByField                            ; A = chosen vdir, or 0 if none
1014  99E4 A7                   and a
