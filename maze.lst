 139+ F1F0              ch1Update:
 140+ F1F0 21 E1 8F             ld hl, Ch1Length                            ; get the Ch1 sound length
 141+ F1F3 35                   dec (hl)                                    ; -1 (will roll to 255)
 142+ F1F4 20 03                jr nz, ch2Update                            ; branch if it's not zero
 143+ F1F6 2B                   dec hl                                      ; point to Ch1 flags
 144+ F1F7 36 00                ld (hl), 0                                  ; set to 0 (bit 0= tone enable, bit 1= noise enable)
 145+ F1F9              ch2Update:
 146+ F1F9 21 EB 8F             ld hl, Ch2Length
 147+ F1FC 35                   dec (hl)
