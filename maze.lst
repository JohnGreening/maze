 452  9569              	    GET_WORLD_VALUE TILEMAP_PAGE, USE_BC
 452  9569             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 452  9569             >;
 452  9569             >;       arg  is TILEMAP_PAGE
 452  9569             >;            or DFIELD_PAGE
 452  9569             >;
 452  9569             >;       arg1 decides if input comes from BC or directly from HL
 452  9569             >;            NB if directly from HL then L = tile X, H = tile Y
 452  9569             >;
 452  9569             >        if USE_BC = 0
 452  9569 61          >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 452  956A             >                                                    ; put it in H (this is the same as multiplying by 256)
 452  956A 68          >        ld l, b                                     ; read the X tile coordinate into L
 452  956B             >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 452  956B             >                                                    ; This is the byte offset into "world" map.
 452  956B             >        endif
 452  956B             >
 452  956B             >    ; STEP 2: Calculate which 8K physical page the data lives in
 452  956B 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 452  956C CB 3F       >        srl  a                                      ; divide by 2
 452  956E CB 3F       >        srl  a                                      ; divide by 2 again  → now /4
 452  9570 CB 3F       >        srl  a                                      ; /8
 452  9572 CB 3F       >        srl  a                                      ; /16
 452  9574 CB 3F       >        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 452  9576             >                                                    ; Why divide by 32?
 452  9576             >                                                    ;   Each page is 8192 bytes.
 452  9576             >                                                    ;   Each row is 256 bytes.
 452  9576             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 452  9576             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 452  9576             >
 452  9576 C6 28       >        add  a, TILEMAP_PAGE                                 ; add the starting page number
 452  9578             >
 452  9578 ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 452  957B             >
 452  957B             >
 452  957B             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 452  957B 7C          >        ld   a,h                                    ; get the high byte again
 452  957C E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 452  957E             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 452  957E             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 452  957E 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 452  957F             >
 452  957F             >    ; STEP 4: add the page offset so we can read it
 452  957F ED 34 00 C0 >        add  hl, $C000                              ; HL = $C000 + offset_inside_page
 452  9583             >                                                    ; HL now points directly at the first byte we want to copy
 452  9583 7E          >        ld a, (hl)                                  ; so get the byte
 453  9584 FE 01        	    cp MAP_WALL
 454  9586 C8           	    ret z
 455  9587 0C           	    inc c
