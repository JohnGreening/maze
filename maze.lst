 524  96C1             >    ; STEP 2: Calculate which 8K physical page the data lives in
 524  96C1 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 524  96C2 CB 3F       >        srl  a                                      ; divide by 2
 524  96C4 CB 3F       >        srl  a                                      ; divide by 2 again  → now /4
 524  96C6 CB 3F       >        srl  a                                      ; /8
 524  96C8 CB 3F       >        srl  a                                      ; /16
 524  96CA CB 3F       >        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 524  96CC             >                                                    ; Why divide by 32?
 524  96CC             >                                                    ;   Each page is 8192 bytes.
 524  96CC             >                                                    ;   Each row is 256 bytes.
 524  96CC             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 524  96CC             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
