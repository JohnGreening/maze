 518  969D CB 1D       >        rr l
 519  969F 45                   ld b, l
 520  96A0                      GET_WORLD_VALUE TILEMAP_PAGE, USE_BC
 520  96A0             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 520  96A0             >;
 520  96A0             >;       arg  is TILEMAP_PAGE
 520  96A0             >;            or DFIELD_PAGE
 520  96A0             >;
 520  96A0             >;       arg1 decides if input comes from BC or directly from HL
 520  96A0             >;            NB if directly from HL then L = tile X, H = tile Y
 520  96A0             >;
 520  96A0             >        if USE_BC = 0
 520  96A0 61          >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 520  96A1             >                                                    ; put it in H (this is the same as multiplying by 256)
 520  96A1 68          >        ld l, b                                     ; read the X tile coordinate into L
 520  96A2             >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 520  96A2             >                                                    ; This is the byte offset into "world" map.
 520  96A2             >        endif
 520  96A2             >
 520  96A2             >    ; STEP 2: Calculate which 8K physical page the data lives in
 520  96A2 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 520  96A3 CB 3F       >        srl  a                                      ; divide by 2
 520  96A5 CB 3F       >        srl  a                                      ; divide by 2 again  → now /4
 520  96A7 CB 3F       >        srl  a                                      ; /8
 520  96A9 CB 3F       >        srl  a                                      ; /16
 520  96AB CB 3F       >        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 520  96AD             >                                                    ; Why divide by 32?
 520  96AD             >                                                    ;   Each page is 8192 bytes.
 520  96AD             >                                                    ;   Each row is 256 bytes.
 520  96AD             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 520  96AD             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 520  96AD             >
 520  96AD C6 28       >        add  a, TILEMAP_PAGE                                 ; add the starting page number
 520  96AF             >
 520  96AF ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 520  96B2             >
 520  96B2             >
 520  96B2             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 520  96B2 7C          >        ld   a,h                                    ; get the high byte again
 520  96B3 E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 520  96B5             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 520  96B5             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 520  96B5 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 520  96B6             >
 520  96B6             >    ; STEP 4: add the page offset so we can read it
 520  96B6 ED 34 00 C0 >        add  hl, $C000                              ; HL = $C000 + offset_inside_page
 520  96BA             >                                                    ; HL now points directly at the first byte we want to copy
 520  96BA 7E          >        ld a, (hl)                                  ; so get the byte
 521  96BB FE 01                cp MAP_WALL
 522  96BD C8                   ret z
 523  96BE 04                   inc b
