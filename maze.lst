 273  9467              ; we don't allow movement if partially on a tile for that direction
 274  9467              ; so set up another mask here, E, holding whether vertical and/or horizontal movement is actually allowed
 275  9467              chkVert:
 276  9467 1E 00            	ld e, 0                                     ; set mask to 0
 277  9469 3A D0 8E         	ld a, (player_px)                           ; get player px (low byte   )
 278  946C E6 07            	and 7                                       ; check bits 2-0, if 0 then vertical movement may be allowed
 279  946E 20 02            	jr nz, chkHoriz
 280  9470 1E 0C            	ld e, %00001100                             ; set bits to allow vertical movement
 281  9472
