 646  983E
 647  983E
 648  983E AF                   xor a                                       ; sprite index = 0
 649  983F ED 92 34             NEXTREG $34, A
 650  9842 2A 68 8F             ld hl, (player_px)
 651  9845 ED 4B 56 8F          ld bc, (cam_px)
 652  9849 ED 42                sbc hl, bc
 653  984B 5C                   ld e, h
 654  984C
 655  984C 7D                   LD A, l                                     ; set the low byte of player X
 656  984D ED 92 35             NEXTREG $35, A
 657  9850
 658  9850 2A 6A 8F             ld hl, (player_py)
 659  9853 ED 4B 58 8F          ld bc, (cam_py)
 660  9857 ED 42                sbc hl, bc
 661  9859
 662  9859 7D                   LD A, l                                     ; set the low byte of player Y
 663  985A ED 92 36             NEXTREG $36, A
 664  985D 7B                   LD A, e                                     ; get the high byte of player X
 665  985E E6 01                AND 1                                       ; we only need bit 0
 666  9860 ED 92 37             NEXTREG $37, A                              ; set it
 667  9863
 668  9863                      ; --- choose pattern from facing direction + animation frame ---
 669  9863 3A 71 8F             ld a, (lastMove)                            ; vdir flag: 1=L 2=R 4=D 8=U
 670  9866 06 04                ld b, PAT_DOWN                              ; default down
 671  9868 FE 01                cp vdir_left
 672  986A 20 04                jr nz, .notL
 673  986C 06 0C                ld b, PAT_LEFT
 674  986E 18 0E                jr .haveBase
 675  9870              .notL:
 676  9870 FE 02                cp vdir_right
 677  9872 20 04                jr nz, .notR
 678  9874 06 08                ld b, PAT_RIGHT
 679  9876 18 06                jr .haveBase
 680  9878              .notR:
 681  9878 FE 08                cp vdir_up
 682  987A 20 02                jr nz, .haveBase                            ; else stays PAT_DOWN
 683  987C 06 10                ld b, PAT_UP
 684  987E              .haveBase:
 685  987E 3A 72 8F             ld a, (playerAnimFrame)                     ; 0-3
 686  9881 80                   add a, b                                    ; base + frame = pattern
 687  9882
 688  9882 F6 80                OR %10000000                                ; bit 7 = visible
 689  9884 ED 92 38             NEXTREG $38, A
 690  9887 C9                   RET
 691  9888
 692  9888              ; ============================================================
 693  9888              ; checkKeyCollect
 694  9888              ; Tests whether the player's 2x2 footprint overlaps any
 695  9888              ; AVAILABLE key's 2x2 block.
 696  9888              ; Returns: A = key index (0..KEY_COUNT-1) and carry SET if a
 697  9888              ;          key was collected; carry CLEAR (A undefined) if none.
 698  9888              ; Uses player_tile_x / player_tile_y (must be current).
 699  9888              ; Trashes: AF, BC, DE, HL
 700  9888              ; ============================================================
 701  9888              checkKeyCollect:
 702  9888 21 3D 7E             ld hl, KEY_DATA
 703  988B 06 00                ld b, 0                                     ; B = key index
 704  988D              .loop:
 705  988D 7E                   ld a, (hl)                                  ; key tileX
 706  988E 23                   inc hl
 707  988F 4E                   ld c, (hl)                                  ; key tileY
 708  9890 23                   inc hl
 709  9891 5E                   ld e, (hl)                                  ; status
 710  9892 23                   inc hl                                      ; HL -> next key record
 711  9893
 712  9893                      ; skip keys that aren't available
 713  9893 57                   ld d, a                                     ; save key tileX in D (A about to be reused)
 714  9894 7B                   ld a, e
 715  9895 FE 01                cp KEY_AVAILABLE
 716  9897 20 1B                jr nz, .next                                ; not available -> skip
 717  9899
 718  9899                      ; --- X overlap: abs(player_tile_x - keyX) <= 1 ? ---
 719  9899 3A 6C 8F             ld a, (player_tile_x)
 720  989C 92                   sub d                                       ; A = px - kx
 721  989D 30 02                jr nc, .xpos
 722  989F ED 44                neg                                         ; A = |px - kx|
 723  98A1              .xpos:
 724  98A1 FE 02                cp 2
 725  98A3 30 0F                jr nc, .next                                ; |dx| >= 2 -> no overlap
 726  98A5
 727  98A5                      ; --- Y overlap: abs(player_tile_y - keyY) <= 1 ? ---
 728  98A5 3A 6D 8F             ld a, (player_tile_y)
 729  98A8 91                   sub c                                       ; A = py - ky
 730  98A9 30 02                jr nc, .ypos
 731  98AB ED 44                neg
 732  98AD              .ypos:
 733  98AD FE 02                cp 2
 734  98AF 30 03                jr nc, .next                                ; |dy| >= 2 -> no overlap
 735  98B1
 736  98B1                      ; overlap on both axes -> collected this key
 737  98B1 78                   ld a, b                                     ; A = key index
 738  98B2 37                   scf                                         ; carry set = collected
 739  98B3 C9                   ret
 740  98B4
 741  98B4              .next:
 742  98B4 04                   inc b
 743  98B5 78                   ld a, b
 744  98B6 FE 04                cp KEY_COUNT
 745  98B8 20 D3                jr nz, .loop
 746  98BA B7                   or a                            ; clear carry = nothing collected
 747  98BB C9                   ret
 748  98BC
 749  98BC
 750  98BC              ; point to end of skull data. We will use this to test if finished processing all the skulls
 751  98BC              ; saves having a register holding the processed count
 752  98BC              baddieEnd equ baddieData + (baddieRecord * baddieCount)
