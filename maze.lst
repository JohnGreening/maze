 273+ 82A2              clearFloodField:
 274+ 82A2 F3                   di                              ; see below
 275+ 82A3 3E 2E                ld a, DFIELD_PAGE               ; A = page   (OTIR leaves A alone)
 276+ 82A5 1E 06                ld e, 6                         ; E = count  (OTIR leaves DE alone)
 277+ 82A7              .pg:
