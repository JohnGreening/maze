  93+ 87D3              ; 8-Bit Binary to Decimal Digits Extraction
  94+ 87D3              ; Input:  A  = 8-bit binary number (0 - 255)
  95+ 87D3              ;         B  = char row (0..23), C = char col (0..31)
  96+ 87D3              ; Calls displayChar with A to display each digit
  97+ 87D3              Bin8ToDec:
  98+ 87D3              ; --- Step 1: Extract 100s Digit ---
  99+ 87D3 1E 2F                ld      e, '0' - 1                          ; Initialize ASCII counter
 100+ 87D5              .Loop100:
 101+ 87D5 1C                   inc     e                                   ; Increment ASCII character
 102+ 87D6 D6 64                sub     100                                 ; Subtract 100
 103+ 87D8 30 FB                jr      nc, .Loop100                        ; Repeat if no underflow (result >= 0)
 104+ 87DA C6 64                add     a, 100                              ; Restore the remainder (add 100 back)
 105+ 87DC
 106+ 87DC 57                   ld      d, a                                ; Temporarily save remainder in B
 107+ 87DD 7B                   ld      a, e                                ; Get 100s digit
 108+ 87DE CD 95 87             call displayChar
 109+ 87E1 7A                   ld      a, d                                ; Restore remainder to A
 110+ 87E2
 111+ 87E2              ; --- Step 2: Extract 10s Digit ---
 112+ 87E2 1E 2F                ld      e, '0' - 1                          ; Re-initialize ASCII counter
 113+ 87E4              .Loop10:
 114+ 87E4 1C                   inc     e                                   ; Increment ASCII character
 115+ 87E5 D6 0A                sub     10                                  ; Subtract 10
 116+ 87E7 30 FB                jr      nc, .Loop10                         ; Repeat if no underflow (result >= 0)
 117+ 87E9 C6 0A                add     a, 10                               ; Restore the remainder (add 10 back)
 118+ 87EB
 119+ 87EB 57                   ld      d, a                                ; Temporarily save 1s digit in B
 120+ 87EC 7B                   ld      a, e                                ; Get 10s digit
 121+ 87ED CD 95 87             call displayChar
 122+ 87F0
 123+ 87F0              ; --- Step 3: Extract 1s Digit ---
 124+ 87F0 7A                   ld      a, d                                ; Restore 1s digit to A
 125+ 87F1              DisplayDigit:
 126+ 87F1                      ; if calling from here then BC must be set with B=row, C=Column
 127+ 87F1 C6 30                add     a, '0'                              ; Convert the leftover 1s digit to ASCII
 128+ 87F3 CD 95 87             call displayChar
 129+ 87F6 C9                   ret
