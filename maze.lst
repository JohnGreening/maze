  23+ 7E62              ;===========================================================
  24+ 7E62              ; this routine called when a key is collected
  25+ 7E62              ; it removes the key from the maze map
  26+ 7E62              ; clears and repopulates the distance map
  27+ 7E62              ; updates the playerKeys and shows current status
  28+ 7E62              ;===========================================================
  29+ 7E62              collectKey:
  30+ 7E62 21 3D 7E             ld hl, KEY_DATA                             ; point to the key data
  31+ 7E65 47                   ld b, a                                     ; save key index, 0, 1, 2 or 3
  32+ 7E66 87                   add a, a                                    ; we want a*3, eg if 2 => 4
  33+ 7E67 80                   add a, b                                    ; add on the original index, e.g. 2 => 6
  34+ 7E68 ED 31                add hl, a                                   ; now we point to this keys data
  35+ 7E6A 56                   ld d, (hl)                                  ; get the tile x
  36+ 7E6B 23                   inc hl
  37+ 7E6C 5E                   ld e, (hl)                                  ; get the tile y
  38+ 7E6D 23                   inc hl
  39+ 7E6E 36 00                ld (hl), KEY_COLLECTED                      ; set the key as collected
  40+ 7E70
  41+ 7E70 6A                   ld l, d
  42+ 7E71 63                   ld h, e
  43+ 7E72                      GET_WORLD_VALUE TILEMAP_PAGE, USE_HL
  43+ 7E72             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
  43+ 7E72             >;
  43+ 7E72             >;       arg  is TILEMAP_PAGE
  43+ 7E72             >;            or DFIELD_PAGE
  43+ 7E72             >;
  43+ 7E72             >;       arg1 decides if input comes from BC or directly from HL
  43+ 7E72             >;            NB if directly from HL then L = tile X, H = tile Y
  43+ 7E72             >;
  43+ 7E72             >        if USE_HL = 0
  43+ 7E72 ~           >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
  43+ 7E72 ~           >                                                    ; put it in H (this is the same as multiplying by 256)
  43+ 7E72 ~           >        ld l, b                                     ; read the X tile coordinate into L
  43+ 7E72 ~           >                                                    ; Result: HL now holds tile_y * 256 + tile_x
  43+ 7E72 ~           >                                                    ; This is the byte offset into "world" map.
  43+ 7E72             >        endif
  43+ 7E72             >
  43+ 7E72             >    ; STEP 2: Calculate which 8K physical page the data lives in
  43+ 7E72 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
  43+ 7E73             >;        srl  a                                      ; divide by 2
  43+ 7E73             >;        srl  a                                      ; divide by 2 again  → now /4
  43+ 7E73             >;        srl  a                                      ; /8
  43+ 7E73             >;        srl  a                                      ; /16
  43+ 7E73             >;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
  43+ 7E73             >; ------------------------------------------------------------------------
  43+ 7E73             >; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
  43+ 7E73             >; saves 21 t-state
  43+ 7E73             >; ------------------------------------------------------------------------
  43+ 7E73 07          >        rlca
  43+ 7E74 07          >        rlca
  43+ 7E75 07          >        rlca
  43+ 7E76 E6 07       >        and 7
  43+ 7E78             >                                                    ; Why divide by 32?
  43+ 7E78             >                                                    ;   Each page is 8192 bytes.
  43+ 7E78             >                                                    ;   Each row is 256 bytes.
  43+ 7E78             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
  43+ 7E78             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
  43+ 7E78             >
  43+ 7E78 C6 28       >        add  a, TILEMAP_PAGE                                 ; add the starting page number
  43+ 7E7A 32 D1 8E    >        ld (curWorldPage), a                        ; save page for subsequent reads - likely no need to reload
  43+ 7E7D ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
  43+ 7E80             >
  43+ 7E80             >
  43+ 7E80             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
  43+ 7E80 7C          >        ld   a,h                                    ; get the high byte again
  43+ 7E81 E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
  43+ 7E83             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
  43+ 7E83             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
  43+ 7E83 F6 C0       >        or $C0                                      ; "add" page offset
  43+ 7E85 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
  43+ 7E86             >
  43+ 7E86             >    ; STEP 4: read the byte
  43+ 7E86             >                                                    ; HL now points directly at the first byte we want to copy
  43+ 7E86 7E          >        ld a, (hl)                                  ; so get the byte
  44+ 7E87 36 00                ld (hl), MAP_PATH                           ; reset key at tile x, y
  45+ 7E89 23                   inc hl
  46+ 7E8A 36 00                ld (hl), MAP_PATH                           ; reset key at tile x+1, y
  47+ 7E8C
  48+ 7E8C 6A                   ld l, d
  49+ 7E8D 63                   ld h, e
  50+ 7E8E 24                   inc h
  51+ 7E8F                      GET_WORLD_VALUE TILEMAP_PAGE, USE_HL
  51+ 7E8F             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
  51+ 7E8F             >;
  51+ 7E8F             >;       arg  is TILEMAP_PAGE
  51+ 7E8F             >;            or DFIELD_PAGE
  51+ 7E8F             >;
  51+ 7E8F             >;       arg1 decides if input comes from BC or directly from HL
  51+ 7E8F             >;            NB if directly from HL then L = tile X, H = tile Y
  51+ 7E8F             >;
  51+ 7E8F             >        if USE_HL = 0
  51+ 7E8F ~           >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
  51+ 7E8F ~           >                                                    ; put it in H (this is the same as multiplying by 256)
  51+ 7E8F ~           >        ld l, b                                     ; read the X tile coordinate into L
  51+ 7E8F ~           >                                                    ; Result: HL now holds tile_y * 256 + tile_x
  51+ 7E8F ~           >                                                    ; This is the byte offset into "world" map.
  51+ 7E8F             >        endif
  51+ 7E8F             >
  51+ 7E8F             >    ; STEP 2: Calculate which 8K physical page the data lives in
  51+ 7E8F 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
  51+ 7E90             >;        srl  a                                      ; divide by 2
