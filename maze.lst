  21+ 8663              displayText:
  22+ 8663              ; IY = text string, terminate with $FF, set AT with 22, Y, X
  23+ 8663              ; corrupts IY, AF, BC
  24+ 8663 01 00 00             ld bc, 0                                    ; set B (y) = 0 and C (x) = 0
  25+ 8666              .loop
  26+ 8666 FD 7E 00             ld a, (IY +0)                               ; get control or char to display
  27+ 8669 FE FF                cp $ff                                      ; end of string
  28+ 866B C8                   ret z                                       ; return if so
  29+ 866C
  30+ 866C FE 16                cp 22                                       ; AT control
  31+ 866E 28 07                jr z, .at                                   ; branch if so
  32+ 8670
  33+ 8670 CD 85 86             call displayChar                            ; display char and advance column
  34+ 8673 FD 23                inc iy                                      ; point to next in string
  35+ 8675 18 EF                jr .loop                                    ; and loop
  36+ 8677              .at
  37+ 8677 FD 23                inc iy                                      ; point to YX parameters
  38+ 8679 FD 46 00             ld b, (iy +0)                               ; store Y
  39+ 867C FD 23                inc iy                                      ; point to next in string
  40+ 867E FD 4E 00             ld c, (iy +0)                               ; store X
  41+ 8681 FD 23                inc iy                                      ; point to next in string
  42+ 8683 18 E1                jr .loop                                    ; loop
