 392  94ED B7                   or a
 393  94EE ED 42                sbc hl, bc                      ; hl = player_px - CENTRE_X
 394  94F0 F2 F6 94             jp p, .camXLowOK                ; >= 0 -> keep
 395  94F3 21 00 00             ld hl, 0                        ; negative -> clamp to 0
 396  94F6              .camXLowOK:
 397  94F6 01 C0 06             ld bc, CAM_MAX_X
 398  94F9 B7                   or a
 399  94FA ED 42                sbc hl, bc                      ; hl = value - CAM_MAX_X
 400  94FC 38 03                jr c, .camXHighOK               ; carry set => value < max -> keep (after add back)
 401  94FE 21 00 00             ld hl, 0                        ; value >= max -> result = max (after add back)
 402  9501              .camXHighOK:
 403  9501 09                   add hl, bc                      ; add CAM_MAX_X back
 404  9502 22 B3 8E             ld (cam_px), hl
