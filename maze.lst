1045  99FE DD 7E 0A             ld a, (ix + baddieRecord.lastDist)  ; own-cell distance
1046  9A01 32 AF 9A             ld (pf_best), a                             ; save best found
1047  9A04
1048  9A04 AF                   xor a                                       ; A = 0
