 860  98F6              ; IX -> baddie record. Returns carry SET if player overlaps this baddie.
 861  98F6              ; Trashes AF, DE, HL
 862  98F6              checkBaddieCollision:
 863  98F6                      ; --- X: |player_px - baddie_x| < COLLIDE_DX ? ---
 864  98F6 2A C4 8E             ld hl, (player_px)
 865  98F9 DD 5E 01             ld e, (ix + baddieRecord.lowX)
 866  98FC DD 56 02             ld d, (ix + baddieRecord.highX)
 867  98FF B7                   or a
 868  9900 ED 52                sbc hl, de                  ; HL = player_px - baddie_x
 869  9902 CB 7C                bit 7, h                    ; negative?
 870  9904 28 07                jr z, .xAbs
 871  9906 EB                   ex de, hl
 872  9907 21 00 00             ld hl, 0
 873  990A B7                   or a
 874  990B ED 52                sbc hl, de                  ; HL = |dx|
 875  990D              .xAbs:
 876  990D 11 0B 00             ld de, COLLIDE_DX
 877  9910 B7                   or a
 878  9911 ED 52                sbc hl, de
 879  9913 D0                   ret nc                      ; |dx| >= threshold -> no hit (carry clear)
 880  9914
 881  9914                      ; --- Y: |player_py - baddie_y| < COLLIDE_DY ? ---
 882  9914 2A C6 8E             ld hl, (player_py)
 883  9917 DD 5E 03             ld e, (ix + baddieRecord.lowY)
 884  991A DD 56 04             ld d, (ix + baddieRecord.highY)
 885  991D B7                   or a
 886  991E ED 52                sbc hl, de
 887  9920 CB 7C                bit 7, h
 888  9922 28 07                jr z, .yAbs
 889  9924 EB                   ex de, hl
 890  9925 21 00 00             ld hl, 0
 891  9928 B7                   or a
 892  9929 ED 52                sbc hl, de
 893  992B              .yAbs:
 894  992B 11 0B 00             ld de, COLLIDE_DY
 895  992E B7                   or a
 896  992F ED 52                sbc hl, de
 897  9931 C9                   ret                         ; carry set if |dy| < threshold -> HIT
