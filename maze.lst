 402  9492              ; ============================================================
 403  9492              ; updateCameraXY - recompute camera from player, clamped to map.
 404  9492              ;   cam = player - CENTRE, then clamped to [0 .. CAM_MAX]
 405  9492              ; Low clamp: if (player - CENTRE) < 0  -> 0   (sign test)
 406  9492              ; High clamp: if value > CAM_MAX       -> CAM_MAX
 407  9492              ; ============================================================
 408  9492              updateCameraXY:
 409  9492 CD 07 81             call addScore
 410  9495
 411  9495                      ; ---------- X ----------
 412  9495 2A DC 8E             ld hl, (player_px)
 413  9498 01 98 00             ld bc, CENTRE_X
 414  949B B7                   or a
 415  949C ED 42                sbc hl, bc                                  ; hl = player_px - CENTRE_X
 416  949E F2 A4 94             jp p, .camXLowOK                            ; >= 0 -> keep
 417  94A1 21 00 00             ld hl, 0                                    ; negative -> clamp to 0
 418  94A4              .camXLowOK:
 419  94A4 01 C0 06             ld bc, CAM_MAX_X
 420  94A7 B7                   or a
 421  94A8 ED 42                sbc hl, bc                                  ; hl = value - CAM_MAX_X
 422  94AA 38 03                jr c, .camXHighOK                           ; carry set => value < max -> keep (after add back)
 423  94AC 21 00 00             ld hl, 0                                    ; value >= max -> result = max (after add back)
 424  94AF              .camXHighOK:
 425  94AF 09                   add hl, bc                                  ; add CAM_MAX_X back
 426  94B0 22 CA 8E             ld (cam_px), hl
 427  94B3
 428  94B3                      ; ---------- Y ----------
