   1+ 8E07              playsound:
   2+ 8E07              ; Input : A = sound fx to play
   3+ 8E07              ;
   4+ 8E07              ; routine will choose next available channel and copy sound fx to that channel
   5+ 8E07              ; IM2 will then process that data
   6+ 8E07 E5                   PUSH HL
   7+ 8E08 D5                   PUSH DE
   8+ 8E09 C5                   PUSH BC
   9+ 8E0A
  10+ 8E0A 3D                   DEC A
  11+ 8E0B 87                   ADD A, A
  12+ 8E0C 87                   ADD A, A
  13+ 8E0D 87                   ADD A, A
  14+ 8E0E 87                   ADD A, A
  15+ 8E0F
  16+ 8E0F 21 3B 8E             LD HL, sound1
  17+ 8E12 ED 31                ADD HL, A
  18+ 8E14
  19+ 8E14 3A 9B 8E             LD A, (nextCH)                      ; whats the nextCH to use
  20+ 8E17 FE 00                CP 0                                ; is it 0?
  21+ 8E19 28 0B                JR Z, playCh1                       ; jump if so
  22+ 8E1B FE 01                CP 1                                ; is it 1?
  23+ 8E1D 28 0C                JR Z, playCh2                       ; jump if so
  24+ 8E1F 3E FF                LD A, 255                           ; its 2, set next so its 0
  25+ 8E21 11 B0 8E             LD DE, Ch3                          ; set AY channel to 3
  26+ 8E24 18 08                JR play                             ; and branch to do the sound setup
  27+ 8E26              playCh1:
  28+ 8E26 11 9C 8E             LD DE, Ch1                          ; set the AY channel to 1
  29+ 8E29 18 03                JR play                             ; and branch to do the sound setup
  30+ 8E2B              playCh2:
  31+ 8E2B 11 A6 8E             LD DE, Ch2                          ; set the AY channel to 2
  32+ 8E2E              play:
  33+ 8E2E 3C                   INC A                               ; roll on nextCH
  34+ 8E2F 32 9B 8E             LD (nextCH), A                      ; and save it
  35+ 8E32 01 0A 00             LD BC, 10                           ; we copy 10 bytes of sound setup
  36+ 8E35 ED B0                LDIR                                ; do the copy
  37+ 8E37
  38+ 8E37 C1                   POP BC
  39+ 8E38 D1                   POP DE
  40+ 8E39 E1                   POP HL
  41+ 8E3A C9                   RET
