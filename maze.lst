1407  9D83              random:
1408  9D83 E6 0F                and $0f                                     ; limit to 0-15, this is the available directions bitmask
1409  9D85 6F                   ld l, a                                     ; l = 0-15
1410  9D86 26 00                ld h, 0                                     ; h = 0
