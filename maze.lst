1086  9BE1             >
1086  9BE1             >        GET_WORLD_VALUE TILEMAP_PAGE, USE_BC        ; see what tile is here
1086  9BE1             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
1086  9BE1             >;
1086  9BE1             >;       arg  is TILEMAP_PAGE
1086  9BE1             >;            or DFIELD_PAGE
1086  9BE1             >;
1086  9BE1             >;       arg1 decides if input comes from BC or directly from HL
1086  9BE1             >;            NB if directly from HL then L = tile X, H = tile Y
1086  9BE1             >;
1086  9BE1             >        if USE_BC = 0
1086  9BE1 61          >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
1086  9BE2             >                                                    ; put it in H (this is the same as multiplying by 256)
1086  9BE2 68          >        ld l, b                                     ; read the X tile coordinate into L
1086  9BE3             >                                                    ; Result: HL now holds tile_y * 256 + tile_x
1086  9BE3             >                                                    ; This is the byte offset into "world" map.
1086  9BE3             >        endif
1086  9BE3             >
1086  9BE3             >    ; STEP 2: Calculate which 8K physical page the data lives in
1086  9BE3 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
1086  9BE4             >;        srl  a                                      ; divide by 2
1086  9BE4             >;        srl  a                                      ; divide by 2 again  → now /4
1086  9BE4             >;        srl  a                                      ; /8
1086  9BE4             >;        srl  a                                      ; /16
1086  9BE4             >;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
1086  9BE4             >; ------------------------------------------------------------------------
1086  9BE4             >; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
1086  9BE4             >; saves 21 t-state
1086  9BE4             >; ------------------------------------------------------------------------
1086  9BE4 07          >        rlca
1086  9BE5 07          >        rlca
1086  9BE6 07          >        rlca
1086  9BE7 E6 07       >        and 7
1086  9BE9             >                                                    ; Why divide by 32?
1086  9BE9             >                                                    ;   Each page is 8192 bytes.
1086  9BE9             >                                                    ;   Each row is 256 bytes.
1086  9BE9             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
1086  9BE9             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
1086  9BE9             >
1086  9BE9 C6 28       >        add  a, TILEMAP_PAGE                                 ; add the starting page number
1086  9BEB 32 5D 8F    >        ld (curWorldPage), a                        ; save page for subsequent reads - likely no need to reload
1086  9BEE ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
1086  9BF1             >
1086  9BF1             >
1086  9BF1             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
1086  9BF1 7C          >        ld   a,h                                    ; get the high byte again
1086  9BF2 E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
1086  9BF4             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
1086  9BF4             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
1086  9BF4 F6 C0       >        or $C0                                      ; "add" page offset
1086  9BF6 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
1086  9BF7             >
1086  9BF7             >    ; STEP 4: read the byte
1086  9BF7             >                                                    ; HL now points directly at the first byte we want to copy
1086  9BF7 7E          >        ld a, (hl)                                  ; so get the byte
1086  9BF8 FE 01       >        cp MAP_WALL                                 ; is it a wall?
1086  9BFA C8          >        ret z                                       ; return if so, do nothing
1086  9BFB             >
1086  9BFB             >; ----------------------------------------------------------------
1086  9BFB             >; worldAdjacent - read the map/field byte one tile to the right
1086  9BFB             >; GET_WORLD_VALUE just fetched. HL still points at that byte.
1086  9BFB             >; guaranteed to be on same page, so just inc HL
1086  9BFB             >; ----------------------------------------------------------------
1086  9BFB 23          >        inc hl                                      ; point to adjacent tile right
1086  9BFC 7E          >        ld a, (hl)                                  ; see what tile is here
1086  9BFD FE 01       >        cp MAP_WALL                                 ; is it a wall?
1086  9BFF C8          >        ret z                                       ; return if so, do nothing
