   5+ 8F6B              MACRO AY_TONE argChannel
   6+ 8F6B ~            ; write HL as a tone value to [previously] selected AY Chip (253/254/255)
   7+ 8F6B ~            ; argChannel is A, B or C
   8+ 8F6B ~
   9+ 8F6B ~                    ; prepare B so that the next "OUT (C), A" instruction
  10+ 8F6B ~                    ; will select the port/register that we want to write to
  11+ 8F6B ~                    LD B, AYPortSelect
  12+ 8F6B ~
  13+ 8F6B ~                    ; set A to the port register for the low byte tone value
  14+ 8F6B ~                    ; it's dependent on the AY chip Channel, i.e. A, B or C
  15+ 8F6B ~                    IF argChannel = 'A'
  16+ 8F6B ~                        ld a, 0
  17+ 8F6B ~                    ELSEIF argChannel = 'B'
  18+ 8F6B ~                        ld a, 2
  19+ 8F6B ~                    ELSEIF argChannel = 'C'
  20+ 8F6B ~                        ld a, 4
  21+ 8F6B ~                    ENDIF
  22+ 8F6B ~                    OUT (C), A
  23+ 8F6B ~
  24+ 8F6B ~                    ; AY chip ia now ready to accept the tone (low byte) value held in L
  25+ 8F6B ~                    ; so write it here
  26+ 8F6B ~                    LD B, AYPortWrite
  27+ 8F6B ~                    OUT (C), L
  28+ 8F6B ~
  29+ 8F6B ~                    ; prepare B so that the next "OUT (C), A" instruction
  30+ 8F6B ~                    ; will select the port/register that we want to write to
  31+ 8F6B ~                    LD B, AYPortSelect
  32+ 8F6B ~
  33+ 8F6B ~                    ; set A to the port register for the high byte tone value
  34+ 8F6B ~                    ; it's dependent on the AY chip Channel, i.e. A, B or C
  35+ 8F6B ~                    IF argChannel = 'A'
  36+ 8F6B ~                        ld a, 1
  37+ 8F6B ~                    ELSEIF argChannel = 'B'
  38+ 8F6B ~                        ld a, 3
  39+ 8F6B ~                    ELSEIF argChannel = 'C'
  40+ 8F6B ~                        ld a, 5
  41+ 8F6B ~                    ENDIF
  42+ 8F6B ~                    OUT (C), A
  43+ 8F6B ~
  44+ 8F6B ~                    ; AY chip ia now ready to accept the tone (high byte) value held in H
  45+ 8F6B ~                    ; so write it here
  46+ 8F6B ~                    LD B, AYPortWrite
  47+ 8F6B ~                    OUT (C), H
  48+ 8F6B                      ENDM
  49+ 8F6B
  50+ 8F6B
  51+ 8F6B              MACRO AY_VOLUME argChannel
  52+ 8F6B ~            ; write A as a volume value to [previously] selected AY Chip (253/254/255)
  53+ 8F6B ~            ; argChannel is A, B or C
  54+ 8F6B ~
  55+ 8F6B ~                    ; prepare B so that the next "OUT (C), A" instruction
  56+ 8F6B ~                    ; will select the port/register that we want to write to
  57+ 8F6B ~                    LD B, AYPortSelect
  58+ 8F6B ~
  59+ 8F6B ~                    ; set H to the port register for the volume value
  60+ 8F6B ~                    ; it's dependent on the AY chip Channel, i.e. A, B or C
  61+ 8F6B ~                    IF argChannel = 'A'
  62+ 8F6B ~                        ld h, 8
  63+ 8F6B ~                    ELSEIF argChannel = 'B'
  64+ 8F6B ~                        ld h, 9
  65+ 8F6B ~                    ELSEIF argChannel = 'C'
  66+ 8F6B ~                        ld h, 10
  67+ 8F6B ~                    ENDIF
  68+ 8F6B ~                    OUT (C), H
  69+ 8F6B ~
  70+ 8F6B ~                    ; AY chip ia now ready to accept the VOLUME value held in A
  71+ 8F6B ~                    ; so write it here
  72+ 8F6B ~                    LD B, AYPortWrite
  73+ 8F6B ~                    OUT (C), A
  74+ 8F6B                      ENDM
