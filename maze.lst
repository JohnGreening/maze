1157  9B78                      GET_WORLD_VALUE TILEMAP_PAGE, USE_BC
1157  9B78             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
1157  9B78             >;
1157  9B78             >;       arg  is TILEMAP_PAGE
1157  9B78             >;            or DFIELD_PAGE
1157  9B78             >;
1157  9B78             >;       arg1 decides if input comes from BC or directly from HL
1157  9B78             >;            NB if directly from HL then L = tile X, H = tile Y
1157  9B78             >;
1157  9B78             >        if USE_BC = 0
1157  9B78 61          >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
1157  9B79             >                                                    ; put it in H (this is the same as multiplying by 256)
1157  9B79 68          >        ld l, b                                     ; read the X tile coordinate into L
1157  9B7A             >                                                    ; Result: HL now holds tile_y * 256 + tile_x
1157  9B7A             >                                                    ; This is the byte offset into "world" map.
1157  9B7A             >        endif
1157  9B7A             >
1157  9B7A             >    ; STEP 2: Calculate which 8K physical page the data lives in
1157  9B7A 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
1157  9B7B CB 3F       >        srl  a                                      ; divide by 2
1157  9B7D CB 3F       >        srl  a                                      ; divide by 2 again  → now /4
1157  9B7F CB 3F       >        srl  a                                      ; /8
1157  9B81 CB 3F       >        srl  a                                      ; /16
1157  9B83 CB 3F       >        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
1157  9B85             >                                                    ; Why divide by 32?
1157  9B85             >                                                    ;   Each page is 8192 bytes.
1157  9B85             >                                                    ;   Each row is 256 bytes.
1157  9B85             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
1157  9B85             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
1157  9B85             >
1157  9B85 C6 28       >        add  a, TILEMAP_PAGE                                 ; add the starting page number
1157  9B87             >
1157  9B87 ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
1157  9B8A             >
1157  9B8A             >
1157  9B8A             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
1157  9B8A 7C          >        ld   a,h                                    ; get the high byte again
1157  9B8B E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
1157  9B8D             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
1157  9B8D             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
1157  9B8D 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
1157  9B8E             >
1157  9B8E             >    ; STEP 4: add the page offset so we can read it
1157  9B8E ED 34 00 C0 >        add  hl, $C000                              ; HL = $C000 + offset_inside_page
1157  9B92             >                                                    ; HL now points directly at the first byte we want to copy
1157  9B92 7E          >        ld a, (hl)                                  ; so get the byte
