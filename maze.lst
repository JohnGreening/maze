 831  98BB                      DIV_HL_8
 831  98BB             >; simple 16-bit divide without the CALL/RET overhead
 831  98BB CB 3C       >        srl h                                       ; divide by 2
 831  98BD CB 1D       >        rr l
 831  98BF CB 3C       >        srl h                                       ; divide by 4
 831  98C1 CB 1D       >        rr l
 831  98C3 CB 3C       >        srl h                                       ; divide by 8
 831  98C5 CB 1D       >        rr l
 832  98C7 7D                   ld a, l
 833  98C8 32 C9 8E             ld (player_tile_y), a
 834  98CB
 835  98CB 3A C8 8E             ld a, (player_tile_x)
 836  98CE 6F                   ld l, a
 837  98CF 26 00                ld h, 0
 838  98D1 ED 34 20 00          add hl, 32
 839  98D5
 840  98D5 3A C9 8E             ld a, (player_tile_y)
 841  98D8 C6 20                add 32
 842  98DA 5F                   ld e, a
 843  98DB
 844  98DB 3E 00                ld a, 0
 845  98DD ED 92 34             NEXTREG $34, a                 ; select sprite slot 0 (player)
 846  98E0 7D                   ld a, l
 847  98E1 ED 92 35             NEXTREG $35, a                 ; attr 0: X low 8 bits
 848  98E4 7B                   ld a, e
 849  98E5 ED 92 36             NEXTREG $36, a                 ; attr 1: Y (8-bit)
 850  98E8 7C                   ld a, h
 851  98E9 E6 01                and 1                          ; X is 9-bit; keep only bit 8
 852  98EB ED 92 37             NEXTREG $37, a                 ; attr 2: X MSB in bit 0
 853  98EE 3E 02                ld a, 2
 854  98F0 F6 80                or %10000000                   ; bit 7 = visible
 855  98F2 ED 92 38             NEXTREG $38, a                 ; attr 3: pattern + visible flag
 856  98F5
 857  98F5
 858  98F5 C9                   ret
