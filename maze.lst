1024  99EC
1025  99EC              reverse:
1026  99EC 78                   ld a, b                                     ; set d to be the reverse direction
1027  99ED
1028  99ED 87                   add a, a
1029  99EE 21 B1 9A             ld hl, baddieMoveLUT
1030  99F1 ED 31                add hl, a
1031  99F3 7E                   ld a, (hl)
1032  99F4 23                   inc hl
1033  99F5 66                   ld h, (hl)
1034  99F6 6F                   ld l, a
1035  99F7 E9                   jp (hl)
1036  99F8
1037  99F8              ; ============================================================
1038  99F8              ; pickByField - of the available directions (mask in E), choose the
1039  99F8              ; neighbour with the lowest field distance. Returns vdir flag in A,
1040  99F8              ; or 0 if none usable. Reads tileX/tileY from the record.
1041  99F8              ; ============================================================
1042  99F8              pickByField:
