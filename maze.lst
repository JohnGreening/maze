 380  94E4              ; ============================================================
 381  94E4              ; updateCameraXY - recompute camera from player, clamped to map.
 382  94E4              ;   cam = player - CENTRE, then clamped to [0 .. CAM_MAX]
 383  94E4              ; Low clamp: if (player - CENTRE) < 0  -> 0   (sign test)
 384  94E4              ; High clamp: if value > CAM_MAX       -> CAM_MAX
 385  94E4              ; ============================================================
 386  94E4              updateCameraXY:
