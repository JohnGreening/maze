 756  98C0
 757  98C0              .loop:
 758  98C0 CD 4D 99             call processBaddie                          ; process each baddie in turn
 759  98C3 CD 11 99             call checkBaddieCollision                   ; check collision
 760  98C6 DC 09 99             call c, .hit
 761  98C9
 762  98C9 11 0B 00             ld de, baddieRecord                         ; get baddie record length
 763  98CC DD 19                add ix, de                                  ; point ix to next baddie
 764  98CE DD 7D                ld a, ixl
 765  98D0 FE 08                cp low baddieEnd
 766  98D2 20 EC                jr nz, .loop
 767  98D4 DD 7C                ld a, ixh
 768  98D6 FE 92                cp high baddieEnd
 769  98D8 20 E6                jr nz, .loop
 770  98DA
 771  98DA 3A 05 94             ld a, (viewMode)                            ; get view mode
 772  98DD B7                   or a                                        ; is it 0 (normal map view)
 773  98DE C8                   ret z                                       ; return if normal
 774  98DF
 775  98DF                      ; -------------------------------------------------------
 776  98DF                      ; here we just display the player if we are in Radar mode
 777  98DF                      ; -------------------------------------------------------
 778  98DF
 779  98DF                      ; tile x/y already calculated, just use them
 780  98DF 3A 6C 8F             ld a, (player_tile_x)
 781  98E2 6F                   ld l, a
 782  98E3 26 00                ld h, 0
 783  98E5 ED 34 20 00          add hl, 32
 784  98E9
 785  98E9 3A 6D 8F             ld a, (player_tile_y)
 786  98EC C6 20                add 32
 787  98EE 5F                   ld e, a
 788  98EF
 789  98EF AF                   xor a
 790  98F0 ED 92 34             NEXTREG $34, a                              ; select sprite slot 0 (player)
 791  98F3 7D                   ld a, l
 792  98F4 ED 92 35             NEXTREG $35, a                              ; attr 0: X low 8 bits
 793  98F7 7B                   ld a, e
 794  98F8 ED 92 36             NEXTREG $36, a                              ; attr 1: Y (8-bit)
 795  98FB 7C                   ld a, h
 796  98FC E6 01                and 1                                       ; X is 9-bit; keep only bit 8
 797  98FE ED 92 37             NEXTREG $37, a                              ; attr 2: X MSB in bit 0
 798  9901 3E 02                ld a, 2
 799  9903 F6 80                or %10000000                                ; bit 7 = visible
 800  9905 ED 92 38             NEXTREG $38, a                              ; attr 3: pattern + visible flag
