1157  9C62              displayBaddie:
1158  9C62                  ; ============================================================
1159  9C62                  ; Draw baddie sprite (sprite #1) relative to the centred player.
1160  9C62                  ; Player is locked to screen centre, so:
1161  9C62                  ;     screenPos = baddieWorldPos - playerWorldPos + screenCentre
1162  9C62                  ; A 16x16 sprite is shown whenever ANY part overlaps the display,
1163  9C62                  ; so we allow up to 15px of overhang at each edge before hiding.
1164  9C62                  ; IX already points at the baddie record (set by processBaddies).
1165  9C62                  ; ============================================================
1166  9C62
1167  9C62 3A 05 94             ld a, (viewMode)
1168  9C65 B7                   or a
1169  9C66 C2 D8 9C             jp nz, radarBaddie
1170  9C69
1171  9C69                  ; ---------- SCREEN X ----------
1172  9C69                      ; HL = baddie world X
1173  9C69 DD 6E 01             ld l, (ix + baddieRecord.lowX)
1174  9C6C DD 66 02             ld h, (ix + baddieRecord.highX)
1175  9C6F ED 4B FA 8F          ld bc, (cam_px)                             ; BC = player world X
1176  9C73 B7                   or a                                        ; clear carry for a clean subtract
1177  9C74 ED 42                sbc hl, bc                                  ; HL = baddieX - playerX  (signed)
1178  9C76                  ; add screen centre AND the 15px overhang bias in one go.
1179  9C76                  ; CENTER_SCREEN_X + 15 = 152 + 15 = 167, which fits in 8 bits,
1180  9C76                  ; so we can use the Z80N "add hl,a" (cheaper to set up than add hl,bc).
1181  9C76 3E 0F                ld a,  15                                   ; A = 167  (centre + bias)
1182  9C78 ED 31                add hl, a                                   ; Z80N: HL = biased screen X
1183  9C7A                  ; HL now holds (screenX + 15). Visible-with-overhang means the
1184  9C7A                  ; UN-biased X is in -15..319, i.e. the BIASED value is in 0..334.
1185  9C7A                  ; Reject anything outside 0..334 with an unsigned range test.
1186  9C7A 7C                   ld a, h                                     ; look at high byte of biased X
1187  9C7B FE 01                cp 1                                        ; H = 0 ?  (biased X = 0..255)
1188  9C7D 38 07                jr c, .xInRange                             ; H = 0 -> definitely <= 334, in range
1189  9C7F 20 4C                jr nz, .hideBaddie                          ; H >= 2 -> biased X >= 512 -> off right
1190  9C81                  ; H = 1 here, so biased X = 256..511; allowed only up to 334 ($014E),
1191  9C81                  ; meaning the low byte must be < 79 (334 - 256 = 78).
1192  9C81 7D                   ld a, l
1193  9C82 FE 4F                cp 79
1194  9C84 30 47                jr nc, .hideBaddie                          ; low byte >= 79 -> off right edge
1195  9C86              .xInRange:
1196  9C86 E5                   push hl                                     ; save biased X (we still need it later)
