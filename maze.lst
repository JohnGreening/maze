  93+ 8709              ; 8-Bit Binary to Decimal Digits Extraction
  94+ 8709              ; Input:  A  = 8-bit binary number (0 - 255)
  95+ 8709              ;         B  = char row (0..23), C = char col (0..31)
  96+ 8709              ; Calls displayChar with A to display each digit
  97+ 8709              Bin8ToDec:
  98+ 8709              ; --- Step 1: Extract 100s Digit ---
  99+ 8709 1E 2F                ld      e, '0' - 1                          ; Initialize ASCII counter
 100+ 870B              .Loop100:
 101+ 870B 1C                   inc     e                                   ; Increment ASCII character
 102+ 870C D6 64                sub     100                                 ; Subtract 100
 103+ 870E 30 FB                jr      nc, .Loop100                        ; Repeat if no underflow (result >= 0)
 104+ 8710 C6 64                add     a, 100                              ; Restore the remainder (add 100 back)
 105+ 8712
 106+ 8712 57                   ld      d, a                                ; Temporarily save remainder in B
 107+ 8713 7B                   ld      a, e                                ; Get 100s digit
 108+ 8714 CD CB 86             call displayChar
 109+ 8717 7A                   ld      a, d                                ; Restore remainder to A
 110+ 8718
 111+ 8718              ; --- Step 2: Extract 10s Digit ---
 112+ 8718 1E 2F                ld      e, '0' - 1                          ; Re-initialize ASCII counter
 113+ 871A              .Loop10:
 114+ 871A 1C                   inc     e                                   ; Increment ASCII character
 115+ 871B D6 0A                sub     10                                  ; Subtract 10
 116+ 871D 30 FB                jr      nc, .Loop10                         ; Repeat if no underflow (result >= 0)
 117+ 871F C6 0A                add     a, 10                               ; Restore the remainder (add 10 back)
 118+ 8721
 119+ 8721 57                   ld      d, a                                ; Temporarily save 1s digit in B
 120+ 8722 7B                   ld      a, e                                ; Get 10s digit
 121+ 8723 CD CB 86             call displayChar
 122+ 8726
 123+ 8726              ; --- Step 3: Extract 1s Digit ---
 124+ 8726 7A                   ld      a, d                                ; Restore 1s digit to A
