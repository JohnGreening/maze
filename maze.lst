 576  96A4 ED A0       >        LDI
 576  96A6 ED A0       >        LDI
 576  96A8 ED A0       >        LDI
 576  96AA ED A0       >        LDI
 576  96AC ED A0       >        LDI
 576  96AE ED A0       >        LDI
 576  96B0 ED A0       >        LDI
 576  96B2 ED A0       >        LDI
 576  96B4 ED A0       >        LDI
 576  96B6 ED A0       >        LDI
 576  96B8 ED A0       >        LDI
 576  96BA ED A0       >        LDI
 576  96BC ED A0       >        LDI
 576  96BE ED A0       >        LDI
 576  96C0 ED A0       >        LDI
 576  96C2 ED A0       >        LDI
 576  96C4 ED A0       >        LDI
 576  96C6 ED A0       >        LDI
 576  96C8 ED A0       >        LDI
 576  96CA ED A0       >        LDI
 576  96CC ED A0       >        LDI
 576  96CE ED A0       >        LDI
 576  96D0 ED A0       >        LDI
 576  96D2 ED A0       >        LDI
 576  96D4 ED A0       >        LDI
 576  96D6 ED A0       >        LDI
 576  96D8 ED A0       >        LDI
 576  96DA ED A0       >        LDI
 576  96DC ED A0       >        LDI
 576  96DE ED A0       >        LDI
 577  96E0              ENDR
 578  96E0                  ; STEP 7: Move the source pointer forward by exactly one full world-map row
 579  96E0 3E D8                ld   a,216                                  ; 256 (full row) minus 40 (what we already copied) = 216
 580  96E2 ED 31                add  hl,a                                   ; Z80N instruction — adds 8-bit number to HL very quickly
 581  96E4
 582  96E4 7C                   LD A, H
 583  96E5 FE E0                CP $E0
 584  96E7 CC F0 96             CALL Z, .cross_boundary
 585  96EA
 586  96EA 78                   ld a, b
 587  96EB B1                   or c
 588  96EC C2 90 96             jp nz, .row_loop
 589  96EF C9                   ret
 590  96F0
 591  96F0              .cross_boundary
 592  96F0                  ; STEP 8: Did we cross into the next 8K physical page?
 593  96F0 7C                   ld   a,h                                    ; look at the high byte of the source pointer
 594  96F1 D6 20                sub  $20                                    ; $20 is 32 in decimal. $E000 - $2000 = $C000 → subtract 32 from the high byte to wrap back to the start of slot 6
 595  96F3 67                   ld   h,a
 596  96F4 3A D0 8E             ld a, (tilemapPage)
 597  96F7 3C                   inc a
 598  96F8 32 D0 8E             ld (tilemapPage), a
 599  96FB ED 92 56             nextreg $56, a                              ; set MMU slot 6 ($C000-$DFFF) to that page
 600  96FE C9                   ret
