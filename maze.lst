 279  93F6 1E 00            	ld e, 0                                     ; set mask to 0
 280  93F8 3A DC 8E         	ld a, (player_px)                           ; get player px (low byte   )
 281  93FB E6 07            	and 7                                       ; check bits 2-0, if 0 then vertical movement may be allowed
