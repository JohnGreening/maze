 378+ 7DFD              ; Configure Sprite and Layers System
 379+ 7DFD              ; NEXTREG $15, %00000011
 380+ 7DFD ED 91 15 17      NEXTREG $15, %00010111
 381+ 7E01              ; bit 7 1=enable lo-res
 382+ 7E01              ; bit 6 1=flip sprite rendering priority
 383+ 7E01              ; bit 5 1=change clipping over border mode
 384+ 7E01              ; bit 4-2 000=sprites on top, layer 2 under
 385+ 7E01              ; bit 1 1=enable sprites over border
 386+ 7E01              ; bit 0 1=enable sprite visibility
 387+ 7E01
 388+ 7E01 01 3B 30         LD BC, $303b                 ; set port for Sprites
 389+ 7E04 97 97            SUB A, A                     ; Set sprite index to 0
 390+ 7E06 ED 79            OUT (C), A                   ; write to port
 391+ 7E08
 392+ 7E08 21 00 66         LD HL, SpritePatterns; point to sprite patterns
 393+ 7E0B 01 5B 00         LD BC, $5b                    ; set port to write patterns to
