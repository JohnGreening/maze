 465  95F2              chkLeft:
 466  95F2                      checkLeftM player_px, player_py, move_delta
 466  95F2 2A 76 8F    >        ld hl, (player_px)                               ; get X pixel
 466  95F5 01 02 00    >        ld bc, move_delta                         ; move pixel delta
 466  95F8 B7          >        or a                                        ; clear carry
 466  95F9 ED 42       >        sbc hl, bc                                  ; simulate move left
 466  95FB             >        DIV_HL_8A                                   ; divide by 8 to get tile X
 466  95FB             >; version 2, 40 t-states (8 t-states quicker than DIV_HL_8)
 466  95FB             >; simple 16-bit divide without the CALL/RET overhead
 466  95FB 7D          >        ld a, l                                     ; get low byte into a ready for rotate from carry   4t
 466  95FC CB 3C       >        srl h                                       ;                                                   8t
 466  95FE 1F          >        rra                                         ;                                                   4t
 466  95FF CB 3C       >        srl h                                       ;                                                   8t
 466  9601 1F          >        rra                                         ;                                                   4t
 466  9602 CB 3C       >        srl h                                       ;                                                   8t
 466  9604 1F          >        rra                                         ;                                                   4t
 466  9605 47          >        ld b, a                                     ; B = tile X
 466  9606             >
 466  9606 2A 78 8F    >        ld hl, (player_py)                               ; get Y pixel
 466  9609             >        DIV_HL_8A                                   ; divide by 8 to get tile Y
 466  9609             >; version 2, 40 t-states (8 t-states quicker than DIV_HL_8)
 466  9609             >; simple 16-bit divide without the CALL/RET overhead
 466  9609 7D          >        ld a, l                                     ; get low byte into a ready for rotate from carry   4t
 466  960A CB 3C       >        srl h                                       ;                                                   8t
 466  960C 1F          >        rra                                         ;                                                   4t
 466  960D CB 3C       >        srl h                                       ;                                                   8t
 466  960F 1F          >        rra                                         ;                                                   4t
 466  9610 CB 3C       >        srl h                                       ;                                                   8t
 466  9612 1F          >        rra                                         ;                                                   4t
 466  9613 4F          >        ld c, a                                     ; C = tile Y
 466  9614             >
 466  9614             >        GET_WORLD_VALUE TILEMAP_PAGE, USE_BC        ; see what tile is here
 466  9614             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 466  9614             >;
 466  9614             >;       arg  is TILEMAP_PAGE
 466  9614             >;            or DFIELD_PAGE
 466  9614             >;
 466  9614             >;       arg1 decides if input comes from BC or directly from HL
 466  9614             >;            NB if directly from HL then L = tile X, H = tile Y
 466  9614             >;
 466  9614             >        if USE_BC = 0
 466  9614 61          >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 466  9615             >                                                    ; put it in H (this is the same as multiplying by 256)
 466  9615 68          >        ld l, b                                     ; read the X tile coordinate into L
 466  9616             >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 466  9616             >                                                    ; This is the byte offset into "world" map.
 466  9616             >        endif
 466  9616             >
 466  9616             >    ; STEP 2: Calculate which 8K physical page the data lives in
 466  9616 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 466  9617             >;        srl  a                                      ; divide by 2
 466  9617             >;        srl  a                                      ; divide by 2 again  → now /4
 466  9617             >;        srl  a                                      ; /8
 466  9617             >;        srl  a                                      ; /16
 466  9617             >;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 466  9617             >; ------------------------------------------------------------------------
 466  9617             >; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
 466  9617             >; saves 21 t-state
 466  9617             >; ------------------------------------------------------------------------
 466  9617 07          >        rlca
 466  9618 07          >        rlca
 466  9619 07          >        rlca
 466  961A E6 07       >        and 7
 466  961C             >                                                    ; Why divide by 32?
 466  961C             >                                                    ;   Each page is 8192 bytes.
 466  961C             >                                                    ;   Each row is 256 bytes.
 466  961C             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 466  961C             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 466  961C             >
 466  961C C6 28       >        add  a, TILEMAP_PAGE                                 ; add the starting page number
 466  961E 32 6B 8F    >        ld (curWorldPage), a                        ; save page for subsequent reads - likely no need to reload
 466  9621 ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 466  9624             >
 466  9624             >
 466  9624             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 466  9624 7C          >        ld   a,h                                    ; get the high byte again
 466  9625 E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 466  9627             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 466  9627             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 466  9627 F6 C0       >        or $C0                                      ; "add" page offset
 466  9629 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 466  962A             >
 466  962A             >    ; STEP 4: read the byte
 466  962A             >                                                    ; HL now points directly at the first byte we want to copy
 466  962A 7E          >        ld a, (hl)                                  ; so get the byte
 466  962B FE 01       >        cp MAP_WALL                                 ; is it a wall?
 466  962D C8          >        ret z                                       ; return if so, do nothing
 466  962E             >
 466  962E             >; ----------------------------------------------------------------
 466  962E             >; worldBelow - read the map/field byte one tile-row below the byte
 466  962E             >; GET_WORLD_VALUE just fetched. HL still points at that byte.
 466  962E             >; Handles the (rare) 8K page cross. Returns tile in A.
 466  962E             >; ----------------------------------------------------------------
 466  962E             >.worldBelow:
 466  962E 24          >        inc  h                                      ; +256 bytes = one map row down
 466  962F 7C          >        ld   a, h                                   ; put in a for compare
 466  9630 FE E0       >        cp   $E0                                    ; walked past the end of slot 6 ($C000-$DFFF)?
 466  9632 20 0C       >        jr   nz, .same                              ; branch if not
 466  9634 26 C0       >        ld   h, $C0                                 ; wrap back to slot-6 base
 466  9636 3A 6B 8F    >        ld   a, (curWorldPage)                      ; get last saved page
 466  9639 3C          >        inc  a                                      ; advance it
 466  963A 32 6B 8F    >        ld   (curWorldPage), a                      ; save it back
 466  963D ED 92 56    >        nextreg $56, a                              ; page in new block
 466  9640             >.same:
 466  9640 7E          >        ld   a, (hl)                                ; see what tile is here
 466  9641 FE 01       >        cp MAP_WALL                                 ; is it a wall?
 466  9643 C8          >        ret z                                       ; return if so, do nothing
 466  9644             >
 466  9644 CB C3       >        set dir_left, e                             ; set bit in E indicating move is allowed
 466  9646 C9          >        ret
