 404  9592              ; ============================================================
 405  9592              ; updateCameraXY - recompute camera from player, clamped to map.
 406  9592              ;   cam = player - CENTRE, then clamped to [0 .. CAM_MAX]
 407  9592              ; Low clamp: if (player - CENTRE) < 0  -> 0   (sign test)
 408  9592              ; High clamp: if value > CAM_MAX       -> CAM_MAX
 409  9592              ; ============================================================
 410  9592              updateCameraXY:
 411  9592 CD 5A 81             call addScore
 412  9595
 413  9595                      ; ---------- X ----------
 414  9595 2A 0C 90             ld hl, (player_px)
 415  9598 01 98 00             ld bc, CENTRE_X
 416  959B B7                   or a
 417  959C ED 42                sbc hl, bc                                  ; hl = player_px - CENTRE_X
 418  959E F2 A4 95             jp p, .camXLowOK                            ; >= 0 -> keep
 419  95A1 21 00 00             ld hl, 0                                    ; negative -> clamp to 0
 420  95A4              .camXLowOK:
 421  95A4 01 C0 06             ld bc, CAM_MAX_X
 422  95A7 B7                   or a
 423  95A8 ED 42                sbc hl, bc                                  ; hl = value - CAM_MAX_X
 424  95AA 38 03                jr c, .camXHighOK                           ; carry set => value < max -> keep (after add back)
 425  95AC 21 00 00             ld hl, 0                                    ; value >= max -> result = max (after add back)
 426  95AF              .camXHighOK:
 427  95AF 09                   add hl, bc                                  ; add CAM_MAX_X back
 428  95B0 22 FA 8F             ld (cam_px), hl
 429  95B3
 430  95B3                      ; ---------- Y ----------
