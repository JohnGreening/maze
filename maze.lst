1198  9C87                  ; ---------- SCREEN Y ----------
1199  9C87                  ; HL = baddie world Y
1200  9C87 DD 6E 03             ld l, (ix + baddieRecord.lowY)
1201  9C8A DD 66 04             ld h, (ix + baddieRecord.highY)
1202  9C8D ED 4B FC 8F          ld bc, (cam_py)             ; BC = player world Y
1203  9C91 B7                   or a                           ; clear carry
1204  9C92 ED 42                sbc hl, bc                     ; HL = baddieY - playerY  (signed)
1205  9C94                  ; centre + bias again: CENTER_SCREEN_Y + 15 = 120 + 15 = 135, fits in 8 bits.
1206  9C94 3E 0F                ld a, 15     ; A = 135
1207  9C96 ED 31                add hl, a                      ; Z80N: HL = biased screen Y
1208  9C98                  ; Visible-with-overhang: un-biased Y in -15..255, i.e. biased Y in 0..270.
1209  9C98 7C                   ld a, h                        ; high byte of biased Y
1210  9C99 FE 01                cp 1                           ; H = 0 ?
1211  9C9B 38 07                jr c, .yInRange                ; H = 0 -> <= 270, in range
1212  9C9D 20 2D                jr nz, .hidePop                ; H >= 2 -> off bottom
1213  9C9F                  ; H = 1: biased Y = 256..511, allowed only up to 270 ($010E),
1214  9C9F                  ; so low byte must be < 15 (270 - 256 = 14).
1215  9C9F 7D                   ld a, l
1216  9CA0 FE 0F                cp 15
1217  9CA2 30 28                jr nc, .hidePop                ; low byte >= 15 -> off bottom edge
1218  9CA4              .yInRange:
1219  9CA4                  ; ---------- BADDIE IS ON SCREEN ----------
1220  9CA4                  ; Un-bias Y by 15 to get the real Y the hardware wants.
1221  9CA4                  ; The sprite Y register is 8-bit and takes the value mod 256,
1222  9CA4                  ; which is exactly what we need: a baddie 15px above the top
1223  9CA4                  ; (real Y = -15) writes 241, and the hardware draws it overhanging.
1224  9CA4 7D                   ld a, l                        ; low byte of biased Y
1225  9CA5 D6 0F                sub 15                         ; A = real screen Y (mod 256)
1226  9CA7 5F                   ld e, a                        ; stash Y in E for the moment
1227  9CA8
1228  9CA8 E1                   pop hl                         ; recover biased X
1229  9CA9 01 0F 00             ld bc, 15
1230  9CAC B7                   or a                           ; clear carry
1231  9CAD ED 42                sbc hl, bc                     ; HL = real screen X (full 9-bit value)
