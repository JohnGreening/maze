 152+ 874B                      GET_WORLD_VALUE DFIELD_PAGE, USE_HL
 152+ 874B             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 152+ 874B             >;
 152+ 874B             >;       arg  is TILEMAP_PAGE
 152+ 874B             >;            or DFIELD_PAGE
 152+ 874B             >;
 152+ 874B             >;       arg1 decides if input comes from BC or directly from HL
 152+ 874B             >;            NB if directly from HL then L = tile X, H = tile Y
 152+ 874B             >;
 152+ 874B             >        if USE_HL = 0
 152+ 874B ~           >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 152+ 874B ~           >                                                    ; put it in H (this is the same as multiplying by 256)
 152+ 874B ~           >        ld l, b                                     ; read the X tile coordinate into L
 152+ 874B ~           >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 152+ 874B ~           >                                                    ; This is the byte offset into "world" map.
 152+ 874B             >        endif
 152+ 874B             >
 152+ 874B             >    ; STEP 2: Calculate which 8K physical page the data lives in
 152+ 874B 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 152+ 874C             >;        srl  a                                      ; divide by 2
 152+ 874C             >;        srl  a                                      ; divide by 2 again  → now /4
 152+ 874C             >;        srl  a                                      ; /8
 152+ 874C             >;        srl  a                                      ; /16
 152+ 874C             >;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 152+ 874C             >; ------------------------------------------------------------------------
 152+ 874C             >; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
 152+ 874C             >; saves 21 t-state
 152+ 874C             >; ------------------------------------------------------------------------
 152+ 874C 07          >        rlca
 152+ 874D 07          >        rlca
 152+ 874E 07          >        rlca
 152+ 874F E6 07       >        and 7
 152+ 8751             >                                                    ; Why divide by 32?
 152+ 8751             >                                                    ;   Each page is 8192 bytes.
 152+ 8751             >                                                    ;   Each row is 256 bytes.
 152+ 8751             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 152+ 8751             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 152+ 8751             >
 152+ 8751 C6 2E       >        add  a, DFIELD_PAGE                                 ; add the starting page number
