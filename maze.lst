1380  F35F              ; ----------------------------------------------------------------
1381  F35F              ; Tilemap data - 48 KB stored directly in Pages 40 - 45
1382  F35F              ; ----------------------------------------------------------------
1383  F35F              TILEMAP_PAGE    EQU     40
1384  F35F
1385  F35F              ; === Chunk 1 (bytes 0-16383) -> 8 KB Page 40/41 ===
1386  F35F              MMU     6, TILEMAP_PAGE                             ; map page 40 into slot 6
1387  F35F              MMU     7, TILEMAP_PAGE + 1                         ; map page 41 into slot 7
1388  F35F              ORG     $C000
1389  C000              tilemap_part1:
1390  C000              INCBIN  "testmaze2.map", 0, 16384                    ; first 16 KB
1391  0000
1392  0000              ; === Chunk 2 (bytes 16384-32767) -> 8 KB Page 42/43 ===
1393  0000              MMU     6, TILEMAP_PAGE + 2
1394  0000              MMU     7, TILEMAP_PAGE + 3
1395  0000              ORG     $C000
1396  C000              tilemap_part2:
1397  C000              INCBIN  "testmaze2.map", 16384, 16384
1398  0000
1399  0000              ; === Chunk 3 (bytes 32768-49151) -> 8 KB Page 44/45 ===
1400  0000              MMU     6, TILEMAP_PAGE + 4
1401  0000              MMU     7, TILEMAP_PAGE + 5
1402  0000              ORG     $C000
1403  C000              tilemap_part3:
1404  C000              INCBIN  "testmaze2.map", 32768, 16384
1405  0000
1406  0000              ; ----------------------------------------------------------------
1407  0000              ; Distance field - 48 KB, one byte per maze cell (256x192).
1408  0000              ; Same layout as the map (256-byte rows) but in pages 46-51, so the
1409  0000              ; tile (x,y) -> address arithmetic is identical to GET_WORLD_VALUE
1410  0000              ; with base page DFIELD_PAGE instead of TILEMAP_PAGE.
1411  0000              ; Filled by the flood-fill; 255 = wall/unvisited/unreachable.
1412  0000              ; ----------------------------------------------------------------
1413  0000              DFIELD_PAGE     EQU     TILEMAP_PAGE + 6
1414  0000
1415  0000              ; reserve the six pages so they exist in the .nex (contents set at runtime)
1416  0000              MMU     6, DFIELD_PAGE
1417  0000              MMU     7, DFIELD_PAGE + 1
1418  0000              ORG     $C000
1419  C000              dfield_part1:
1420  C000 00 00 00...  DEFS    16384
1421  0000
1422  0000              MMU     6, DFIELD_PAGE + 2
1423  0000              MMU     7, DFIELD_PAGE + 3
1424  0000              ORG     $C000
1425  C000              dfield_part2:
1426  C000 00 00 00...  DEFS    16384
1427  0000
1428  0000              MMU     6, DFIELD_PAGE + 4
1429  0000              MMU     7, DFIELD_PAGE + 5
1430  0000              ORG     $C000
1431  C000              dfield_part3:
1432  C000 00 00 00...  DEFS    16384
1433  0000
1434  0000              ; --- radar / Layer 2 ---
1435  0000              L2_PAGE         equ DFIELD_PAGE + 6     ; Layer 2 image pages (52-57), after the field
1436  0000              L2_BANK16       equ L2_PAGE / 2         ; 16K bank number for reg $12 (=26)
1437  0000
1438  0000              MMU 6, L2_PAGE
1439  0000              MMU 7, L2_PAGE + 1
1440  0000              org $C000
1441  C000 00 00 00...  DEFS 16384
1442  0000
1443  0000              MMU 6, L2_PAGE + 2
1444  0000              MMU 7, L2_PAGE + 3
1445  0000              org $C000
1446  C000 00 00 00...  DEFS 16384
1447  0000
1448  0000              MMU 6, L2_PAGE + 4
1449  0000              MMU 7, L2_PAGE + 5
1450  0000              org $C000
1451  C000 00 00 00...  DEFS 16384
1452  0000
1453  0000              ; ----------------------------------------------------------------
1454  0000              ; Build the .nex file (automatically includes all used banks)
1455  0000              ; ----------------------------------------------------------------
1456  0000              SAVENEX OPEN "maze.nex", progStart, $FF40           ; entry point + stack
1457  0000              SAVENEX AUTO                                        ; include all pages we used
1458  0000              SAVENEX CLOSE
