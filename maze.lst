 844+ 85F6                  ; setSpriteClip - clip sprites to the play area (below the HUD).
 845+ 85F6                  ; Over-border mode is active, so:
 846+ 85F6                  ;   - X coords use the SAME doubling as the tilemap clip (copy 2,157)
 847+ 85F6                  ;   - Y coords are in sprite space: ULA-origin pixel + 32
 848+ 85F6                  ;       tilemap top  pixel 64  -> 64+32 = 96
 849+ 85F6                  ;       tilemap bot  pixel 251 -> 283 (overflows) -> clamp to 255
 850+ 85F6                  ; Requires $15 bit 5 (clip-over-border) set - see note.
 851+ 85F6 ED 91 15 23          NEXTREG $15, %00100011                      ; was %00010111; bit 5 = enable sprite clip over border
 852+ 85FA
 853+ 85FA ED 91 1C 02          nextreg $1C, 2                              ; bit 1 = reset the SPRITE clip index
 854+ 85FE ED 91 19 00          nextreg $19, 0                              ; X1 (doubled units, same as tilemap) -> pixel 4
 855+ 8602 ED 91 19 9F          nextreg $19, 159                            ; X2 -> pixel 315
 856+ 8606 ED 91 19 40          nextreg $19, 64                             ; Y1 = 64 -> top of play area
 857+ 860A ED 91 19 FF          nextreg $19, 255                            ; Y2 = clamp (283 overflows a byte; screen edge handles bottom)
 858+ 860E C9                   ret
