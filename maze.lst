 825  98A5                      ; first calculate the player tile X/Y
 826  98A5 2A C4 8E             ld hl, (player_px)
 827  98A8                      DIV_HL_8
 827  98A8             >; simple 16-bit divide without the CALL/RET overhead
 827  98A8 CB 3C       >        srl h                                       ; divide by 2
 827  98AA CB 1D       >        rr l
 827  98AC CB 3C       >        srl h                                       ; divide by 4
 827  98AE CB 1D       >        rr l
 827  98B0 CB 3C       >        srl h                                       ; divide by 8
 827  98B2 CB 1D       >        rr l
