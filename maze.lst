 875  987E              newTile:
 876  987E DD 70 05             ld (ix +baddieRecord.tileX), b              ; save the tile X
 877  9881 DD 71 06             ld (ix +baddieRecord.tileY), c              ; save the tile Y
 878  9884
 879  9884                      ; get reverse direction
 880  9884 DD 7E 07             ld a, (ix + baddieRecord.dir)               ; Load current direction
 881  9887 47                   ld b, a                                     ; Backup original direction to B
 882  9888 E6 03                and %00000011                               ; Check for Left (1) / Right (2)
 883  988A 28 05                jr z, .vertMask                             ; If 0, it must be vertical (Up/Down)
 884  988C
 885  988C                      ; Horizontal Path: Swap 1 <-> 2
 886  988C                      ; 'A' already contains ONLY the horizontal bits here
 887  988C EE 03                xor %00000011                               ; 1 becomes 2, 2 becomes 1
 888  988E 47                   ld b, a                                     ; Store final result in B
 889  988F 18 04                jr .done
 890  9891
 891  9891              .vertMask:
 892  9891                      ; Vertical Path: Swap 4 <-> 8
 893  9891                      ; Because 'A' was 0, 'B' still holds the unaltered original vertical value
 894  9891 78                   ld a, b                                     ; Bring original back to A to process
 895  9892 EE 0C                xor %00001100                               ; 4 becomes 8, 8 becomes 4
 896  9894 47                   ld b, a                                     ; Store final result in B
 897  9895
 898  9895              .done:
 899  9895                      ; d holds current direction (bitmask)
 900  9895 C5                   push bc                                     ; save reverse on stack for use later
 901  9896 3E 0F                ld a, %00001111                             ; start with all directions
 902  9898 A8                   xor b                                       ; mask out reverse
 903  9899
 904  9899              ; -----------------------------------------------
 905  9899              ; Test each direction to see if a move is allowed
 906  9899              ; -----------------------------------------------
 907  9899 57                   ld d, a                                     ; D = directions to test (all except reverse)
 908  989A 1E 00                ld e, 0                                     ; E = available directions found
 909  989C
 910  989C CB 42                bit dir_left, d
 911  989E C4 BA 99             call nz, chkLeft1
 912  98A1
 913  98A1 CB 4A                bit dir_right, d
 914  98A3 C4 13 9A             call nz, chkRight1
 915  98A6
 916  98A6 CB 52                bit dir_down, d
 917  98A8 C4 6E 9A             call nz, chkDown1
 918  98AB
 919  98AB CB 5A                bit dir_up, d
 920  98AD C4 B8 9A             call nz, chkUp1
 921  98B0
 922  98B0              ;-----------------------
 923  98B0              ; pick direction to take
 924  98B0              ; ----------------------
 925  98B0 C1                   pop bc                                      ; retrieve the saved reverse direction
 926  98B1 7B                   ld a, e                                     ; get what moves were possible
 927  98B2 A7                   and a                                       ; are there any?
 928  98B3 28 3C                jr z, reverse
 929  98B5
 930  98B5              moveAvailable:
 931  98B5                      ; E = available-direction mask. Choose pick method by mode.
 932  98B5                      ; Read own-cell distance first (one field read) -> sets lastDist.
 933  98B5 DD 46 05             ld b, (ix + baddieRecord.tileX)             ; B = tileX
 934  98B8 DD 4E 06             ld c, (ix + baddieRecord.tileY)             ; C = tileY
 935  98BB                      GET_WORLD_VALUE DFIELD_PAGE, USE_BC
 935  98BB             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 935  98BB             >;
 935  98BB             >;       arg  is TILEMAP_PAGE
 935  98BB             >;            or DFIELD_PAGE
 935  98BB             >;
 935  98BB             >;       arg1 decides if input comes from BC or directly from HL
 935  98BB             >;            NB if directly from HL then L = tile X, H = tile Y
 935  98BB             >;
 935  98BB             >        if USE_BC = 0
 935  98BB 61          >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 935  98BC             >                                                    ; put it in H (this is the same as multiplying by 256)
 935  98BC 68          >        ld l, b                                     ; read the X tile coordinate into L
 935  98BD             >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 935  98BD             >                                                    ; This is the byte offset into "world" map.
 935  98BD             >        endif
 935  98BD             >
 935  98BD             >    ; STEP 2: Calculate which 8K physical page the data lives in
 935  98BD 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 935  98BE             >;        srl  a                                      ; divide by 2
 935  98BE             >;        srl  a                                      ; divide by 2 again  → now /4
 935  98BE             >;        srl  a                                      ; /8
 935  98BE             >;        srl  a                                      ; /16
 935  98BE             >;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 935  98BE             >; ------------------------------------------------------------------------
 935  98BE             >; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
 935  98BE             >; saves 21 t-state
 935  98BE             >; ------------------------------------------------------------------------
 935  98BE 07          >        rlca
 935  98BF 07          >        rlca
 935  98C0 07          >        rlca
 935  98C1 E6 07       >        and 7
 935  98C3             >                                                    ; Why divide by 32?
 935  98C3             >                                                    ;   Each page is 8192 bytes.
 935  98C3             >                                                    ;   Each row is 256 bytes.
 935  98C3             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 935  98C3             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 935  98C3             >
 935  98C3 C6 2E       >        add  a, DFIELD_PAGE                                 ; add the starting page number
 935  98C5 32 D1 8E    >        ld (curWorldPage), a                        ; save page for subsequent reads - likely no need to reload
 935  98C8 ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 935  98CB             >
 935  98CB             >
 935  98CB             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 935  98CB 7C          >        ld   a,h                                    ; get the high byte again
 935  98CC E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 935  98CE             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 935  98CE             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 935  98CE F6 C0       >        or $C0                                      ; "add" page offset
 935  98D0 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 935  98D1             >
 935  98D1             >    ; STEP 4: read the byte
 935  98D1             >                                                    ; HL now points directly at the first byte we want to copy
 935  98D1 7E          >        ld a, (hl)                                  ; so get the byte
 936  98D2
 937  98D2 DD 77 0A             ld (ix + baddieRecord.lastDist), a
 938  98D5 4F                   ld c, a                                     ; keep own distance in C for the mode test
 939  98D6                                                                  ; (B no longer needed; pickByField re-reads tileX/Y)
 940  98D6
 941  98D6 DD 7E 09             ld a, (ix + baddieRecord.mode)
 942  98D9 FE 02                cp mode_wander
 943  98DB 28 0F                jr z, .pickWander                           ; forced wander
 944  98DD
 945  98DD FE 01                cp mode_hunt
 946  98DF 28 05                jr z, .pickHunt                             ; forced hunt
 947  98E1
 948  98E1                      ; mode_auto: hunt only if own distance <= 253 (scent present)
 949  98E1 79                   ld a, c
 950  98E2 FE FE                cp 254
 951  98E4 30 06                jr nc, .pickWander                          ; >=254 -> no scent -> wander
 952  98E6
 953  98E6              .pickHunt:
 954  98E6 CD FD 98             call pickByField                            ; A = chosen vdir, or 0 if none
 955  98E9 A7                   and a
 956  98EA 20 04                jr nz, gotDir                               ; got a direction
 957  98EC                      ; fall through to wander if field gave nothing
 958  98EC
 959  98EC              .pickWander:
 960  98EC 7B                   ld a, e
 961  98ED CD F2 9B             call random
 962  98F0
 963  98F0              gotDir:
 964  98F0 47                   ld b, a                                     ; B = chosen direction (vdir flag)
 965  98F1
 966  98F1              reverse:
 967  98F1 78                   ld a, b                                     ; set d to be the reverse direction
 968  98F2
 969  98F2 87                   add a, a
 970  98F3 21 A8 99             ld hl, baddieMoveLUT
 971  98F6 ED 31                add hl, a
 972  98F8 7E                   ld a, (hl)
 973  98F9 23                   inc hl
 974  98FA 66                   ld h, (hl)
 975  98FB 6F                   ld l, a
 976  98FC E9                   jp (hl)
 977  98FD
 978  98FD              ; ============================================================
 979  98FD              ; pickByField - of the available directions (mask in E), choose the
 980  98FD              ; neighbour with the lowest field distance. Returns vdir flag in A,
 981  98FD              ; or 0 if none usable. Reads tileX/tileY from the record.
 982  98FD              ; ============================================================
 983  98FD              pickByField:
 984  98FD DD 46 05             ld b, (ix + baddieRecord.tileX)             ; get baddie tile X
 985  9900 DD 4E 06             ld c, (ix + baddieRecord.tileY)             ; get baddie tile Y
 986  9903 DD 7E 0A             ld a, (ix + baddieRecord.lastDist)          ; own-cell distance
 987  9906 32 A6 99             ld (pf_best), a                             ; save best found
 988  9909
 989  9909 AF                   xor a                                       ; A = 0
 990  990A 32 A7 99             ld (pf_dir), a                              ; current direction is nothing
 991  990D
 992  990D CB 43                bit dir_left, e                             ; is a turn left permitted
 993  990F 28 1E                jr z, .noL                                  ; branch if not
 994  9911 78                   ld a, b                                     ; get tile X
 995  9912 3D                   dec a                                       ; look left
 996  9913 6F                   ld l, a                                     ; put test tile X in H for lookup
 997  9914 61                   ld h, c                                     ; put tile Y in L for lookup
