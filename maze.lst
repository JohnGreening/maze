  51+ 7E90             >;        srl  a                                      ; /8
  51+ 7E90             >;        srl  a                                      ; /16
  51+ 7E90             >;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
  51+ 7E90             >; ------------------------------------------------------------------------
  51+ 7E90             >; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
  51+ 7E90             >; saves 21 t-state
  51+ 7E90             >; ------------------------------------------------------------------------
  51+ 7E90 07          >        rlca
  51+ 7E91 07          >        rlca
  51+ 7E92 07          >        rlca
  51+ 7E93 E6 07       >        and 7
  51+ 7E95             >                                                    ; Why divide by 32?
  51+ 7E95             >                                                    ;   Each page is 8192 bytes.
  51+ 7E95             >                                                    ;   Each row is 256 bytes.
  51+ 7E95             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
  51+ 7E95             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
  51+ 7E95             >
