 154+ 7F16 ED 34 00 C0 >        add  hl, $C000                              ; HL = $C000 + offset_inside_page
 154+ 7F1A             >                                                    ; HL now points directly at the first byte we want to copy
 154+ 7F1A 7E          >        ld a, (hl)                                  ; so get the byte
