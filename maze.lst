 152+ 873D                      GET_WORLD_VALUE DFIELD_PAGE, USE_HL
 152+ 873D             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 152+ 873D             >;
 152+ 873D             >;       arg  is TILEMAP_PAGE
 152+ 873D             >;            or DFIELD_PAGE
 152+ 873D             >;
 152+ 873D             >;       arg1 decides if input comes from BC or directly from HL
 152+ 873D             >;            NB if directly from HL then L = tile X, H = tile Y
 152+ 873D             >;
 152+ 873D             >        if USE_HL = 0
 152+ 873D ~           >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 152+ 873D ~           >                                                    ; put it in H (this is the same as multiplying by 256)
 152+ 873D ~           >        ld l, b                                     ; read the X tile coordinate into L
 152+ 873D ~           >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 152+ 873D ~           >                                                    ; This is the byte offset into "world" map.
 152+ 873D             >        endif
 152+ 873D             >
 152+ 873D             >    ; STEP 2: Calculate which 8K physical page the data lives in
 152+ 873D 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 152+ 873E             >;        srl  a                                      ; divide by 2
 152+ 873E             >;        srl  a                                      ; divide by 2 again  → now /4
 152+ 873E             >;        srl  a                                      ; /8
 152+ 873E             >;        srl  a                                      ; /16
 152+ 873E             >;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 152+ 873E             >; ------------------------------------------------------------------------
 152+ 873E             >; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
 152+ 873E             >; saves 21 t-state
 152+ 873E             >; ------------------------------------------------------------------------
 152+ 873E 07          >        rlca
 152+ 873F 07          >        rlca
 152+ 8740 07          >        rlca
 152+ 8741 E6 07       >        and 7
 152+ 8743             >                                                    ; Why divide by 32?
 152+ 8743             >                                                    ;   Each page is 8192 bytes.
 152+ 8743             >                                                    ;   Each row is 256 bytes.
 152+ 8743             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 152+ 8743             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 152+ 8743             >
 152+ 8743 C6 2E       >        add  a, DFIELD_PAGE                                 ; add the starting page number
 152+ 8745 32 5D 8F    >        ld (curWorldPage), a                        ; save page for subsequent reads - likely no need to reload
 152+ 8748 ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 152+ 874B             >
 152+ 874B             >
 152+ 874B             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 152+ 874B 7C          >        ld   a,h                                    ; get the high byte again
 152+ 874C E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 152+ 874E             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 152+ 874E             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 152+ 874E F6 C0       >        or $C0                                      ; "add" page offset
 152+ 8750 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 152+ 8751             >
 152+ 8751             >    ; STEP 4: read the byte
 152+ 8751             >                                                    ; HL now points directly at the first byte we want to copy
 152+ 8751 7E          >        ld a, (hl)                                  ; so get the byte
 153+ 8752 06 01                ld b, 1
 154+ 8754 0E 10                ld c, 16
 155+ 8756 CD FB 86             call Bin8ToDec
 156+ 8759 E1                   pop hl
