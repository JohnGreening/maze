 406+ 7E1B              ; set values for Sprites palette 1
 407+ 7E1B ED 91 43 20      NEXTREG $43, %00100000
 408+ 7E1F              ; bit 7 1=disable palette auto inc
 409+ 7E1F              ; bit 6-4 select palette for r/w
 410+ 7E1F              ; 000 = ULA palette 1
 411+ 7E1F              ; 100 = ULA palette 2
 412+ 7E1F              ; 001 = Layer 2 palette 1
 413+ 7E1F              ; 101 = Layer 2 palette 2
