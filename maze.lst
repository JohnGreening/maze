 805  980E              ; IX -> baddie record. Returns carry SET if player overlaps this baddie.
 806  980E              ; Trashes AF, DE, HL
 807  980E              checkBaddieCollision:
 808  980E                      ; --- X: |player_px - baddie_x| < COLLIDE_DX ? ---
 809  980E 2A DC 8E             ld hl, (player_px)
 810  9811 DD 5E 01             ld e, (ix + baddieRecord.lowX)
 811  9814 DD 56 02             ld d, (ix + baddieRecord.highX)
 812  9817 B7                   or a
 813  9818 ED 52                sbc hl, de                                  ; HL = player_px - baddie_x
 814  981A CB 7C                bit 7, h                                    ; negative?
 815  981C 28 07                jr z, .xAbs
 816  981E EB                   ex de, hl
 817  981F 21 00 00             ld hl, 0
