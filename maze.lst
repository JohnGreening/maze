  68+ 869A 18 0B                jr .draw
  69+ 869C
  70+ 869C              .udg
  71+ 869C D6 80                sub 128
  72+ 869E 1E 08                ld e, 8
  73+ 86A0 57                   ld d, a
  74+ 86A1 ED 30                mul d, e
  75+ 86A3 ED 35 0F 86          add de, udgBase
  76+ 86A7
  77+ 86A7              .draw
  78+ 86A7 06 08                ld b, 8                                     ; 8 lines to a char
  79+ 86A9              dcLine:
  80+ 86A9 1A                   ld a, (de)                                  ; get the bitmap row
  81+ 86AA 77                   ld (hl), a                                  ; put it onto ULA
  82+ 86AB 13                   inc de                                      ; next row
  83+ 86AC 24                   inc h                                       ; down one pixel line within the cell
  84+ 86AD 10 FA                djnz dcLine                                 ; loop for all 8 lines
  85+ 86AF D1                   pop de
  86+ 86B0 C1                   pop bc
  87+ 86B1 0C                   inc c                                       ; advance to next column
  88+ 86B2 79                   ld a, c                                     ; put A to clamp
  89+ 86B3 E6 1F                and 31                                      ; clamp at 31
