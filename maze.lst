 685  9785              ; ============================================================
 686  9785              ; checkKeyCollect
 687  9785              ; Tests whether the player's 2x2 footprint overlaps any
 688  9785              ; AVAILABLE key's 2x2 block.
 689  9785              ; Returns: A = key index (0..KEY_COUNT-1) and carry SET if a
 690  9785              ;          key was collected; carry CLEAR (A undefined) if none.
 691  9785              ; Uses player_tile_x / player_tile_y (must be current).
 692  9785              ; Trashes: AF, BC, DE, HL
 693  9785              ; ============================================================
 694  9785              checkKeyCollect:
 695  9785 21 3D 7E             ld hl, KEY_DATA
 696  9788 06 00                ld b, 0                                     ; B = key index
 697  978A              .loop:
 698  978A 7E                   ld a, (hl)                                  ; key tileX
 699  978B 23                   inc hl
 700  978C 4E                   ld c, (hl)                                  ; key tileY
 701  978D 23                   inc hl
 702  978E 5E                   ld e, (hl)                                  ; status
 703  978F 23                   inc hl                                      ; HL -> next key record
 704  9790
 705  9790                      ; skip keys that aren't available
 706  9790 57                   ld d, a                                     ; save key tileX in D (A about to be reused)
 707  9791 7B                   ld a, e
 708  9792 FE 01                cp KEY_AVAILABLE
 709  9794 20 1B                jr nz, .next                                ; not available -> skip
 710  9796
 711  9796                      ; --- X overlap: abs(player_tile_x - keyX) <= 1 ? ---
 712  9796 3A E0 8E             ld a, (player_tile_x)
 713  9799 92                   sub d                                       ; A = px - kx
 714  979A 30 02                jr nc, .xpos
 715  979C ED 44                neg                                         ; A = |px - kx|
 716  979E              .xpos:
 717  979E FE 02                cp 2
 718  97A0 30 0F                jr nc, .next                                ; |dx| >= 2 -> no overlap
 719  97A2
 720  97A2                      ; --- Y overlap: abs(player_tile_y - keyY) <= 1 ? ---
 721  97A2 3A E1 8E             ld a, (player_tile_y)
 722  97A5 91                   sub c                                       ; A = py - ky
 723  97A6 30 02                jr nc, .ypos
 724  97A8 ED 44                neg
 725  97AA              .ypos:
 726  97AA FE 02                cp 2
 727  97AC 30 03                jr nc, .next                                ; |dy| >= 2 -> no overlap
 728  97AE
 729  97AE                      ; overlap on both axes -> collected this key
 730  97AE 78                   ld a, b                                     ; A = key index
 731  97AF 37                   scf                                         ; carry set = collected
 732  97B0 C9                   ret
 733  97B1
 734  97B1              .next:
 735  97B1 04                   inc b
 736  97B2 78                   ld a, b
 737  97B3 FE 04                cp KEY_COUNT
 738  97B5 20 D3                jr nz, .loop
 739  97B7 B7                   or a                            ; clear carry = nothing collected
 740  97B8 C9                   ret
 741  97B9
 742  97B9
 743  97B9              ; point to end of skull data. We will use this to test if finished processing all the skulls
 744  97B9              ; saves having a register holding the processed count
 745  97B9              baddieEnd equ baddieData + (baddieRecord * baddieCount)
