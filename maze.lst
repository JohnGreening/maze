 616  980E              showSprite:
 617  980E              ; ============================================================
 618  980E              ; Returns the floodfill distance for the player's tile in A.
 619  980E              ; 255 = wall / unreached. Lower = closer to flood target.
 620  980E              ; Trashes: AF, HL, BC
 621  980E              ; ============================================================
 622  980E 2A 78 8F             ld hl, (player_py)
 623  9811                      DIV_HL_8A                                    ; A = tileY (player_py / 8)
 623  9811             >; version 2, 40 t-states (8 t-states quicker than DIV_HL_8)
 623  9811             >; simple 16-bit divide without the CALL/RET overhead
 623  9811 7D          >        ld a, l                                     ; get low byte into a ready for rotate from carry   4t
 623  9812 CB 3C       >        srl h                                       ;                                                   8t
 623  9814 1F          >        rra                                         ;                                                   4t
 623  9815 CB 3C       >        srl h                                       ;                                                   8t
 623  9817 1F          >        rra                                         ;                                                   4t
 623  9818 CB 3C       >        srl h                                       ;                                                   8t
 623  981A 1F          >        rra                                         ;                                                   4t
 624  981B 32 7B 8F             ld (player_tile_y), a
 625  981E
 626  981E 2A 76 8F             ld hl, (player_px)
 627  9821                      DIV_HL_8A                                    ; A = tileX (player_px / 8)
 627  9821             >; version 2, 40 t-states (8 t-states quicker than DIV_HL_8)
 627  9821             >; simple 16-bit divide without the CALL/RET overhead
 627  9821 7D          >        ld a, l                                     ; get low byte into a ready for rotate from carry   4t
 627  9822 CB 3C       >        srl h                                       ;                                                   8t
 627  9824 1F          >        rra                                         ;                                                   4t
 627  9825 CB 3C       >        srl h                                       ;                                                   8t
 627  9827 1F          >        rra                                         ;                                                   4t
 627  9828 CB 3C       >        srl h                                       ;                                                   8t
 627  982A 1F          >        rra                                         ;                                                   4t
 628  982B 32 7A 8F             ld (player_tile_x), a
 629  982E
 630  982E CD AC 83             call stampTrail
 631  9831
 632  9831                      ; ... player_tile_x / player_tile_y just stored ...
 633  9831 CD 88 98             call checkKeyCollect
 634  9834 30 03                jr nc, .noKey               ; carry clear -> nothing collected
 635  9836                      ; A = collected key index -> handle it
 636  9836 CD 62 7E             call collectKey             ; mark collected, clear tiles, bump count, re-flood
 637  9839              .noKey:
 638  9839                      ; ... rest of showSprite ...
 639  9839
 640  9839 3A 05 94             ld a, (viewMode)                            ; get the view mode, normal or radar
 641  983C B7                   or a                                        ; see it it is 0 (normal)
 642  983D C0                   ret nz                                      ; return if Radar (player sprite rendered in process baddie routine)
 643  983E
 644  983E
 645  983E AF                   xor a                                       ; sprite index = 0
 646  983F ED 92 34             NEXTREG $34, A
 647  9842 2A 76 8F             ld hl, (player_px)
 648  9845 ED 4B 64 8F          ld bc, (cam_px)
 649  9849 ED 42                sbc hl, bc
 650  984B 5C                   ld e, h
 651  984C
 652  984C 7D                   LD A, l                                     ; set the low byte of player X
 653  984D ED 92 35             NEXTREG $35, A
 654  9850
 655  9850 2A 78 8F             ld hl, (player_py)
 656  9853 ED 4B 66 8F          ld bc, (cam_py)
 657  9857 ED 42                sbc hl, bc
 658  9859
 659  9859 7D                   LD A, l                                     ; set the low byte of player Y
 660  985A ED 92 36             NEXTREG $36, A
 661  985D 7B                   LD A, e                                     ; get the high byte of player X
 662  985E E6 01                AND 1                                       ; we only need bit 0
 663  9860 ED 92 37             NEXTREG $37, A                              ; set it
 664  9863
 665  9863                      ; --- choose pattern from facing direction + animation frame ---
 666  9863 3A 7F 8F             ld a, (lastMove)                            ; vdir flag: 1=L 2=R 4=D 8=U
 667  9866 06 04                ld b, PAT_DOWN                              ; default down
 668  9868 FE 01                cp vdir_left
 669  986A 20 04                jr nz, .notL
 670  986C 06 0C                ld b, PAT_LEFT
 671  986E 18 0E                jr .haveBase
 672  9870              .notL:
 673  9870 FE 02                cp vdir_right
 674  9872 20 04                jr nz, .notR
 675  9874 06 08                ld b, PAT_RIGHT
 676  9876 18 06                jr .haveBase
 677  9878              .notR:
 678  9878 FE 08                cp vdir_up
 679  987A 20 02                jr nz, .haveBase                            ; else stays PAT_DOWN
 680  987C 06 10                ld b, PAT_UP
 681  987E              .haveBase:
 682  987E 3A 80 8F             ld a, (playerAnimFrame)                     ; 0-3
 683  9881 80                   add a, b                                    ; base + frame = pattern
 684  9882
 685  9882 F6 80                OR %10000000                                ; bit 7 = visible
 686  9884 ED 92 38             NEXTREG $38, A
 687  9887 C9                   RET
 688  9888
 689  9888              ; ============================================================
 690  9888              ; checkKeyCollect
 691  9888              ; Tests whether the player's 2x2 footprint overlaps any
 692  9888              ; AVAILABLE key's 2x2 block.
 693  9888              ; Returns: A = key index (0..KEY_COUNT-1) and carry SET if a
 694  9888              ;          key was collected; carry CLEAR (A undefined) if none.
 695  9888              ; Uses player_tile_x / player_tile_y (must be current).
 696  9888              ; Trashes: AF, BC, DE, HL
 697  9888              ; ============================================================
 698  9888              checkKeyCollect:
 699  9888 21 3D 7E             ld hl, KEY_DATA
 700  988B 06 00                ld b, 0                                     ; B = key index
 701  988D              .loop:
 702  988D 7E                   ld a, (hl)                                  ; key tileX
 703  988E 23                   inc hl
 704  988F 4E                   ld c, (hl)                                  ; key tileY
 705  9890 23                   inc hl
 706  9891 5E                   ld e, (hl)                                  ; status
 707  9892 23                   inc hl                                      ; HL -> next key record
 708  9893
 709  9893                      ; skip keys that aren't available
 710  9893 57                   ld d, a                                     ; save key tileX in D (A about to be reused)
 711  9894 7B                   ld a, e
 712  9895 FE 01                cp KEY_AVAILABLE
 713  9897 20 1B                jr nz, .next                                ; not available -> skip
 714  9899
 715  9899                      ; --- X overlap: abs(player_tile_x - keyX) <= 1 ? ---
 716  9899 3A 7A 8F             ld a, (player_tile_x)
 717  989C 92                   sub d                                       ; A = px - kx
 718  989D 30 02                jr nc, .xpos
 719  989F ED 44                neg                                         ; A = |px - kx|
 720  98A1              .xpos:
 721  98A1 FE 02                cp 2
 722  98A3 30 0F                jr nc, .next                                ; |dx| >= 2 -> no overlap
 723  98A5
 724  98A5                      ; --- Y overlap: abs(player_tile_y - keyY) <= 1 ? ---
 725  98A5 3A 7B 8F             ld a, (player_tile_y)
 726  98A8 91                   sub c                                       ; A = py - ky
 727  98A9 30 02                jr nc, .ypos
 728  98AB ED 44                neg
 729  98AD              .ypos:
 730  98AD FE 02                cp 2
 731  98AF 30 03                jr nc, .next                                ; |dy| >= 2 -> no overlap
 732  98B1
 733  98B1                      ; overlap on both axes -> collected this key
 734  98B1 78                   ld a, b                                     ; A = key index
 735  98B2 37                   scf                                         ; carry set = collected
 736  98B3 C9                   ret
 737  98B4
 738  98B4              .next:
 739  98B4 04                   inc b
 740  98B5 78                   ld a, b
 741  98B6 FE 04                cp KEY_COUNT
 742  98B8 20 D3                jr nz, .loop
 743  98BA B7                   or a                            ; clear carry = nothing collected
 744  98BB C9                   ret
 745  98BC
 746  98BC
 747  98BC              ; point to end of skull data. We will use this to test if finished processing all the skulls
 748  98BC              ; saves having a register holding the processed count
 749  98BC              baddieEnd equ baddieData + (baddieRecord * baddieCount)
 750  98BC
 751  98BC              processBaddies:
 752  98BC DD 21 82 8F          ld ix, baddieData                           ; point to start of baddie data
 753  98C0
 754  98C0              .loop:
 755  98C0 CD 3F 99             call processBaddie                          ; process each baddie in turn
 756  98C3 CD 11 99             call checkBaddieCollision                   ; check collision
 757  98C6 DC 09 99             call c, .hit
 758  98C9
 759  98C9 11 0B 00             ld de, baddieRecord                         ; get baddie record length
 760  98CC DD 19                add ix, de                                  ; point ix to next baddie
 761  98CE DD 7D                ld a, ixl
 762  98D0 FE 16                cp low baddieEnd
 763  98D2 20 EC                jr nz, .loop
 764  98D4 DD 7C                ld a, ixh
 765  98D6 FE 92                cp high baddieEnd
 766  98D8 20 E6                jr nz, .loop
 767  98DA
 768  98DA 3A 05 94             ld a, (viewMode)                            ; get view mode
 769  98DD B7                   or a                                        ; is it 0 (normal map view)
 770  98DE C8                   ret z                                       ; return if normal
 771  98DF
 772  98DF                      ; -------------------------------------------------------
 773  98DF                      ; here we just display the player if we are in Radar mode
 774  98DF                      ; -------------------------------------------------------
 775  98DF
 776  98DF                      ; tile x/y already calculated, just use them
 777  98DF 3A 7A 8F             ld a, (player_tile_x)
 778  98E2 6F                   ld l, a
 779  98E3 26 00                ld h, 0
 780  98E5 ED 34 20 00          add hl, 32
 781  98E9
 782  98E9 3A 7B 8F             ld a, (player_tile_y)
 783  98EC C6 20                add 32
 784  98EE 5F                   ld e, a
 785  98EF
 786  98EF AF                   xor a
 787  98F0 ED 92 34             NEXTREG $34, a                              ; select sprite slot 0 (player)
 788  98F3 7D                   ld a, l
 789  98F4 ED 92 35             NEXTREG $35, a                              ; attr 0: X low 8 bits
 790  98F7 7B                   ld a, e
 791  98F8 ED 92 36             NEXTREG $36, a                              ; attr 1: Y (8-bit)
 792  98FB 7C                   ld a, h
 793  98FC E6 01                and 1                                       ; X is 9-bit; keep only bit 8
 794  98FE ED 92 37             NEXTREG $37, a                              ; attr 2: X MSB in bit 0
 795  9901 3E 02                ld a, 2
 796  9903 F6 80                or %10000000                                ; bit 7 = visible
 797  9905 ED 92 38             NEXTREG $38, a                              ; attr 3: pattern + visible flag
 798  9908
 799  9908 C9                   ret
