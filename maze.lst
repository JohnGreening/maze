 430  94B6 01 78 00             ld bc, CENTRE_Y
 431  94B9 B7                   or a
 432  94BA ED 42                sbc hl, bc                                  ; hl = player_py - CENTRE_Y
 433  94BC F2 C2 94             jp p, .camYLowOK
 434  94BF 21 00 00             ld hl, 0
 435  94C2              .camYLowOK:
 436  94C2 01 00 05             ld bc, CAM_MAX_Y
 437  94C5 B7                   or a
 438  94C6 ED 42                sbc hl, bc
 439  94C8 38 03                jr c, .camYHighOK
 440  94CA 21 00 00             ld hl, 0
 441  94CD              .camYHighOK:
 442  94CD 09                   add hl, bc
 443  94CE 22 CC 8E             ld (cam_py), hl
