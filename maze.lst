 784+ 85CC              ; ============================================================
 785+ 85CC              checkAnyKey:
 786+ 85CC 0E FE                ld c, $FE                   ; keyboard port low byte (constant)
 787+ 85CE 1E FE                ld e, $FE                   ; row-select pattern: one bit low, rotates
 788+ 85D0 16 08                ld d, 8                     ; 8 rows to check
 789+ 85D2              .scanRow:
 790+ 85D2 43                   ld b, e                     ; B = current row-select (high address byte)
 791+ 85D3 ED 78                in a, (c)                   ; read this half-row
 792+ 85D5 E6 1F                and $1F                     ; keep only the 5 key bits
 793+ 85D7 FE 1F                cp $1F                      ; all 1s = no key in this row
 794+ 85D9 20 07                jr nz, .pressed             ; a 0 bit = a key down -> pressed
 795+ 85DB CB 03                rlc e                       ; rotate the zero bit to the next row
 796+ 85DD 15                   dec d
 797+ 85DE 20 F2                jr nz, .scanRow
 798+ 85E0 B7                   or a                        ; checked all rows, none pressed -> clear carry
 799+ 85E1 C9                   ret
 800+ 85E2              .pressed:
 801+ 85E2 37                   scf                         ; key down -> set carry
 802+ 85E3 C9                   ret
