 149+ 86F6                      GET_WORLD_VALUE DFIELD_PAGE, USE_HL
 149+ 86F6             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 149+ 86F6             >;
 149+ 86F6             >;       arg  is TILEMAP_PAGE
 149+ 86F6             >;            or DFIELD_PAGE
 149+ 86F6             >;
 149+ 86F6             >;       arg1 decides if input comes from BC or directly from HL
 149+ 86F6             >;            NB if directly from HL then L = tile X, H = tile Y
 149+ 86F6             >;
 149+ 86F6             >        if USE_HL = 0
 149+ 86F6 ~           >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 149+ 86F6 ~           >                                                    ; put it in H (this is the same as multiplying by 256)
 149+ 86F6 ~           >        ld l, b                                     ; read the X tile coordinate into L
 149+ 86F6 ~           >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 149+ 86F6 ~           >                                                    ; This is the byte offset into "world" map.
 149+ 86F6             >        endif
 149+ 86F6             >
 149+ 86F6             >    ; STEP 2: Calculate which 8K physical page the data lives in
 149+ 86F6 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 149+ 86F7 CB 3F       >        srl  a                                      ; divide by 2
 149+ 86F9 CB 3F       >        srl  a                                      ; divide by 2 again  → now /4
 149+ 86FB CB 3F       >        srl  a                                      ; /8
 149+ 86FD CB 3F       >        srl  a                                      ; /16
 149+ 86FF CB 3F       >        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 149+ 8701             >                                                    ; Why divide by 32?
 149+ 8701             >                                                    ;   Each page is 8192 bytes.
 149+ 8701             >                                                    ;   Each row is 256 bytes.
 149+ 8701             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 149+ 8701             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 149+ 8701             >
 149+ 8701 C6 2E       >        add  a, DFIELD_PAGE                                 ; add the starting page number
 149+ 8703             >
 149+ 8703 ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 149+ 8706             >
 149+ 8706             >
 149+ 8706             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 149+ 8706 7C          >        ld   a,h                                    ; get the high byte again
 149+ 8707 E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 149+ 8709             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 149+ 8709             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 149+ 8709 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 149+ 870A             >
 149+ 870A             >    ; STEP 4: add the page offset so we can read it
 149+ 870A ED 34 00 C0 >        add  hl, $C000                              ; HL = $C000 + offset_inside_page
 149+ 870E             >                                                    ; HL now points directly at the first byte we want to copy
 149+ 870E 7E          >        ld a, (hl)                                  ; so get the byte
 150+ 870F              ;        call getFieldByte
 151+ 870F 01 12 00             ld bc, 18
 152+ 8712 CD B7 86             call Bin8ToDec
