 290+ 8269              ; ============================================================
 291+ 8269              ; floodFill - BFS from (floodTargetX,floodTargetY). Fills the
 292+ 8269              ; distance field: 0 at target, increasing outward, clamped at
 293+ 8269              ; 254. 255 = wall/unvisited/unreachable. INERT until called.
 294+ 8269              ; ============================================================
 295+ 8269              floodFill:
 296+ 8269 3E 00                ld a, 0                                     ; ready to initialise
 297+ 826B 32 00 93             ld (qHeadL), a                              ; set q head to 0
 298+ 826E 32 01 93             ld (qTailL), a                              ; set q tail to 0
 299+ 8271 32 02 93             ld (qCount), a                              ; set q depth to 0
 300+ 8274
 301+ 8274 3A 04 93             ld a, (floodTargetY)                        ; get our target cell Y
 302+ 8277 57                   ld d, a                                     ; put in D
 303+ 8278 3A 03 93             ld a, (floodTargetX)                        ; get out target cell X
 304+ 827B 5F                   ld e, a                                     ; put in E
 305+ 827C
 306+ 827C 62                   ld h, d                                     ; Y also in H
