 634  9831
 635  9831                      ; ... player_tile_x / player_tile_y just stored ...
 636  9831 CD 88 98             call checkKeyCollect
 637  9834 30 03                jr nc, .noKey               ; carry clear -> nothing collected
 638  9836                      ; A = collected key index -> handle it
 639  9836 CD 62 7E             call collectKey             ; mark collected, clear tiles, bump count, re-flood
 640  9839              .noKey:
 641  9839                      ; ... rest of showSprite ...
 642  9839
 643  9839 3A 05 94             ld a, (viewMode)                            ; get the view mode, normal or radar
 644  983C B7                   or a                                        ; see it it is 0 (normal)
