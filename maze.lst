 541  96E3              moveSprite1:
 542  96E3              ; ================================================
 543  96E3                  ; FINE SCROLLING (pixel-level smooth scroll)
 544  96E3                  ; Set hardware tilemap scroll registers using player_px/py
 545  96E3                  ; ================================================
 546  96E3 CD C0 97             call wait_vblank
 547  96E6
 548  96E6 3A B3 8E             ld a, (cam_px)                              ; get LOW byte of camera X position
 549  96E9 E6 07                and 7                                       ; keep only the bottom 3 bits (0-7 pixels)
 550  96EB ED 92 30             nextreg $30, a                              ; ← X fine offset (MUST be every frame)
 551  96EE
 552  96EE 3A B5 8E             ld a, (cam_py)                              ; get LOW byte of camera Y position
 553  96F1 E6 07                and 7                                       ; keep only the bottom 3 bits (0-7 pixels)
 554  96F3 ED 92 31             nextreg $31, a                              ; ← Y fine offset (MUST be every frame)
 555  96F6
 556  96F6              ; ================================================
 557  96F6                  ; COPY DECISION - copy ONLY when X or Y is aligned to tile boundary
 558  96F6                  ; ================================================
 559  96F6 2A B3 8E             ld hl, (cam_px)
 560  96F9                      DIV_HL_8
 560  96F9             >; simple 16-bit divide without the CALL/RET overhead
 560  96F9 CB 3C       >        srl h                                       ; divide by 2
 560  96FB CB 1D       >        rr l
 560  96FD CB 3C       >        srl h                                       ; divide by 4
 560  96FF CB 1D       >        rr l
 560  9701 CB 3C       >        srl h                                       ; divide by 8
 560  9703 CB 1D       >        rr l
 561  9705 45                   ld b, l
 562  9706 2A B5 8E             ld hl, (cam_py)
 563  9709                      DIV_HL_8
 563  9709             >; simple 16-bit divide without the CALL/RET overhead
 563  9709 CB 3C       >        srl h                                       ; divide by 2
 563  970B CB 1D       >        rr l
 563  970D CB 3C       >        srl h                                       ; divide by 4
 563  970F CB 1D       >        rr l
 563  9711 CB 3C       >        srl h                                       ; divide by 8
 563  9713 CB 1D       >        rr l
 564  9715 4D                   ld c, l
 565  9716
 566  9716 3A B7 8E             ld a, (cam_tx)                       ; get last player tile X
 567  9719 B8                   cp b                                        ; compare with current
 568  971A 20 07                jr nz, copy_visible_window                  ; branch if different
 569  971C
 570  971C 3A B8 8E             ld a, (cam_ty)                       ; get last player tile Y
 571  971F B9                   cp c                                        ; compare with current
 572  9720 20 01                jr nz, copy_visible_window                  ; branch if different
 573  9722
 574  9722 C9                   ret                                         ; otherwise return, hardware scroll is enough
 575  9723
 576  9723              copy_visible_window:
 577  9723 78                   ld a, b                                     ; get current player tile X
 578  9724 32 B7 8E             ld (cam_tx), a                       ; save it away
 579  9727 79                   ld a, c                                     ; get current player tile Y
 580  9728 32 B8 8E             ld (cam_ty), a                       ; save it away
 581  972B
 582  972B                  ; STEP 1: Build the starting linear offset in the world map
 583  972B 61                   ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 584  972C                                                                  ; put it in H (this is the same as multiplying cam_tile_y by 256)
 585  972C 68                   ld l, b                                     ; read the X tile coordinate into L
 586  972D                                                                  ; Result: HL now holds  cam_tile_y * 256 + cam_tile_x
 587  972D                                                                  ; This is the byte offset into "world" map.
 588  972D
 589  972D                  ; STEP 2: Calculate which 8K physical page the data lives in
 590  972D 7C                   ld   a,h                                    ; take the high byte of the offset (which is cam_tile_y)
 591  972E CB 3F                srl  a                                      ; divide by 2
 592  9730 CB 3F                srl  a                                      ; divide by 2 again  → now /4
 593  9732 CB 3F                srl  a                                      ; /8
 594  9734 CB 3F                srl  a                                      ; /16
 595  9736 CB 3F                srl  a                                      ; /32   ← this is the same as cam_tile_y ÷ 32
 596  9738                                                                  ; Why divide by 32?
 597  9738                                                                  ;   Each page is 8192 bytes.
 598  9738                                                                  ;   Each row is 256 bytes.
 599  9738                                                                  ;   8192 ÷ 256 = exactly 32 rows per page.
 600  9738                                                                  ;   Therefore page number = 40 + (cam_tile_y ÷ 32)
 601  9738 C6 28                add  a,40                                   ; add the starting page number (your world map begins at page 40)
 602  973A 32 B9 8E             ld   (tilemapPage), a                       ; save the page number in register C for later
 603  973D
 604  973D                  ; STEP 3: Keep only the part of the address that fits inside one 8K page
 605  973D 7C                   ld   a,h                                    ; get the high byte again
 606  973E E6 1F                and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 607  9740                                                                  ; This is exactly the same as (cam_tile_y * 256 + cam_tile_x) modulo 8192
 608  9740                                                                  ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 609  9740 67                   ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 610  9741
 611  9741                  ; STEP 4: Page the correct 8K bank into slot 6 so we can read it
 612  9741 3A B9 8E             ld   a, (tilemapPage)                       ; A = page number we want
 613  9744 ED 92 56             nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 614  9747 01 00 C0             ld   bc,$C000                               ; $C000 is the start of slot 6
 615  974A 09                   add  hl,bc                                  ; HL = $C000 + offset_inside_page
 616  974B                                                                  ; HL now points directly at the first byte we want to copy
 617  974B
 618  974B                  ; STEP 5: Point DE at the hardware tilemap buffer (fixed location)
 619  974B 11 00 60             ld   de, tileMap                                ; destination is the hardware tilemap location
 620  974E
 621  974E                  ; STEP 6: Copy all 32 visible rows
 622  974E 01 00 05             ld   bc,40*32                                   ; we need to copy 32 rows x 40 columns
 623  9751              .row_loop:
 624  9751              REPT 40
 625  9751 ED A0       >        LDI
 625  9753 ED A0       >        LDI
 625  9755 ED A0       >        LDI
 625  9757 ED A0       >        LDI
 625  9759 ED A0       >        LDI
 625  975B ED A0       >        LDI
 625  975D ED A0       >        LDI
 625  975F ED A0       >        LDI
 625  9761 ED A0       >        LDI
 625  9763 ED A0       >        LDI
 625  9765 ED A0       >        LDI
 625  9767 ED A0       >        LDI
 625  9769 ED A0       >        LDI
 625  976B ED A0       >        LDI
 625  976D ED A0       >        LDI
 625  976F ED A0       >        LDI
 625  9771 ED A0       >        LDI
 625  9773 ED A0       >        LDI
 625  9775 ED A0       >        LDI
 625  9777 ED A0       >        LDI
 625  9779 ED A0       >        LDI
 625  977B ED A0       >        LDI
 625  977D ED A0       >        LDI
 625  977F ED A0       >        LDI
 625  9781 ED A0       >        LDI
 625  9783 ED A0       >        LDI
 625  9785 ED A0       >        LDI
 625  9787 ED A0       >        LDI
 625  9789 ED A0       >        LDI
 625  978B ED A0       >        LDI
 625  978D ED A0       >        LDI
 625  978F ED A0       >        LDI
 625  9791 ED A0       >        LDI
 625  9793 ED A0       >        LDI
 625  9795 ED A0       >        LDI
 625  9797 ED A0       >        LDI
 625  9799 ED A0       >        LDI
 625  979B ED A0       >        LDI
 625  979D ED A0       >        LDI
 625  979F ED A0       >        LDI
 626  97A1              ENDR
 627  97A1                  ; STEP 7: Move the source pointer forward by exactly one full world-map row
 628  97A1 3E D8                ld   a,216                                      ; 256 (full row) minus 40 (what we already copied) = 216
 629  97A3 ED 31                add  hl,a                                       ; Z80N instruction — adds 8-bit number to HL very quickly
 630  97A5
 631  97A5 7C                   LD A, H
 632  97A6 FE E0                CP $E0
 633  97A8 CC B1 97             CALL Z, .cross_boundary
 634  97AB
 635  97AB 78                   ld a, b
 636  97AC B1                   or c
 637  97AD C2 51 97             jp nz, .row_loop
 638  97B0 C9                   ret
 639  97B1
 640  97B1              .cross_boundary
 641  97B1                  ; STEP 8: Did we cross into the next 8K physical page?
 642  97B1 7C                   ld   a,h                                        ; look at the high byte of the source pointer
 643  97B2 D6 20                sub  $20                                        ; $20 is 32 in decimal. $E000 - $2000 = $C000 → subtract 32 from the high byte to wrap back to the start of slot 6
 644  97B4 67                   ld   h,a
 645  97B5 3A B9 8E             ld a, (tilemapPage)
 646  97B8 3C                   inc a
 647  97B9 32 B9 8E             ld (tilemapPage), a
 648  97BC ED 92 56             nextreg $56, a                                  ; set MMU slot 6 ($C000-$DFFF) to that page
 649  97BF C9                   ret
