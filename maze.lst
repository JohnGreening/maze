 954  999D
 955  999D                      ; get reverse direction
 956  999D DD 7E 07             ld a, (ix + baddieRecord.dir)               ; Load current direction
 957  99A0 47                   ld b, a                                     ; Backup original direction to B
 958  99A1 E6 03                and %00000011                               ; Check for Left (1) / Right (2)
 959  99A3 28 05                jr z, .vertMask                             ; If 0, it must be vertical (Up/Down)
 960  99A5
 961  99A5                      ; Horizontal Path: Swap 1 <-> 2
 962  99A5                      ; 'A' already contains ONLY the horizontal bits here
 963  99A5 EE 03                xor %00000011                               ; 1 becomes 2, 2 becomes 1
 964  99A7 47                   ld b, a                                     ; Store final result in B
 965  99A8 18 04                jr .done
 966  99AA
 967  99AA              .vertMask:
 968  99AA                      ; Vertical Path: Swap 4 <-> 8
 969  99AA                      ; Because 'A' was 0, 'B' still holds the unaltered original vertical value
 970  99AA 78                   ld a, b                                     ; Bring original back to A to process
 971  99AB EE 0C                xor %00001100                               ; 4 becomes 8, 8 becomes 4
 972  99AD 47                   ld b, a                                     ; Store final result in B
 973  99AE
 974  99AE              .done:
 975  99AE                      ; d holds current direction (bitmask)
 976  99AE C5                   push bc                                     ; save reverse on stack for use later
 977  99AF 3E 0F                ld a, %00001111                             ; start with all directions
 978  99B1 A8                   xor b                                       ; mask out reverse
