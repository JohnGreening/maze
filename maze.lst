 250+ 823B              ; floodFill - BFS from (floodTargetX,floodTargetY). Fills the
 251+ 823B              ; distance field: 0 at target, increasing outward, clamped at
 252+ 823B              ; 254. 255 = wall/unvisited/unreachable. INERT until called.
 253+ 823B              ; ============================================================
 254+ 823B              floodFill:
 255+ 823B 3E 00                ld a, 0                                     ; ready to initialise
 256+ 823D 32 71 93             ld (qHeadIdx), a                            ; set q head to 0
 257+ 8240 32 72 93             ld (qTailIdx), a                            ; set q tail to 0
 258+ 8243 32 73 93             ld (qCount), a                              ; set q depth to 0
