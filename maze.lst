 596  9745              copy_visible_window:
 597  9745 78                   ld a, b                                     ; get current player tile X
 598  9746 32 C3 8E             ld (cam_tx), a                       ; save it away
 599  9749 79                   ld a, c                                     ; get current player tile Y
 600  974A 32 C4 8E             ld (cam_ty), a                       ; save it away
 601  974D
 602  974D                  ; STEP 1: Build the starting linear offset in the world map
 603  974D 61                   ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 604  974E                                                                  ; put it in H (this is the same as multiplying cam_tile_y by 256)
 605  974E 68                   ld l, b                                     ; read the X tile coordinate into L
 606  974F                                                                  ; Result: HL now holds  cam_tile_y * 256 + cam_tile_x
 607  974F                                                                  ; This is the byte offset into "world" map.
 608  974F
 609  974F                  ; STEP 2: Calculate which 8K physical page the data lives in
 610  974F 7C                   ld   a,h                                    ; take the high byte of the offset (which is cam_tile_y)
 611  9750 CB 3F                srl  a                                      ; divide by 2
 612  9752 CB 3F                srl  a                                      ; divide by 2 again  → now /4
 613  9754 CB 3F                srl  a                                      ; /8
 614  9756 CB 3F                srl  a                                      ; /16
 615  9758 CB 3F                srl  a                                      ; /32   ← this is the same as cam_tile_y ÷ 32
 616  975A                                                                  ; Why divide by 32?
 617  975A                                                                  ;   Each page is 8192 bytes.
 618  975A                                                                  ;   Each row is 256 bytes.
 619  975A                                                                  ;   8192 ÷ 256 = exactly 32 rows per page.
 620  975A                                                                  ;   Therefore page number = 40 + (cam_tile_y ÷ 32)
 621  975A C6 28                add  a,40                                   ; add the starting page number (your world map begins at page 40)
 622  975C 32 C5 8E             ld   (tilemapPage), a                       ; save the page number in register C for later
 623  975F
 624  975F                  ; STEP 3: Keep only the part of the address that fits inside one 8K page
 625  975F 7C                   ld   a,h                                    ; get the high byte again
 626  9760 E6 1F                and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 627  9762                                                                  ; This is exactly the same as (cam_tile_y * 256 + cam_tile_x) modulo 8192
 628  9762                                                                  ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 629  9762 67                   ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 630  9763
 631  9763                  ; STEP 4: Page the correct 8K bank into slot 6 so we can read it
