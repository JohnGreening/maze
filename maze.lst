 581  97C8 ED A0       >        LDI
 581  97CA ED A0       >        LDI
 581  97CC ED A0       >        LDI
 581  97CE ED A0       >        LDI
 581  97D0 ED A0       >        LDI
 581  97D2 ED A0       >        LDI
 581  97D4 ED A0       >        LDI
 581  97D6 ED A0       >        LDI
 581  97D8 ED A0       >        LDI
 581  97DA ED A0       >        LDI
 581  97DC ED A0       >        LDI
 581  97DE ED A0       >        LDI
 582  97E0              ENDR
 583  97E0                  ; STEP 7: Move the source pointer forward by exactly one full world-map row
 584  97E0 3E D8                ld   a,216                                  ; 256 (full row) minus 40 (what we already copied) = 216
