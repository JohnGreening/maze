  93+ 86C3              ; 8-Bit Binary to Decimal Digits Extraction
  94+ 86C3              ; Input:  A  = 8-bit binary number (0 - 255)
  95+ 86C3              ;         B  = char row (0..23), C = char col (0..31)
  96+ 86C3              ; Calls displayChar with A to display each digit
  97+ 86C3              Bin8ToDec:
  98+ 86C3              ; --- Step 1: Extract 100s Digit ---
  99+ 86C3 1E 2F                ld      e, '0' - 1                          ; Initialize ASCII counter
 100+ 86C5              .Loop100:
 101+ 86C5 1C                   inc     e                                   ; Increment ASCII character
 102+ 86C6 D6 64                sub     100                                 ; Subtract 100
 103+ 86C8 30 FB                jr      nc, .Loop100                        ; Repeat if no underflow (result >= 0)
 104+ 86CA C6 64                add     a, 100                              ; Restore the remainder (add 100 back)
 105+ 86CC
 106+ 86CC 57                   ld      d, a                                ; Temporarily save remainder in B
 107+ 86CD 7B                   ld      a, e                                ; Get 100s digit
 108+ 86CE CD 85 86             call displayChar
 109+ 86D1 7A                   ld      a, d                                ; Restore remainder to A
 110+ 86D2
 111+ 86D2              ; --- Step 2: Extract 10s Digit ---
 112+ 86D2 1E 2F                ld      e, '0' - 1                          ; Re-initialize ASCII counter
 113+ 86D4              .Loop10:
 114+ 86D4 1C                   inc     e                                   ; Increment ASCII character
 115+ 86D5 D6 0A                sub     10                                  ; Subtract 10
 116+ 86D7 30 FB                jr      nc, .Loop10                         ; Repeat if no underflow (result >= 0)
 117+ 86D9 C6 0A                add     a, 10                               ; Restore the remainder (add 10 back)
 118+ 86DB
 119+ 86DB 57                   ld      d, a                                ; Temporarily save 1s digit in B
 120+ 86DC 7B                   ld      a, e                                ; Get 10s digit
 121+ 86DD CD 85 86             call displayChar
 122+ 86E0
 123+ 86E0              ; --- Step 3: Extract 1s Digit ---
 124+ 86E0 7A                   ld      a, d                                ; Restore 1s digit to A
 125+ 86E1              DisplayDigit:
 126+ 86E1                      ; if calling from here then BC must be set with B=row, C=Column
 127+ 86E1 C6 30                add     a, '0'                              ; Convert the leftover 1s digit to ASCII
 128+ 86E3 CD 85 86             call displayChar
 129+ 86E6 C9                   ret
