 463  94F2              chkLeft:
 464  94F2                      checkLeftM player_px, player_py, move_delta
 464  94F2 2A DC 8E    >        ld hl, (player_px)                               ; get X pixel
 464  94F5 01 02 00    >        ld bc, move_delta                         ; move pixel delta
 464  94F8 B7          >        or a                                        ; clear carry
 464  94F9 ED 42       >        sbc hl, bc                                  ; simulate move left
 464  94FB             >        DIV_HL_8A                                   ; divide by 8 to get tile X
 464  94FB             >; version 2, 40 t-states (8 t-states quicker than DIV_HL_8)
 464  94FB             >; simple 16-bit divide without the CALL/RET overhead
 464  94FB 7D          >        ld a, l                                     ; get low byte into a ready for rotate from carry   4t
 464  94FC CB 3C       >        srl h                                       ;                                                   8t
 464  94FE 1F          >        rra                                         ;                                                   4t
 464  94FF CB 3C       >        srl h                                       ;                                                   8t
 464  9501 1F          >        rra                                         ;                                                   4t
 464  9502 CB 3C       >        srl h                                       ;                                                   8t
 464  9504 1F          >        rra                                         ;                                                   4t
 464  9505 47          >        ld b, a                                     ; B = tile X
 464  9506             >
 464  9506 2A DE 8E    >        ld hl, (player_py)                               ; get Y pixel
 464  9509             >        DIV_HL_8A                                   ; divide by 8 to get tile Y
 464  9509             >; version 2, 40 t-states (8 t-states quicker than DIV_HL_8)
 464  9509             >; simple 16-bit divide without the CALL/RET overhead
 464  9509 7D          >        ld a, l                                     ; get low byte into a ready for rotate from carry   4t
 464  950A CB 3C       >        srl h                                       ;                                                   8t
 464  950C 1F          >        rra                                         ;                                                   4t
 464  950D CB 3C       >        srl h                                       ;                                                   8t
 464  950F 1F          >        rra                                         ;                                                   4t
 464  9510 CB 3C       >        srl h                                       ;                                                   8t
 464  9512 1F          >        rra                                         ;                                                   4t
 464  9513 4F          >        ld c, a                                     ; C = tile Y
 464  9514             >
 464  9514             >        GET_WORLD_VALUE TILEMAP_PAGE, USE_BC        ; see what tile is here
 464  9514             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 464  9514             >;
 464  9514             >;       arg  is TILEMAP_PAGE
 464  9514             >;            or DFIELD_PAGE
 464  9514             >;
 464  9514             >;       arg1 decides if input comes from BC or directly from HL
 464  9514             >;            NB if directly from HL then L = tile X, H = tile Y
 464  9514             >;
 464  9514             >        if USE_BC = 0
 464  9514 61          >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 464  9515             >                                                    ; put it in H (this is the same as multiplying by 256)
 464  9515 68          >        ld l, b                                     ; read the X tile coordinate into L
 464  9516             >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 464  9516             >                                                    ; This is the byte offset into "world" map.
 464  9516             >        endif
 464  9516             >
 464  9516             >    ; STEP 2: Calculate which 8K physical page the data lives in
 464  9516 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 464  9517             >;        srl  a                                      ; divide by 2
 464  9517             >;        srl  a                                      ; divide by 2 again  → now /4
 464  9517             >;        srl  a                                      ; /8
 464  9517             >;        srl  a                                      ; /16
 464  9517             >;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 464  9517             >; ------------------------------------------------------------------------
 464  9517             >; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
 464  9517             >; saves 21 t-state
 464  9517             >; ------------------------------------------------------------------------
 464  9517 07          >        rlca
 464  9518 07          >        rlca
 464  9519 07          >        rlca
 464  951A E6 07       >        and 7
 464  951C             >                                                    ; Why divide by 32?
 464  951C             >                                                    ;   Each page is 8192 bytes.
 464  951C             >                                                    ;   Each row is 256 bytes.
 464  951C             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 464  951C             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 464  951C             >
 464  951C C6 28       >        add  a, TILEMAP_PAGE                                 ; add the starting page number
 464  951E 32 D1 8E    >        ld (curWorldPage), a                        ; save page for subsequent reads - likely no need to reload
 464  9521 ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 464  9524             >
 464  9524             >
 464  9524             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 464  9524 7C          >        ld   a,h                                    ; get the high byte again
 464  9525 E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 464  9527             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 464  9527             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 464  9527 F6 C0       >        or $C0                                      ; "add" page offset
 464  9529 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 464  952A             >
 464  952A             >    ; STEP 4: read the byte
