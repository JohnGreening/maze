 469  9652             >; simple 16-bit divide without the CALL/RET overhead
 469  9652 7D          >        ld a, l                                     ; get low byte into a ready for rotate from carry   4t
 469  9653 CB 3C       >        srl h                                       ;                                                   8t
 469  9655 1F          >        rra                                         ;                                                   4t
 469  9656 CB 3C       >        srl h                                       ;                                                   8t
