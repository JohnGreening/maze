  54+ 86C6 CB 21                sla c                                       ; multiply X by 8 to get pixel X
  55+ 86C8 CB 21                sla c
  56+ 86CA CB 21                sla c
  57+ 86CC 59                   ld e, c                                     ; put X in D for pixelad
  58+ 86CD ED 94                pixelad                                     ; HL -> address of the cell's top pixel line
  59+ 86CF
  60+ 86CF FE 80                cp 128
  61+ 86D1 30 0D                jr nc, .udg
  62+ 86D3
  63+ 86D3 D6 20                sub 32                                      ; calc index into charset
  64+ 86D5 1E 08                ld e, 8                                     ; each char is 8 bytes
