 801  9909              .hit:
 802  9909                     ; collision routine
 803  9909 3E 04                ld A, soundHitskull                         ; ready the skull hit sound
 804  990B CD A1 8E             call playsound                              ; play it
 805  990E C3 E4 81             jp takeDamage                               ; update health bar.
 806  9911                                                                  ; the RET in takeDamage will return us to processBaddies
 807  9911
 808  9911
 809  9911              ; IX -> baddie record. Returns carry SET if player overlaps this baddie.
 810  9911              ; Trashes AF, DE, HL
 811  9911              ; hit iff |player-baddie| <= COLLIDE-1 on both axes.
 812  9911              ; bias trick: |d| <= K  <=>  (d+K) in [0,2K] unsigned  -> one range test, no abs branch.
 813  9911              COLLIDE_DX      equ 11                              ; X overlap threshold (tune 9-14)
 814  9911              COLLIDE_DY      equ 11                              ; Y overlap threshold
 815  9911
 816  9911              COLLIDE_BIAS_X  equ COLLIDE_DX - 1          ; 10
 817  9911              COLLIDE_SPAN_X  equ 2*COLLIDE_DX - 1        ; 21
 818  9911              COLLIDE_BIAS_Y  equ COLLIDE_DY - 1          ; 10
 819  9911              COLLIDE_SPAN_Y  equ 2*COLLIDE_DY - 1        ; 21
 820  9911
 821  9911              ; IX -> baddie record. Returns carry SET if player overlaps this baddie.
 822  9911              ; Trashes AF, DE, HL
 823  9911              checkBaddieCollision:
 824  9911                      ; --- X ---
 825  9911 2A 76 8F             ld hl, (player_px)                          ; get player pixel xy
 826  9914 DD 5E 01             ld e, (ix + baddieRecord.lowX)              ; get skull pixel x
 827  9917 DD 56 02             ld d, (ix + baddieRecord.highX)             ;
 828  991A B7                   or a                                        ; clear carry
 829  991B ED 52                sbc hl, de                                  ; get diff, could be -ve
 830  991D ED 34 0A 00          add hl, COLLIDE_BIAS_X                      ; add in the collide threshold (remember sprites are 16 pixels wide)
 831  9921 7C                   ld a, h                                     ; check the high byte
 832  9922 B7                   or a                                        ; high byte set? (also clears carry)
 833  9923 C0                   ret nz                                      ; too big -> no hit (carry clear)
 834  9924 7D                   ld a, l                                     ; get low byte
 835  9925 FE 15                cp COLLIDE_SPAN_X                           ; L < 21 ?
 836  9927 D0                   ret nc                                      ; L >= 21 -> no hit (carry clear)
 837  9928
 838  9928                      ; --- Y --- (only reached when X overlaps)
 839  9928 2A 78 8F             ld hl, (player_py)                          ;
 840  992B DD 5E 03             ld e, (ix + baddieRecord.lowY)              ;
 841  992E DD 56 04             ld d, (ix + baddieRecord.highY)             ;
 842  9931 B7                   or a                                        ;
 843  9932 ED 52                sbc hl, de                                  ;
 844  9934 ED 34 0A 00          add hl, COLLIDE_BIAS_Y                      ;
 845  9938 7C                   ld a, h                                     ;
 846  9939 B7                   or a                                        ;
 847  993A C0                   ret nz                                      ;
 848  993B 7D                   ld a, l                                     ;
 849  993C FE 15                cp COLLIDE_SPAN_Y                           ;
 850  993E C9                   ret                                         ;
 851  993F
 852  993F
 853  993F              processBaddie:
 854  993F DD 66 04             ld h, (ix +baddieRecord.highY)              ; get baddie Y
 855  9942 DD 6E 03             ld l, (ix +baddieRecord.lowY)
 856  9945 22 18 92             ld (baddie_y), hl
 857  9948 7D                   ld a, l
 858  9949 E6 07                and 7
 859  994B FD 6F                ld iyl, a
 860  994D                      DIV_HL_8B                                   ; divide by 8 to get tile Y
 860  994D             >; version 3, 19 t-states (21 t-states quicker than A)
 860  994D             >; simple 16-bit divide without the CALL/RET overhead
 860  994D EB          >        EX DE, HL                                   ;                                                   4t
 860  994E 06 03       >        LD B, 3                                     ;                                                   7t
 860  9950 ED 29       >        BSRA DE, B                                  ;                                                   8t
 861  9952 4B                   ld c, e                                     ; save in C, see newTile below
 862  9953
 863  9953 DD 66 02             ld h, (ix +baddieRecord.highX)              ; get baddie X
 864  9956 DD 6E 01             ld l, (ix +baddieRecord.lowX)
 865  9959 22 16 92             ld (baddie_x), hl
 866  995C 7D                   ld a, l
 867  995D E6 07                and 7
 868  995F FD 67                ld iyh, a
 869  9961                      DIV_HL_8B                                   ; div by 8 to get tile Y
 869  9961             >; version 3, 19 t-states (21 t-states quicker than A)
 869  9961             >; simple 16-bit divide without the CALL/RET overhead
 869  9961 EB          >        EX DE, HL                                   ;                                                   4t
 869  9962 06 03       >        LD B, 3                                     ;                                                   7t
 869  9964 ED 29       >        BSRA DE, B                                  ;                                                   8t
 870  9966 43                   ld b, e                                     ; save in B, see newTile below
 871  9967
 872  9967              ; Decide only when grid-aligned (iyh==0 AND iyl==0) - the only
 873  9967                      ; moment a turn is possible. "Tile changed" fired at the far tile
 874  9967                      ; edge when moving up/left, where the turn check is gated out.
 875  9967 FD 7C                ld a, iyh
 876  9969 FD B5                or iyl                                      ; both zero => on grid intersection
 877  996B 28 06                jr z, newTile                               ; aligned -> run the decision
 878  996D
 879  996D DD 7E 07             ld a, (ix +baddieRecord.dir)                ; not aligned -> continue current dir
 880  9970 C3 E5 99             jp gotDir                                   ; jump to do the move
 881  9973
 882  9973              newTile:
 883  9973 DD 70 05             ld (ix +baddieRecord.tileX), b              ; save the tile X
 884  9976 DD 71 06             ld (ix +baddieRecord.tileY), c              ; save the tile Y
 885  9979
 886  9979                      ; get reverse direction
 887  9979 DD 7E 07             ld a, (ix + baddieRecord.dir)               ; Load current direction
 888  997C 47                   ld b, a                                     ; Backup original direction to B
 889  997D E6 03                and %00000011                               ; Check for Left (1) / Right (2)
 890  997F 28 05                jr z, .vertMask                             ; If 0, it must be vertical (Up/Down)
 891  9981
 892  9981                      ; Horizontal Path: Swap 1 <-> 2
 893  9981                      ; 'A' already contains ONLY the horizontal bits here
 894  9981 EE 03                xor %00000011                               ; 1 becomes 2, 2 becomes 1
 895  9983 47                   ld b, a                                     ; Store final result in B
 896  9984 18 04                jr .done
 897  9986
 898  9986              .vertMask:
 899  9986                      ; Vertical Path: Swap 4 <-> 8
 900  9986                      ; Because 'A' was 0, 'B' still holds the unaltered original vertical value
 901  9986 78                   ld a, b                                     ; Bring original back to A to process
 902  9987 EE 0C                xor %00001100                               ; 4 becomes 8, 8 becomes 4
 903  9989 47                   ld b, a                                     ; Store final result in B
 904  998A
 905  998A              .done:
 906  998A                      ; d holds current direction (bitmask)
 907  998A C5                   push bc                                     ; save reverse on stack for use later
 908  998B 3E 0F                ld a, %00001111                             ; start with all directions
 909  998D A8                   xor b                                       ; mask out reverse
 910  998E
 911  998E              ; -----------------------------------------------
 912  998E              ; Test each direction to see if a move is allowed
 913  998E              ; -----------------------------------------------
 914  998E 57                   ld d, a                                     ; D = directions to test (all except reverse)
 915  998F 1E 00                ld e, 0                                     ; E = available directions found
 916  9991
 917  9991 CB 42                bit dir_left, d
 918  9993 C4 AF 9A             call nz, chkLeft1
 919  9996
 920  9996 CB 4A                bit dir_right, d
 921  9998 C4 08 9B             call nz, chkRight1
 922  999B
 923  999B CB 52                bit dir_down, d
 924  999D C4 63 9B             call nz, chkDown1
 925  99A0
 926  99A0 CB 5A                bit dir_up, d
 927  99A2 C4 AD 9B             call nz, chkUp1
 928  99A5
 929  99A5              ;-----------------------
 930  99A5              ; pick direction to take
 931  99A5              ; ----------------------
