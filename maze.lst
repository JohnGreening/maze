 277+ 825D             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 277+ 825D             >;
 277+ 825D             >;       arg  is TILEMAP_PAGE
 277+ 825D             >;            or DFIELD_PAGE
 277+ 825D             >;
 277+ 825D             >;       arg1 decides if input comes from BC or directly from HL
 277+ 825D             >;            NB if directly from HL then L = tile X, H = tile Y
