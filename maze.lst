 468  95F2              chkLeft:
 469  95F2                      checkLeftM player_px, player_py, move_delta
 469  95F2 2A 68 8F    >        ld hl, (player_px)                               ; get X pixel
 469  95F5 01 02 00    >        ld bc, move_delta                         ; move pixel delta
 469  95F8 B7          >        or a                                        ; clear carry
 469  95F9 ED 42       >        sbc hl, bc                                  ; simulate move left
 469  95FB             >        DIV_HL_8A                                   ; divide by 8 to get tile X
 469  95FB             >; version 2, 40 t-states (8 t-states quicker than DIV_HL_8)
 469  95FB             >; simple 16-bit divide without the CALL/RET overhead
 469  95FB 7D          >        ld a, l                                     ; get low byte into a ready for rotate from carry   4t
 469  95FC CB 3C       >        srl h                                       ;                                                   8t
 469  95FE 1F          >        rra                                         ;                                                   4t
 469  95FF CB 3C       >        srl h                                       ;                                                   8t
 469  9601 1F          >        rra                                         ;                                                   4t
 469  9602 CB 3C       >        srl h                                       ;                                                   8t
 469  9604 1F          >        rra                                         ;                                                   4t
 469  9605 47          >        ld b, a                                     ; B = tile X
 469  9606             >
 469  9606 2A 6A 8F    >        ld hl, (player_py)                               ; get Y pixel
 469  9609             >        DIV_HL_8A                                   ; divide by 8 to get tile Y
 469  9609             >; version 2, 40 t-states (8 t-states quicker than DIV_HL_8)
 469  9609             >; simple 16-bit divide without the CALL/RET overhead
 469  9609 7D          >        ld a, l                                     ; get low byte into a ready for rotate from carry   4t
 469  960A CB 3C       >        srl h                                       ;                                                   8t
 469  960C 1F          >        rra                                         ;                                                   4t
 469  960D CB 3C       >        srl h                                       ;                                                   8t
 469  960F 1F          >        rra                                         ;                                                   4t
 469  9610 CB 3C       >        srl h                                       ;                                                   8t
 469  9612 1F          >        rra                                         ;                                                   4t
 469  9613 4F          >        ld c, a                                     ; C = tile Y
 469  9614             >
 469  9614             >        GET_WORLD_VALUE TILEMAP_PAGE, USE_BC        ; see what tile is here
 469  9614             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 469  9614             >;
 469  9614             >;       arg  is TILEMAP_PAGE
 469  9614             >;            or DFIELD_PAGE
 469  9614             >;
 469  9614             >;       arg1 decides if input comes from BC or directly from HL
 469  9614             >;            NB if directly from HL then L = tile X, H = tile Y
 469  9614             >;
 469  9614             >        if USE_BC = 0
 469  9614 61          >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 469  9615             >                                                    ; put it in H (this is the same as multiplying by 256)
 469  9615 68          >        ld l, b                                     ; read the X tile coordinate into L
 469  9616             >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 469  9616             >                                                    ; This is the byte offset into "world" map.
 469  9616             >        endif
 469  9616             >
 469  9616             >    ; STEP 2: Calculate which 8K physical page the data lives in
 469  9616 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 469  9617             >;        srl  a                                      ; divide by 2
 469  9617             >;        srl  a                                      ; divide by 2 again  → now /4
 469  9617             >;        srl  a                                      ; /8
 469  9617             >;        srl  a                                      ; /16
 469  9617             >;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 469  9617             >; ------------------------------------------------------------------------
 469  9617             >; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
 469  9617             >; saves 21 t-state
 469  9617             >; ------------------------------------------------------------------------
 469  9617 07          >        rlca
 469  9618 07          >        rlca
 469  9619 07          >        rlca
 469  961A E6 07       >        and 7
 469  961C             >                                                    ; Why divide by 32?
 469  961C             >                                                    ;   Each page is 8192 bytes.
 469  961C             >                                                    ;   Each row is 256 bytes.
 469  961C             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 469  961C             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 469  961C             >
 469  961C C6 28       >        add  a, TILEMAP_PAGE                                 ; add the starting page number
 469  961E 32 5D 8F    >        ld (curWorldPage), a                        ; save page for subsequent reads - likely no need to reload
 469  9621 ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 469  9624             >
 469  9624             >
 469  9624             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 469  9624 7C          >        ld   a,h                                    ; get the high byte again
 469  9625 E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 469  9627             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 469  9627             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 469  9627 F6 C0       >        or $C0                                      ; "add" page offset
 469  9629 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 469  962A             >
 469  962A             >    ; STEP 4: read the byte
 469  962A             >                                                    ; HL now points directly at the first byte we want to copy
 469  962A 7E          >        ld a, (hl)                                  ; so get the byte
 469  962B FE 01       >        cp MAP_WALL                                 ; is it a wall?
 469  962D C8          >        ret z                                       ; return if so, do nothing
 469  962E             >
 469  962E             >; ----------------------------------------------------------------
 469  962E             >; worldBelow - read the map/field byte one tile-row below the byte
 469  962E             >; GET_WORLD_VALUE just fetched. HL still points at that byte.
 469  962E             >; Handles the (rare) 8K page cross. Returns tile in A.
 469  962E             >; ----------------------------------------------------------------
 469  962E             >.worldBelow:
 469  962E 24          >        inc  h                                      ; +256 bytes = one map row down
 469  962F 7C          >        ld   a, h                                   ; put in a for compare
 469  9630 FE E0       >        cp   $E0                                    ; walked past the end of slot 6 ($C000-$DFFF)?
 469  9632 20 0C       >        jr   nz, .same                              ; branch if not
 469  9634 26 C0       >        ld   h, $C0                                 ; wrap back to slot-6 base
 469  9636 3A 5D 8F    >        ld   a, (curWorldPage)                      ; get last saved page
 469  9639 3C          >        inc  a                                      ; advance it
 469  963A 32 5D 8F    >        ld   (curWorldPage), a                      ; save it back
 469  963D ED 92 56    >        nextreg $56, a                              ; page in new block
 469  9640             >.same:
 469  9640 7E          >        ld   a, (hl)                                ; see what tile is here
 469  9641 FE 01       >        cp MAP_WALL                                 ; is it a wall?
 469  9643 C8          >        ret z                                       ; return if so, do nothing
 469  9644             >
 469  9644 CB C3       >        set dir_left, e                             ; set bit in E indicating move is allowed
 469  9646 C9          >        ret
