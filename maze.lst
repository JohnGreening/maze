  93+ 866F              ; 8-Bit Binary to Decimal Digits Extraction
  94+ 866F              ; Input:  A  = 8-bit binary number (0 - 255)
  95+ 866F              ;         B  = char row (0..23), C = char col (0..31)
  96+ 866F              ; Calls displayChar with A to display each digit
  97+ 866F              Bin8ToDec:
  98+ 866F              ; --- Step 1: Extract 100s Digit ---
  99+ 866F 1E 2F                ld      e, '0' - 1                          ; Initialize ASCII counter
 100+ 8671              .Loop100:
 101+ 8671 1C                   inc     e                                   ; Increment ASCII character
 102+ 8672 D6 64                sub     100                                 ; Subtract 100
 103+ 8674 30 FB                jr      nc, .Loop100                        ; Repeat if no underflow (result >= 0)
 104+ 8676 C6 64                add     a, 100                              ; Restore the remainder (add 100 back)
 105+ 8678
 106+ 8678 57                   ld      d, a                                ; Temporarily save remainder in B
 107+ 8679 7B                   ld      a, e                                ; Get 100s digit
 108+ 867A CD 31 86             call displayChar
 109+ 867D 7A                   ld      a, d                                ; Restore remainder to A
 110+ 867E
 111+ 867E              ; --- Step 2: Extract 10s Digit ---
 112+ 867E 1E 2F                ld      e, '0' - 1                          ; Re-initialize ASCII counter
 113+ 8680              .Loop10:
 114+ 8680 1C                   inc     e                                   ; Increment ASCII character
 115+ 8681 D6 0A                sub     10                                  ; Subtract 10
 116+ 8683 30 FB                jr      nc, .Loop10                         ; Repeat if no underflow (result >= 0)
 117+ 8685 C6 0A                add     a, 10                               ; Restore the remainder (add 10 back)
 118+ 8687
 119+ 8687 57                   ld      d, a                                ; Temporarily save 1s digit in B
 120+ 8688 7B                   ld      a, e                                ; Get 10s digit
 121+ 8689 CD 31 86             call displayChar
 122+ 868C
 123+ 868C              ; --- Step 3: Extract 1s Digit ---
 124+ 868C 7A                   ld      a, d                                ; Restore 1s digit to A
 125+ 868D              DisplayDigit:
 126+ 868D                      ; if calling from here then BC must be set with B=row, C=Column
 127+ 868D C6 30                add     a, '0'                              ; Convert the leftover 1s digit to ASCII
 128+ 868F CD 31 86             call displayChar
 129+ 8692 C9                   ret
