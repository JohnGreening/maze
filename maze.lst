 578  97AC ED A0       >        LDI
 578  97AE ED A0       >        LDI
 578  97B0 ED A0       >        LDI
 578  97B2 ED A0       >        LDI
 578  97B4 ED A0       >        LDI
 578  97B6 ED A0       >        LDI
 578  97B8 ED A0       >        LDI
 578  97BA ED A0       >        LDI
 578  97BC ED A0       >        LDI
 578  97BE ED A0       >        LDI
 578  97C0 ED A0       >        LDI
 578  97C2 ED A0       >        LDI
 578  97C4 ED A0       >        LDI
 578  97C6 ED A0       >        LDI
 578  97C8 ED A0       >        LDI
 578  97CA ED A0       >        LDI
 578  97CC ED A0       >        LDI
 578  97CE ED A0       >        LDI
 578  97D0 ED A0       >        LDI
 578  97D2 ED A0       >        LDI
 578  97D4 ED A0       >        LDI
 578  97D6 ED A0       >        LDI
 578  97D8 ED A0       >        LDI
 578  97DA ED A0       >        LDI
 578  97DC ED A0       >        LDI
 578  97DE ED A0       >        LDI
 579  97E0              ENDR
 580  97E0                  ; STEP 7: Move the source pointer forward by exactly one full world-map row
 581  97E0 3E D8                ld   a,216                                  ; 256 (full row) minus 40 (what we already copied) = 216
 582  97E2 ED 31                add  hl,a                                   ; Z80N instruction — adds 8-bit number to HL very quickly
 583  97E4
 584  97E4 7C                   LD A, H
 585  97E5 FE E0                CP $E0
 586  97E7 CC F0 97             CALL Z, .cross_boundary
 587  97EA
 588  97EA 78                   ld a, b
 589  97EB B1                   or c
 590  97EC C2 90 97             jp nz, .row_loop
 591  97EF C9                   ret
 592  97F0
 593  97F0              .cross_boundary
 594  97F0                  ; STEP 8: Did we cross into the next 8K physical page?
 595  97F0 7C                   ld   a,h                                    ; look at the high byte of the source pointer
 596  97F1 D6 20                sub  $20                                    ; $20 is 32 in decimal. $E000 - $2000 = $C000 → subtract 32 from the high byte to wrap back to the start of slot 6
 597  97F3 67                   ld   h,a
 598  97F4 3A 6A 8F             ld a, (tilemapPage)
 599  97F7 3C                   inc a
 600  97F8 32 6A 8F             ld (tilemapPage), a
 601  97FB ED 92 56             nextreg $56, a                              ; set MMU slot 6 ($C000-$DFFF) to that page
 602  97FE C9                   ret
