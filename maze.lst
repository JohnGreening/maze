1050  9A08
1051  9A08 CB 43                bit dir_left, e
1052  9A0A 28 22                jr z, .noL
1053  9A0C 78                   ld a, b                                     ; get tile X
1054  9A0D 3D                   dec a                                       ; look left
1055  9A0E 6F                   ld l, a                                     ; save in L, L= tile X
1056  9A0F 61                   ld h, c                                     ; get tile Y
