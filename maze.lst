 276+ 825C                      ; qPopDE is only called from here
 277+ 825C                      ; it's effectively the driver for the processing for this tile
 278+ 825C CD 52 83             call qPopDE                                 ; DE = current cell (D=y, E=x)
 279+ 825F 43                   ld b, e                                     ; b = X    ** note opposite of DE
 280+ 8260 4A                   ld c, d                                     ; c = Y
