 663  97CF              showSprite:
 664  97CF              ; ============================================================
 665  97CF              ; Returns the floodfill distance for the player's tile in A.
 666  97CF              ; 255 = wall / unreached. Lower = closer to flood target.
 667  97CF              ; Trashes: AF, HL, BC
 668  97CF              ; ============================================================
 669  97CF 2A C6 8E             ld hl, (player_py)
 670  97D2                      DIV_HL_8                                    ; L = tileY (player_py / 8)
 670  97D2             >; simple 16-bit divide without the CALL/RET overhead
 670  97D2 CB 3C       >        srl h                                       ; divide by 2
 670  97D4 CB 1D       >        rr l
 670  97D6 CB 3C       >        srl h                                       ; divide by 4
 670  97D8 CB 1D       >        rr l
 670  97DA CB 3C       >        srl h                                       ; divide by 8
 670  97DC CB 1D       >        rr l
 671  97DE 7D                   ld a, l
 672  97DF 32 C9 8E             ld (player_tile_y), a
 673  97E2
 674  97E2 2A C4 8E             ld hl, (player_px)
 675  97E5                      DIV_HL_8                                    ; L = tileX (player_px / 8)
 675  97E5             >; simple 16-bit divide without the CALL/RET overhead
 675  97E5 CB 3C       >        srl h                                       ; divide by 2
 675  97E7 CB 1D       >        rr l
 675  97E9 CB 3C       >        srl h                                       ; divide by 4
 675  97EB CB 1D       >        rr l
 675  97ED CB 3C       >        srl h                                       ; divide by 8
 675  97EF CB 1D       >        rr l
 676  97F1 7D                   ld a, l
 677  97F2 32 C8 8E             ld (player_tile_x), a
 678  97F5
 679  97F5                      ; ... player_tile_x / player_tile_y just stored ...
 680  97F5 CD 4D 98             call checkKeyCollect
 681  97F8 30 03                jr nc, .noKey               ; carry clear -> nothing collected
 682  97FA                      ; A = collected key index -> handle it
 683  97FA CD 62 7E             call collectKey             ; mark collected, clear tiles, bump count, re-flood
 684  97FD              .noKey:
 685  97FD                      ; ... rest of showSprite ...
 686  97FD
 687  97FD 3A 6A 93             ld a, (viewMode)                            ; get the view mode, normal or radar
 688  9800 B7                   or a                                        ; see it it is 0 (normal)
 689  9801 C0                   ret nz                                      ; return if Radar (player sprite rendered in process baddie routine)
 690  9802
 691  9802
 692  9802 3E 00                LD A, 0                                     ; sprite index
 693  9804 ED 92 34             NEXTREG $34, A
 694  9807 2A C4 8E             ld hl, (player_px)
 695  980A ED 4B B3 8E          ld bc, (cam_px)
 696  980E ED 42                sbc hl, bc
 697  9810 5C                   ld e, h
 698  9811
 699  9811 7D                   LD A, l                                     ; set the low byte of player X
 700  9812 ED 92 35             NEXTREG $35, A
 701  9815
 702  9815 2A C6 8E             ld hl, (player_py)
 703  9818 ED 4B B5 8E          ld bc, (cam_py)
 704  981C ED 42                sbc hl, bc
 705  981E
 706  981E 7D                   LD A, l                                     ; set the low byte of player Y
 707  981F ED 92 36             NEXTREG $36, A
 708  9822 7B                   LD A, e                                     ; get the high byte of player X
 709  9823 E6 01                AND 1                                       ; we only need bit 0
 710  9825 ED 92 37             NEXTREG $37, A                              ; set it
 711  9828
 712  9828                      ; --- choose pattern from facing direction + animation frame ---
 713  9828 3A CA 8E             ld a, (lastMove)                            ; vdir flag: 1=L 2=R 4=D 8=U
 714  982B 06 04                ld b, PAT_DOWN                              ; default down
 715  982D FE 01                cp vdir_left
 716  982F 20 04                jr nz, .notL
 717  9831 06 0C                ld b, PAT_LEFT
 718  9833 18 0E                jr .haveBase
 719  9835              .notL:
 720  9835 FE 02                cp vdir_right
 721  9837 20 04                jr nz, .notR
 722  9839 06 08                ld b, PAT_RIGHT
 723  983B 18 06                jr .haveBase
 724  983D              .notR:
 725  983D FE 08                cp vdir_up
 726  983F 20 02                jr nz, .haveBase                            ; else stays PAT_DOWN
 727  9841 06 10                ld b, PAT_UP
 728  9843              .haveBase:
 729  9843 3A CB 8E             ld a, (playerAnimFrame)                     ; 0-3
 730  9846 80                   add a, b                                    ; base + frame = pattern
 731  9847
 732  9847 F6 80                OR %10000000                                ; bit 7 = visible
 733  9849 ED 92 38             NEXTREG $38, A
 734  984C C9                   RET
