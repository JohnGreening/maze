 540  96C3             >                                                    ; put it in H (this is the same as multiplying by 256)
 540  96C3 68          >        ld l, b                                     ; read the X tile coordinate into L
 540  96C4             >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 540  96C4             >                                                    ; This is the byte offset into "world" map.
 540  96C4             >        endif
 540  96C4             >
 540  96C4             >    ; STEP 2: Calculate which 8K physical page the data lives in
 540  96C4 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 540  96C5 CB 3F       >        srl  a                                      ; divide by 2
 540  96C7 CB 3F       >        srl  a                                      ; divide by 2 again  → now /4
 540  96C9 CB 3F       >        srl  a                                      ; /8
 540  96CB CB 3F       >        srl  a                                      ; /16
 540  96CD CB 3F       >        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 540  96CF             >                                                    ; Why divide by 32?
 540  96CF             >                                                    ;   Each page is 8192 bytes.
 540  96CF             >                                                    ;   Each row is 256 bytes.
 540  96CF             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 540  96CF             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
