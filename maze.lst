1079  9ADE             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
1079  9ADE             >;
1079  9ADE             >;       arg  is TILEMAP_PAGE
1079  9ADE             >;            or DFIELD_PAGE
1079  9ADE             >;
1079  9ADE             >;       arg1 decides if input comes from BC or directly from HL
1079  9ADE             >;            NB if directly from HL then L = tile X, H = tile Y
1079  9ADE             >;
