  78+ 86EB 06 08                ld b, 8                                     ; 8 lines to a char
  79+ 86ED              dcLine:
  80+ 86ED 1A                   ld a, (de)                                  ; get the bitmap row
  81+ 86EE 77                   ld (hl), a                                  ; put it onto ULA
  82+ 86EF 13                   inc de                                      ; next row
  83+ 86F0 24                   inc h                                       ; down one pixel line within the cell
