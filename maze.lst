 804  9909              .hit:
 805  9909                     ; collision routine
 806  9909 3E 04                ld A, soundHitskull                         ; ready the skull hit sound
 807  990B CD 93 8E             call playsound                              ; play it
 808  990E C3 E4 81             jp takeDamage                               ; update health bar.
 809  9911                                                                  ; the RET in takeDamage will return us to processBaddies
 810  9911
 811  9911
 812  9911              ; IX -> baddie record. Returns carry SET if player overlaps this baddie.
 813  9911              ; Trashes AF, DE, HL
 814  9911              checkBaddieCollision:
 815  9911                      ; --- X: |player_px - baddie_x| < COLLIDE_DX ? ---
 816  9911 2A 68 8F             ld hl, (player_px)
 817  9914 DD 5E 01             ld e, (ix + baddieRecord.lowX)
 818  9917 DD 56 02             ld d, (ix + baddieRecord.highX)
 819  991A B7                   or a
 820  991B ED 52                sbc hl, de                                  ; HL = player_px - baddie_x
 821  991D CB 7C                bit 7, h                                    ; negative?
 822  991F 28 07                jr z, .xAbs
 823  9921 EB                   ex de, hl
 824  9922 21 00 00             ld hl, 0
 825  9925 B7                   or a
 826  9926 ED 52                sbc hl, de                                  ; HL = |dx|
 827  9928              .xAbs:
 828  9928 11 0B 00             ld de, COLLIDE_DX
 829  992B B7                   or a
 830  992C ED 52                sbc hl, de
 831  992E D0                   ret nc                                      ; |dx| >= threshold -> no hit (carry clear)
 832  992F
 833  992F                      ; --- Y: |player_py - baddie_y| < COLLIDE_DY ? ---
 834  992F 2A 6A 8F             ld hl, (player_py)
 835  9932 DD 5E 03             ld e, (ix + baddieRecord.lowY)
 836  9935 DD 56 04             ld d, (ix + baddieRecord.highY)
 837  9938 B7                   or a
 838  9939 ED 52                sbc hl, de
 839  993B CB 7C                bit 7, h
 840  993D 28 07                jr z, .yAbs
 841  993F EB                   ex de, hl
 842  9940 21 00 00             ld hl, 0
 843  9943 B7                   or a
 844  9944 ED 52                sbc hl, de
 845  9946              .yAbs:
 846  9946 11 0B 00             ld de, COLLIDE_DY
 847  9949 B7                   or a
 848  994A ED 52                sbc hl, de
 849  994C C9                   ret                                         ; carry set if |dy| < threshold -> HIT
 850  994D
 851  994D
 852  994D
 853  994D              processBaddie:
 854  994D DD 66 04             ld h, (ix +baddieRecord.highY)              ; get baddie Y
 855  9950 DD 6E 03             ld l, (ix +baddieRecord.lowY)
 856  9953 22 0A 92             ld (baddie_y), hl
 857  9956 7D                   ld a, l
 858  9957 E6 07                and 7
 859  9959 FD 6F                ld iyl, a
 860  995B                      DIV_HL_8B                                   ; divide by 8 to get tile Y
 860  995B             >; version 3, 19 t-states (21 t-states quicker than A)
 860  995B             >; simple 16-bit divide without the CALL/RET overhead
 860  995B EB          >        EX DE, HL                                   ;                                                   4t
 860  995C 06 03       >        LD B, 3                                     ;                                                   7t
 860  995E ED 29       >        BSRA DE, B                                       ;                                                   8t
 861  9960 4B                   ld c, e                                     ; save in C, see newTile below
 862  9961
 863  9961 DD 66 02             ld h, (ix +baddieRecord.highX)              ; get baddie X
 864  9964 DD 6E 01             ld l, (ix +baddieRecord.lowX)
 865  9967 22 08 92             ld (baddie_x), hl
 866  996A 7D                   ld a, l
 867  996B E6 07                and 7
 868  996D FD 67                ld iyh, a
 869  996F                      DIV_HL_8B                                   ; div by 8 to get tile Y
 869  996F             >; version 3, 19 t-states (21 t-states quicker than A)
 869  996F             >; simple 16-bit divide without the CALL/RET overhead
 869  996F EB          >        EX DE, HL                                   ;                                                   4t
 869  9970 06 03       >        LD B, 3                                     ;                                                   7t
 869  9972 ED 29       >        BSRA DE, B                                       ;                                                   8t
 870  9974 43                   ld b, e                                     ; save in B, see newTile below
 871  9975
 872  9975              ; Decide only when grid-aligned (iyh==0 AND iyl==0) - the only
 873  9975                      ; moment a turn is possible. "Tile changed" fired at the far tile
 874  9975                      ; edge when moving up/left, where the turn check is gated out.
 875  9975 FD 7C                ld a, iyh
 876  9977 FD B5                or iyl                                      ; both zero => on grid intersection
 877  9979 28 06                jr z, newTile                               ; aligned -> run the decision
 878  997B
 879  997B DD 7E 07             ld a, (ix +baddieRecord.dir)                ; not aligned -> continue current dir
 880  997E C3 F3 99             jp gotDir                                   ; jump to do the move
 881  9981
 882  9981              newTile:
 883  9981 DD 70 05             ld (ix +baddieRecord.tileX), b              ; save the tile X
 884  9984 DD 71 06             ld (ix +baddieRecord.tileY), c              ; save the tile Y
 885  9987
 886  9987                      ; get reverse direction
 887  9987 DD 7E 07             ld a, (ix + baddieRecord.dir)               ; Load current direction
 888  998A 47                   ld b, a                                     ; Backup original direction to B
 889  998B E6 03                and %00000011                               ; Check for Left (1) / Right (2)
 890  998D 28 05                jr z, .vertMask                             ; If 0, it must be vertical (Up/Down)
 891  998F
 892  998F                      ; Horizontal Path: Swap 1 <-> 2
 893  998F                      ; 'A' already contains ONLY the horizontal bits here
 894  998F EE 03                xor %00000011                               ; 1 becomes 2, 2 becomes 1
 895  9991 47                   ld b, a                                     ; Store final result in B
 896  9992 18 04                jr .done
 897  9994
 898  9994              .vertMask:
 899  9994                      ; Vertical Path: Swap 4 <-> 8
 900  9994                      ; Because 'A' was 0, 'B' still holds the unaltered original vertical value
 901  9994 78                   ld a, b                                     ; Bring original back to A to process
 902  9995 EE 0C                xor %00001100                               ; 4 becomes 8, 8 becomes 4
 903  9997 47                   ld b, a                                     ; Store final result in B
 904  9998
 905  9998              .done:
 906  9998                      ; d holds current direction (bitmask)
 907  9998 C5                   push bc                                     ; save reverse on stack for use later
 908  9999 3E 0F                ld a, %00001111                             ; start with all directions
 909  999B A8                   xor b                                       ; mask out reverse
 910  999C
 911  999C              ; -----------------------------------------------
 912  999C              ; Test each direction to see if a move is allowed
 913  999C              ; -----------------------------------------------
 914  999C 57                   ld d, a                                     ; D = directions to test (all except reverse)
 915  999D 1E 00                ld e, 0                                     ; E = available directions found
 916  999F
 917  999F CB 42                bit dir_left, d
 918  99A1 C4 BD 9A             call nz, chkLeft1
 919  99A4
 920  99A4 CB 4A                bit dir_right, d
 921  99A6 C4 16 9B             call nz, chkRight1
 922  99A9
 923  99A9 CB 52                bit dir_down, d
 924  99AB C4 71 9B             call nz, chkDown1
 925  99AE
 926  99AE CB 5A                bit dir_up, d
 927  99B0 C4 BB 9B             call nz, chkUp1
 928  99B3
 929  99B3              ;-----------------------
 930  99B3              ; pick direction to take
 931  99B3              ; ----------------------
 932  99B3 C1                   pop bc                                      ; retrieve the saved reverse direction
 933  99B4 7B                   ld a, e                                     ; get what moves were possible
 934  99B5 A7                   and a                                       ; are there any?
 935  99B6 28 3C                jr z, reverse
 936  99B8
 937  99B8              moveAvailable:
 938  99B8                      ; E = available-direction mask. Choose pick method by mode.
 939  99B8                      ; Read own-cell distance first (one field read) -> sets lastDist.
 940  99B8 DD 46 05             ld b, (ix + baddieRecord.tileX)             ; B = tileX
 941  99BB DD 4E 06             ld c, (ix + baddieRecord.tileY)             ; C = tileY
 942  99BE                      GET_WORLD_VALUE DFIELD_PAGE, USE_BC
 942  99BE             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 942  99BE             >;
 942  99BE             >;       arg  is TILEMAP_PAGE
 942  99BE             >;            or DFIELD_PAGE
 942  99BE             >;
 942  99BE             >;       arg1 decides if input comes from BC or directly from HL
 942  99BE             >;            NB if directly from HL then L = tile X, H = tile Y
 942  99BE             >;
 942  99BE             >        if USE_BC = 0
 942  99BE 61          >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 942  99BF             >                                                    ; put it in H (this is the same as multiplying by 256)
 942  99BF 68          >        ld l, b                                     ; read the X tile coordinate into L
 942  99C0             >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 942  99C0             >                                                    ; This is the byte offset into "world" map.
 942  99C0             >        endif
 942  99C0             >
 942  99C0             >    ; STEP 2: Calculate which 8K physical page the data lives in
 942  99C0 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 942  99C1             >;        srl  a                                      ; divide by 2
 942  99C1             >;        srl  a                                      ; divide by 2 again  → now /4
 942  99C1             >;        srl  a                                      ; /8
 942  99C1             >;        srl  a                                      ; /16
 942  99C1             >;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 942  99C1             >; ------------------------------------------------------------------------
 942  99C1             >; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
 942  99C1             >; saves 21 t-state
 942  99C1             >; ------------------------------------------------------------------------
 942  99C1 07          >        rlca
 942  99C2 07          >        rlca
 942  99C3 07          >        rlca
 942  99C4 E6 07       >        and 7
 942  99C6             >                                                    ; Why divide by 32?
 942  99C6             >                                                    ;   Each page is 8192 bytes.
 942  99C6             >                                                    ;   Each row is 256 bytes.
 942  99C6             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 942  99C6             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 942  99C6             >
 942  99C6 C6 2E       >        add  a, DFIELD_PAGE                                 ; add the starting page number
 942  99C8 32 5D 8F    >        ld (curWorldPage), a                        ; save page for subsequent reads - likely no need to reload
 942  99CB ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 942  99CE             >
 942  99CE             >
 942  99CE             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 942  99CE 7C          >        ld   a,h                                    ; get the high byte again
 942  99CF E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 942  99D1             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 942  99D1             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 942  99D1 F6 C0       >        or $C0                                      ; "add" page offset
 942  99D3 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 942  99D4             >
 942  99D4             >    ; STEP 4: read the byte
 942  99D4             >                                                    ; HL now points directly at the first byte we want to copy
 942  99D4 7E          >        ld a, (hl)                                  ; so get the byte
