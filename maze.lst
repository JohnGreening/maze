 154+ 7F00                      GET_WORLD_VALUE TILEMAP_PAGE, USE_BC        ; (tx, ty)
 154+ 7F00             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 154+ 7F00             >;
 154+ 7F00             >;       arg  is TILEMAP_PAGE
 154+ 7F00             >;            or DFIELD_PAGE
 154+ 7F00             >;
 154+ 7F00             >;       arg1 decides if input comes from BC or directly from HL
 154+ 7F00             >;            NB if directly from HL then L = tile X, H = tile Y
 154+ 7F00             >;
 154+ 7F00             >        if USE_BC = 0
 154+ 7F00 61          >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 154+ 7F01             >                                                    ; put it in H (this is the same as multiplying by 256)
 154+ 7F01 68          >        ld l, b                                     ; read the X tile coordinate into L
 154+ 7F02             >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 154+ 7F02             >                                                    ; This is the byte offset into "world" map.
 154+ 7F02             >        endif
 154+ 7F02             >
 154+ 7F02             >    ; STEP 2: Calculate which 8K physical page the data lives in
 154+ 7F02 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 154+ 7F03 CB 3F       >        srl  a                                      ; divide by 2
 154+ 7F05 CB 3F       >        srl  a                                      ; divide by 2 again  → now /4
 154+ 7F07 CB 3F       >        srl  a                                      ; /8
 154+ 7F09 CB 3F       >        srl  a                                      ; /16
 154+ 7F0B CB 3F       >        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 154+ 7F0D             >                                                    ; Why divide by 32?
 154+ 7F0D             >                                                    ;   Each page is 8192 bytes.
 154+ 7F0D             >                                                    ;   Each row is 256 bytes.
 154+ 7F0D             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 154+ 7F0D             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 154+ 7F0D             >
