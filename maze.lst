 614  970E              showSprite:
 615  970E              ; ============================================================
 616  970E              ; Returns the floodfill distance for the player's tile in A.
 617  970E              ; 255 = wall / unreached. Lower = closer to flood target.
 618  970E              ; Trashes: AF, HL, BC
 619  970E              ; ============================================================
 620  970E 2A DE 8E             ld hl, (player_py)
 621  9711                      DIV_HL_8A                                    ; A = tileY (player_py / 8)
 621  9711             >; version 2, 40 t-states (8 t-states quicker than DIV_HL_8)
 621  9711             >; simple 16-bit divide without the CALL/RET overhead
 621  9711 7D          >        ld a, l                                     ; get low byte into a ready for rotate from carry   4t
 621  9712 CB 3C       >        srl h                                       ;                                                   8t
 621  9714 1F          >        rra                                         ;                                                   4t
 621  9715 CB 3C       >        srl h                                       ;                                                   8t
 621  9717 1F          >        rra                                         ;                                                   4t
 621  9718 CB 3C       >        srl h                                       ;                                                   8t
 621  971A 1F          >        rra                                         ;                                                   4t
 622  971B 32 E1 8E             ld (player_tile_y), a
 623  971E
 624  971E 2A DC 8E             ld hl, (player_px)
 625  9721                      DIV_HL_8A                                    ; A = tileX (player_px / 8)
 625  9721             >; version 2, 40 t-states (8 t-states quicker than DIV_HL_8)
 625  9721             >; simple 16-bit divide without the CALL/RET overhead
 625  9721 7D          >        ld a, l                                     ; get low byte into a ready for rotate from carry   4t
 625  9722 CB 3C       >        srl h                                       ;                                                   8t
 625  9724 1F          >        rra                                         ;                                                   4t
 625  9725 CB 3C       >        srl h                                       ;                                                   8t
 625  9727 1F          >        rra                                         ;                                                   4t
 625  9728 CB 3C       >        srl h                                       ;                                                   8t
 625  972A 1F          >        rra                                         ;                                                   4t
 626  972B 32 E0 8E             ld (player_tile_x), a
