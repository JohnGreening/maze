 937  99AA              moveAvailable:
 938  99AA                      ; E = available-direction mask. Choose pick method by mode.
 939  99AA                      ; Read own-cell distance first (one field read) -> sets lastDist.
 940  99AA DD 46 05             ld b, (ix + baddieRecord.tileX)             ; B = tileX
 941  99AD DD 4E 06             ld c, (ix + baddieRecord.tileY)             ; C = tileY
 942  99B0                      GET_WORLD_VALUE DFIELD_PAGE, USE_BC
 942  99B0             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 942  99B0             >;
 942  99B0             >;       arg  is TILEMAP_PAGE
 942  99B0             >;            or DFIELD_PAGE
 942  99B0             >;
 942  99B0             >;       arg1 decides if input comes from BC or directly from HL
 942  99B0             >;            NB if directly from HL then L = tile X, H = tile Y
 942  99B0             >;
 942  99B0             >        if USE_BC = 0
 942  99B0 61          >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 942  99B1             >                                                    ; put it in H (this is the same as multiplying by 256)
 942  99B1 68          >        ld l, b                                     ; read the X tile coordinate into L
 942  99B2             >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 942  99B2             >                                                    ; This is the byte offset into "world" map.
 942  99B2             >        endif
 942  99B2             >
 942  99B2             >    ; STEP 2: Calculate which 8K physical page the data lives in
 942  99B2 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 942  99B3             >;        srl  a                                      ; divide by 2
 942  99B3             >;        srl  a                                      ; divide by 2 again  → now /4
 942  99B3             >;        srl  a                                      ; /8
 942  99B3             >;        srl  a                                      ; /16
 942  99B3             >;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 942  99B3             >; ------------------------------------------------------------------------
 942  99B3             >; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
 942  99B3             >; saves 21 t-state
 942  99B3             >; ------------------------------------------------------------------------
 942  99B3 07          >        rlca
 942  99B4 07          >        rlca
 942  99B5 07          >        rlca
 942  99B6 E6 07       >        and 7
 942  99B8             >                                                    ; Why divide by 32?
 942  99B8             >                                                    ;   Each page is 8192 bytes.
 942  99B8             >                                                    ;   Each row is 256 bytes.
 942  99B8             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 942  99B8             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 942  99B8             >
 942  99B8 C6 2E       >        add  a, DFIELD_PAGE                                 ; add the starting page number
 942  99BA 32 6B 8F    >        ld (curWorldPage), a                        ; save page for subsequent reads - likely no need to reload
 942  99BD ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 942  99C0             >
 942  99C0             >
 942  99C0             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 942  99C0 7C          >        ld   a,h                                    ; get the high byte again
 942  99C1 E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 942  99C3             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 942  99C3             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 942  99C3 F6 C0       >        or $C0                                      ; "add" page offset
 942  99C5 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 942  99C6             >
 942  99C6             >    ; STEP 4: read the byte
 942  99C6             >                                                    ; HL now points directly at the first byte we want to copy
 942  99C6 7E          >        ld a, (hl)                                  ; so get the byte
