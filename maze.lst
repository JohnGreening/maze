 177+ 879F ~           >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 177+ 879F ~           >                                                    ; This is the byte offset into "world" map.
 177+ 879F             >        endif
 177+ 879F             >
 177+ 879F             >    ; STEP 2: Calculate which 8K physical page the data lives in
 177+ 879F 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 177+ 87A0             >;        srl  a                                      ; divide by 2
 177+ 87A0             >;        srl  a                                      ; divide by 2 again  → now /4
 177+ 87A0             >;        srl  a                                      ; /8
 177+ 87A0             >;        srl  a                                      ; /16
 177+ 87A0             >;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 177+ 87A0             >; ------------------------------------------------------------------------
 177+ 87A0             >; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
 177+ 87A0             >; saves 21 t-state
 177+ 87A0             >; ------------------------------------------------------------------------
 177+ 87A0 07          >        rlca
 177+ 87A1 07          >        rlca
 177+ 87A2 07          >        rlca
 177+ 87A3 E6 07       >        and 7
 177+ 87A5             >                                                    ; Why divide by 32?
 177+ 87A5             >                                                    ;   Each page is 8192 bytes.
 177+ 87A5             >                                                    ;   Each row is 256 bytes.
 177+ 87A5             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 177+ 87A5             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 177+ 87A5             >
 177+ 87A5 C6 2E       >        add  a, DFIELD_PAGE                                 ; add the starting page number
 177+ 87A7 32 5D 8F    >        ld (curWorldPage), a                        ; save page for subsequent reads - likely no need to reload
 177+ 87AA ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 177+ 87AD             >
 177+ 87AD             >
 177+ 87AD             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 177+ 87AD 7C          >        ld   a,h                                    ; get the high byte again
 177+ 87AE E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 177+ 87B0             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 177+ 87B0             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 177+ 87B0 F6 C0       >        or $C0                                      ; "add" page offset
 177+ 87B2 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 177+ 87B3             >
 177+ 87B3             >    ; STEP 4: read the byte
 177+ 87B3             >                                                    ; HL now points directly at the first byte we want to copy
 177+ 87B3 7E          >        ld a, (hl)                                  ; so get the byte
 178+ 87B4 CD FB 86             call Bin8ToDec
 179+ 87B7 E1                   pop hl
 180+ 87B8 C9                   ret
