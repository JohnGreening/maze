1418  0000              org $C000
1419  C000 00 00 00...  DEFS 16384
1420  0000
1421  0000              ; ----------------------------------------------------------------
1422  0000              ; Build the .nex file (automatically includes all used banks)
1423  0000              ; ----------------------------------------------------------------
1424  0000              SAVENEX OPEN "maze.nex", progStart, $FF40           ; entry point + stack
1425  0000              SAVENEX AUTO                                        ; include all pages we used
1426  0000              SAVENEX CLOSE
