 521  9767              copy_visible_window:
 522  9767 78                   ld a, b                                     ; get current player tile X
 523  9768 32 FE 8F             ld (cam_tx), a                              ; save it away
 524  976B 79                   ld a, c                                     ; get current player tile Y
 525  976C 32 FF 8F             ld (cam_ty), a                              ; save it away
 526  976F
 527  976F                  ; STEP 1: Build the starting linear offset in the world map
 528  976F 61                   ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 529  9770                                                                  ; put it in H (this is the same as multiplying cam_tile_y by 256)
 530  9770 68                   ld l, b                                     ; read the X tile coordinate into L
 531  9771                                                                  ; Result: HL now holds  cam_tile_y * 256 + cam_tile_x
 532  9771                                                                  ; This is the byte offset into "world" map.
 533  9771
 534  9771                  ; STEP 2: Calculate which 8K physical page the data lives in
 535  9771 7C                   ld   a, h                                   ; take the high byte of the offset (which is cam_tile_y)
 536  9772              ;        srl  a                                      ; divide by 2
 537  9772              ;        srl  a                                      ; divide by 2 again  → now /4
 538  9772              ;        srl  a                                      ; /8
 539  9772              ;        srl  a                                      ; /16
 540  9772              ;        srl  a                                      ; /32   ← this is the same as cam_tile_y ÷ 32
 541  9772              ; ------------------------------------------------------------------------
 542  9772              ; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
 543  9772              ; saves 21 t-state
 544  9772              ; ------------------------------------------------------------------------
 545  9772 07                   rlca
 546  9773 07                   rlca
 547  9774 07                   rlca
 548  9775 E6 07                and 7
 549  9777                                                                  ; Why divide by 32?
 550  9777                                                                  ;   Each page is 8192 bytes.
 551  9777                                                                  ;   Each row is 256 bytes.
 552  9777                                                                  ;   8192 ÷ 256 = exactly 32 rows per page.
 553  9777                                                                  ;   Therefore page number = 40 + (cam_tile_y ÷ 32)
 554  9777 C6 28                add  a,40                                   ; add the starting page number (your world map begins at page 40)
 555  9779 32 00 90             ld   (tilemapPage), a                       ; save the page number in register C for later
 556  977C
 557  977C                  ; STEP 3: Keep only the part of the address that fits inside one 8K page
 558  977C 7C                   ld   a,h                                    ; get the high byte again
 559  977D E6 1F                and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 560  977F                                                                  ; This is exactly the same as (cam_tile_y * 256 + cam_tile_x) modulo 8192
 561  977F                                                                  ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 562  977F 67                   ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 563  9780
 564  9780                  ; STEP 4: Page the correct 8K bank into slot 6 so we can read it
 565  9780 3A 00 90             ld   a, (tilemapPage)                       ; A = page number we want
 566  9783 ED 92 56             nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 567  9786 01 00 C0             ld   bc,$C000                               ; $C000 is the start of slot 6
 568  9789 09                   add  hl,bc                                  ; HL = $C000 + offset_inside_page
 569  978A                                                                  ; HL now points directly at the first byte we want to copy
 570  978A
 571  978A                  ; STEP 5: Point DE at the hardware tilemap buffer (fixed location)
 572  978A 11 00 60             ld   de, tileMap                            ; destination is the hardware tilemap location
 573  978D
 574  978D                  ; STEP 6: Copy all 32 visible rows
 575  978D 01 00 05             ld   bc,40*32                               ; we need to copy 32 rows x 40 columns
 576  9790              .row_loop:
 577  9790              REPT 40
 578  9790 ED A0       >        LDI
 578  9792 ED A0       >        LDI
 578  9794 ED A0       >        LDI
 578  9796 ED A0       >        LDI
 578  9798 ED A0       >        LDI
 578  979A ED A0       >        LDI
 578  979C ED A0       >        LDI
 578  979E ED A0       >        LDI
 578  97A0 ED A0       >        LDI
 578  97A2 ED A0       >        LDI
 578  97A4 ED A0       >        LDI
 578  97A6 ED A0       >        LDI
 578  97A8 ED A0       >        LDI
 578  97AA ED A0       >        LDI
 578  97AC ED A0       >        LDI
 578  97AE ED A0       >        LDI
 578  97B0 ED A0       >        LDI
 578  97B2 ED A0       >        LDI
 578  97B4 ED A0       >        LDI
 578  97B6 ED A0       >        LDI
 578  97B8 ED A0       >        LDI
 578  97BA ED A0       >        LDI
 578  97BC ED A0       >        LDI
 578  97BE ED A0       >        LDI
 578  97C0 ED A0       >        LDI
 578  97C2 ED A0       >        LDI
 578  97C4 ED A0       >        LDI
 578  97C6 ED A0       >        LDI
 578  97C8 ED A0       >        LDI
 578  97CA ED A0       >        LDI
 578  97CC ED A0       >        LDI
 578  97CE ED A0       >        LDI
 578  97D0 ED A0       >        LDI
 578  97D2 ED A0       >        LDI
 578  97D4 ED A0       >        LDI
 578  97D6 ED A0       >        LDI
 578  97D8 ED A0       >        LDI
 578  97DA ED A0       >        LDI
 578  97DC ED A0       >        LDI
 578  97DE ED A0       >        LDI
 579  97E0              ENDR
 580  97E0                  ; STEP 7: Move the source pointer forward by exactly one full world-map row
 581  97E0 3E D8                ld   a,216                                  ; 256 (full row) minus 40 (what we already copied) = 216
 582  97E2 ED 31                add  hl,a                                   ; Z80N instruction — adds 8-bit number to HL very quickly
 583  97E4
 584  97E4 7C                   LD A, H
 585  97E5 FE E0                CP $E0
 586  97E7 CC F0 97             CALL Z, .cross_boundary
 587  97EA
 588  97EA 78                   ld a, b
 589  97EB B1                   or c
 590  97EC C2 90 97             jp nz, .row_loop
 591  97EF C9                   ret
 592  97F0
 593  97F0              .cross_boundary
 594  97F0                  ; STEP 8: Did we cross into the next 8K physical page?
 595  97F0 7C                   ld   a,h                                    ; look at the high byte of the source pointer
 596  97F1 D6 20                sub  $20                                    ; $20 is 32 in decimal. $E000 - $2000 = $C000 → subtract 32 from the high byte to wrap back to the start of slot 6
 597  97F3 67                   ld   h,a
 598  97F4 3A 00 90             ld a, (tilemapPage)
 599  97F7 3C                   inc a
 600  97F8 32 00 90             ld (tilemapPage), a
 601  97FB ED 92 56             nextreg $56, a                              ; set MMU slot 6 ($C000-$DFFF) to that page
 602  97FE C9                   ret
 603  97FF
 604  97FF              wait_vblank:
 605  97FF 01 3B 24             ld bc, $243B                                ; register select port
 606  9802 3E 1E                ld a, $1E
 607  9804 ED 79                out (c), a                                  ; select ULA status register
 608  9806 04                   inc b                                       ; now point to data port $253B
 609  9807              .loop
 610  9807 ED 78                in a, (c)                                   ; read status
 611  9809 CB 47                bit 0, a
 612  980B 28 FA                jr z, .loop
 613  980D C9                   ret
 614  980E
 615  980E
 616  980E              showSprite:
 617  980E              ; ============================================================
 618  980E              ; Returns the floodfill distance for the player's tile in A.
 619  980E              ; 255 = wall / unreached. Lower = closer to flood target.
 620  980E              ; Trashes: AF, HL, BC
 621  980E              ; ============================================================
 622  980E 2A 0E 90             ld hl, (player_py)
 623  9811 7D                   ld a, l
 624  9812 E6 07                and 7
 625  9814 FD 6F                ld iyl, a
 626  9816                      DIV_HL_8B                                    ; A = tileY (player_py / 8)
 626  9816             >; version 3, 19 t-states (21 t-states quicker than A)
 626  9816             >; simple 16-bit divide without the CALL/RET overhead
 626  9816 EB          >        EX DE, HL                                   ;                                                   4t
 626  9817 06 03       >        LD B, 3                                     ;                                                   7t
 626  9819 ED 29       >        BSRA DE, B                                  ;                                                   8t
 627  981B 7B                   ld a, e
 628  981C 32 11 90             ld (player_tile_y), a
 629  981F
 630  981F 2A 0C 90             ld hl, (player_px)
 631  9822 7D                   ld a, l
 632  9823 E6 07                and 7
 633  9825 FD 6F                ld iyl, a
 634  9827                      DIV_HL_8B                                    ; A = tileX (player_px / 8)
 634  9827             >; version 3, 19 t-states (21 t-states quicker than A)
 634  9827             >; simple 16-bit divide without the CALL/RET overhead
 634  9827 EB          >        EX DE, HL                                   ;                                                   4t
 634  9828 06 03       >        LD B, 3                                     ;                                                   7t
 634  982A ED 29       >        BSRA DE, B                                  ;                                                   8t
 635  982C 7B                   ld a, e
 636  982D 32 10 90             ld (player_tile_x), a
 637  9830
 638  9830
 639  9830 FD 7D                ld a, iyl
 640  9832 DD A4                and ixh
 641  9834
 642  9834 CC 66 84             call z, stampTrail
 643  9837
 644  9837                      ; ... player_tile_x / player_tile_y just stored ...
 645  9837 CD 8E 98             call checkKeyCollect
 646  983A 30 03                jr nc, .noKey               ; carry clear -> nothing collected
 647  983C                      ; A = collected key index -> handle it
 648  983C CD 62 7E             call collectKey             ; mark collected, clear tiles, bump count, re-flood
 649  983F              .noKey:
 650  983F                      ; ... rest of showSprite ...
 651  983F
 652  983F 3A 05 94             ld a, (viewMode)                            ; get the view mode, normal or radar
 653  9842 B7                   or a                                        ; see it it is 0 (normal)
 654  9843 C0                   ret nz                                      ; return if Radar (player sprite rendered in process baddie routine)
 655  9844
 656  9844
 657  9844 AF                   xor a                                       ; sprite index = 0
 658  9845 ED 92 34             NEXTREG $34, A
 659  9848 2A 0C 90             ld hl, (player_px)
 660  984B ED 4B FA 8F          ld bc, (cam_px)
 661  984F ED 42                sbc hl, bc
 662  9851 5C                   ld e, h
 663  9852
 664  9852 7D                   LD A, l                                     ; set the low byte of player X
 665  9853 ED 92 35             NEXTREG $35, A
 666  9856
 667  9856 2A 0E 90             ld hl, (player_py)
 668  9859 ED 4B FC 8F          ld bc, (cam_py)
 669  985D ED 42                sbc hl, bc
 670  985F
 671  985F 7D                   LD A, l                                     ; set the low byte of player Y
 672  9860 ED 92 36             NEXTREG $36, A
 673  9863 7B                   LD A, e                                     ; get the high byte of player X
 674  9864 E6 01                AND 1                                       ; we only need bit 0
 675  9866 ED 92 37             NEXTREG $37, A                              ; set it
 676  9869
 677  9869                      ; --- choose pattern from facing direction + animation frame ---
 678  9869 3A 15 90             ld a, (lastMove)                            ; vdir flag: 1=L 2=R 4=D 8=U
 679  986C 06 04                ld b, PAT_DOWN                              ; default down
 680  986E FE 01                cp vdir_left
 681  9870 20 04                jr nz, .notL
 682  9872 06 0C                ld b, PAT_LEFT
 683  9874 18 0E                jr .haveBase
 684  9876              .notL:
 685  9876 FE 02                cp vdir_right
 686  9878 20 04                jr nz, .notR
 687  987A 06 08                ld b, PAT_RIGHT
 688  987C 18 06                jr .haveBase
 689  987E              .notR:
 690  987E FE 08                cp vdir_up
 691  9880 20 02                jr nz, .haveBase                            ; else stays PAT_DOWN
 692  9882 06 10                ld b, PAT_UP
 693  9884              .haveBase:
 694  9884 3A 16 90             ld a, (playerAnimFrame)                     ; 0-3
 695  9887 80                   add a, b                                    ; base + frame = pattern
 696  9888
 697  9888 F6 80                OR %10000000                                ; bit 7 = visible
 698  988A ED 92 38             NEXTREG $38, A
 699  988D C9                   RET
 700  988E
 701  988E              ; ============================================================
 702  988E              ; checkKeyCollect
 703  988E              ; Tests whether the player's 2x2 footprint overlaps any
 704  988E              ; AVAILABLE key's 2x2 block.
 705  988E              ; Returns: A = key index (0..KEY_COUNT-1) and carry SET if a
 706  988E              ;          key was collected; carry CLEAR (A undefined) if none.
 707  988E              ; Uses player_tile_x / player_tile_y (must be current).
 708  988E              ; Trashes: AF, BC, DE, HL
 709  988E              ; ============================================================
 710  988E              checkKeyCollect:
 711  988E 21 3D 7E             ld hl, KEY_DATA
 712  9891 06 00                ld b, 0                                     ; B = key index
 713  9893              .loop:
 714  9893 7E                   ld a, (hl)                                  ; key tileX
 715  9894 23                   inc hl
 716  9895 4E                   ld c, (hl)                                  ; key tileY
 717  9896 23                   inc hl
 718  9897 5E                   ld e, (hl)                                  ; status
 719  9898 23                   inc hl                                      ; HL -> next key record
 720  9899
 721  9899                      ; skip keys that aren't available
 722  9899 57                   ld d, a                                     ; save key tileX in D (A about to be reused)
 723  989A 7B                   ld a, e
 724  989B FE 01                cp KEY_AVAILABLE
 725  989D 20 1B                jr nz, .next                                ; not available -> skip
 726  989F
 727  989F                      ; --- X overlap: abs(player_tile_x - keyX) <= 1 ? ---
 728  989F 3A 10 90             ld a, (player_tile_x)
 729  98A2 92                   sub d                                       ; A = px - kx
 730  98A3 30 02                jr nc, .xpos
 731  98A5 ED 44                neg                                         ; A = |px - kx|
 732  98A7              .xpos:
 733  98A7 FE 02                cp 2
 734  98A9 30 0F                jr nc, .next                                ; |dx| >= 2 -> no overlap
 735  98AB
 736  98AB                      ; --- Y overlap: abs(player_tile_y - keyY) <= 1 ? ---
 737  98AB 3A 11 90             ld a, (player_tile_y)
 738  98AE 91                   sub c                                       ; A = py - ky
 739  98AF 30 02                jr nc, .ypos
 740  98B1 ED 44                neg
 741  98B3              .ypos:
 742  98B3 FE 02                cp 2
 743  98B5 30 03                jr nc, .next                                ; |dy| >= 2 -> no overlap
 744  98B7
 745  98B7                      ; overlap on both axes -> collected this key
 746  98B7 78                   ld a, b                                     ; A = key index
 747  98B8 37                   scf                                         ; carry set = collected
 748  98B9 C9                   ret
 749  98BA
 750  98BA              .next:
 751  98BA 04                   inc b
 752  98BB 78                   ld a, b
 753  98BC FE 04                cp KEY_COUNT
 754  98BE 20 D3                jr nz, .loop
 755  98C0 B7                   or a                            ; clear carry = nothing collected
 756  98C1 C9                   ret
 757  98C2
 758  98C2
 759  98C2              ; point to end of skull data. We will use this to test if finished processing all the skulls
 760  98C2              ; saves having a register holding the processed count
 761  98C2              baddieEnd equ baddieData + (baddieRecord * baddieCount)
 762  98C2
 763  98C2              processBaddies:
 764  98C2 DD 21 18 90          ld ix, baddieData                           ; point to start of baddie data
 765  98C6
 766  98C6              .loop:
 767  98C6 CD 45 99             call processBaddie                          ; process each baddie in turn
 768  98C9 CD 17 99             call checkBaddieCollision                   ; check collision
 769  98CC DC 0F 99             call c, .hit
 770  98CF
 771  98CF 11 0B 00             ld de, baddieRecord                         ; get baddie record length
 772  98D2 DD 19                add ix, de                                  ; point ix to next baddie
 773  98D4 DD 7D                ld a, ixl
 774  98D6 FE AC                cp low baddieEnd
 775  98D8 20 EC                jr nz, .loop
 776  98DA DD 7C                ld a, ixh
 777  98DC FE 92                cp high baddieEnd
 778  98DE 20 E6                jr nz, .loop
 779  98E0
 780  98E0 3A 05 94             ld a, (viewMode)                            ; get view mode
 781  98E3 B7                   or a                                        ; is it 0 (normal map view)
 782  98E4 C8                   ret z                                       ; return if normal
 783  98E5
 784  98E5                      ; -------------------------------------------------------
 785  98E5                      ; here we just display the player if we are in Radar mode
 786  98E5                      ; -------------------------------------------------------
 787  98E5
 788  98E5                      ; tile x/y already calculated, just use them
 789  98E5 3A 10 90             ld a, (player_tile_x)
 790  98E8 6F                   ld l, a
 791  98E9 26 00                ld h, 0
 792  98EB ED 34 20 00          add hl, 32
 793  98EF
 794  98EF 3A 11 90             ld a, (player_tile_y)
 795  98F2 C6 20                add 32
 796  98F4 5F                   ld e, a
 797  98F5
 798  98F5 AF                   xor a
 799  98F6 ED 92 34             NEXTREG $34, a                              ; select sprite slot 0 (player)
 800  98F9 7D                   ld a, l
 801  98FA ED 92 35             NEXTREG $35, a                              ; attr 0: X low 8 bits
 802  98FD 7B                   ld a, e
 803  98FE ED 92 36             NEXTREG $36, a                              ; attr 1: Y (8-bit)
 804  9901 7C                   ld a, h
 805  9902 E6 01                and 1                                       ; X is 9-bit; keep only bit 8
 806  9904 ED 92 37             NEXTREG $37, a                              ; attr 2: X MSB in bit 0
 807  9907 3E 02                ld a, 2
 808  9909 F6 80                or %10000000                                ; bit 7 = visible
 809  990B ED 92 38             NEXTREG $38, a                              ; attr 3: pattern + visible flag
 810  990E
 811  990E C9                   ret
 812  990F
 813  990F              .hit:
 814  990F                     ; collision routine
 815  990F 3E 04                ld A, soundHitskull                         ; ready the skull hit sound
 816  9911 CD 6B 8F             call playsound                              ; play it
 817  9914 C3 E4 81             jp takeDamage                               ; update health bar.
 818  9917                                                                  ; the RET in takeDamage will return us to processBaddies
 819  9917
 820  9917
 821  9917              ; IX -> baddie record. Returns carry SET if player overlaps this baddie.
 822  9917              ; Trashes AF, DE, HL
 823  9917              ; hit iff |player-baddie| <= COLLIDE-1 on both axes.
 824  9917              ; bias trick: |d| <= K  <=>  (d+K) in [0,2K] unsigned  -> one range test, no abs branch.
 825  9917              COLLIDE_DX      equ 11                              ; X overlap threshold (tune 9-14)
 826  9917              COLLIDE_DY      equ 11                              ; Y overlap threshold
 827  9917
 828  9917              COLLIDE_BIAS_X  equ COLLIDE_DX - 1          ; 10
 829  9917              COLLIDE_SPAN_X  equ 2*COLLIDE_DX - 1        ; 21
 830  9917              COLLIDE_BIAS_Y  equ COLLIDE_DY - 1          ; 10
 831  9917              COLLIDE_SPAN_Y  equ 2*COLLIDE_DY - 1        ; 21
 832  9917
 833  9917              ; IX -> baddie record. Returns carry SET if player overlaps this baddie.
 834  9917              ; Trashes AF, DE, HL
 835  9917              checkBaddieCollision:
 836  9917                      ; --- X ---
 837  9917 2A 0C 90             ld hl, (player_px)                          ; get player pixel xy
 838  991A DD 5E 01             ld e, (ix + baddieRecord.lowX)              ; get skull pixel x
 839  991D DD 56 02             ld d, (ix + baddieRecord.highX)             ;
 840  9920 B7                   or a                                        ; clear carry
 841  9921 ED 52                sbc hl, de                                  ; get diff, could be -ve
 842  9923 ED 34 0A 00          add hl, COLLIDE_BIAS_X                      ; add in the collide threshold (remember sprites are 16 pixels wide)
 843  9927 7C                   ld a, h                                     ; check the high byte
 844  9928 B7                   or a                                        ; high byte set? (also clears carry)
 845  9929 C0                   ret nz                                      ; too big -> no hit (carry clear)
 846  992A 7D                   ld a, l                                     ; get low byte
 847  992B FE 15                cp COLLIDE_SPAN_X                           ; L < 21 ?
 848  992D D0                   ret nc                                      ; L >= 21 -> no hit (carry clear)
 849  992E
 850  992E                      ; --- Y --- (only reached when X overlaps)
 851  992E 2A 0E 90             ld hl, (player_py)                          ;
 852  9931 DD 5E 03             ld e, (ix + baddieRecord.lowY)              ;
 853  9934 DD 56 04             ld d, (ix + baddieRecord.highY)             ;
 854  9937 B7                   or a                                        ;
 855  9938 ED 52                sbc hl, de                                  ;
 856  993A ED 34 0A 00          add hl, COLLIDE_BIAS_Y                      ;
 857  993E 7C                   ld a, h                                     ;
 858  993F B7                   or a                                        ;
 859  9940 C0                   ret nz                                      ;
 860  9941 7D                   ld a, l                                     ;
 861  9942 FE 15                cp COLLIDE_SPAN_Y                           ;
 862  9944 C9                   ret                                         ;
 863  9945
 864  9945
 865  9945              processBaddie:
 866  9945 DD 66 04             ld h, (ix +baddieRecord.highY)              ; get baddie Y
 867  9948 DD 6E 03             ld l, (ix +baddieRecord.lowY)
 868  994B 22 AE 92             ld (baddie_y), hl
 869  994E 7D                   ld a, l
 870  994F E6 07                and 7
 871  9951 FD 6F                ld iyl, a
 872  9953                      DIV_HL_8B                                   ; divide by 8 to get tile Y
 872  9953             >; version 3, 19 t-states (21 t-states quicker than A)
 872  9953             >; simple 16-bit divide without the CALL/RET overhead
 872  9953 EB          >        EX DE, HL                                   ;                                                   4t
 872  9954 06 03       >        LD B, 3                                     ;                                                   7t
 872  9956 ED 29       >        BSRA DE, B                                  ;                                                   8t
 873  9958 4B                   ld c, e                                     ; save in C, see newTile below
 874  9959
 875  9959 DD 66 02             ld h, (ix +baddieRecord.highX)              ; get baddie X
 876  995C DD 6E 01             ld l, (ix +baddieRecord.lowX)
 877  995F 22 AC 92             ld (baddie_x), hl
 878  9962 7D                   ld a, l
 879  9963 E6 07                and 7
 880  9965 FD 67                ld iyh, a
 881  9967                      DIV_HL_8B                                   ; div by 8 to get tile Y
 881  9967             >; version 3, 19 t-states (21 t-states quicker than A)
 881  9967             >; simple 16-bit divide without the CALL/RET overhead
 881  9967 EB          >        EX DE, HL                                   ;                                                   4t
 881  9968 06 03       >        LD B, 3                                     ;                                                   7t
 881  996A ED 29       >        BSRA DE, B                                  ;                                                   8t
 882  996C 43                   ld b, e                                     ; save in B, see newTile below
 883  996D
 884  996D              ; Decide only when grid-aligned (iyh==0 AND iyl==0) - the only
 885  996D                      ; moment a turn is possible. "Tile changed" fired at the far tile
 886  996D                      ; edge when moving up/left, where the turn check is gated out.
 887  996D FD 7C                ld a, iyh
 888  996F FD B5                or iyl                                      ; both zero => on grid intersection
 889  9971 28 06                jr z, newTile                               ; aligned -> run the decision
 890  9973
 891  9973 DD 7E 07             ld a, (ix +baddieRecord.dir)                ; not aligned -> continue current dir
 892  9976 C3 EB 99             jp gotDir                                   ; jump to do the move
 893  9979
 894  9979              newTile:
 895  9979 DD 70 05             ld (ix +baddieRecord.tileX), b              ; save the tile X
 896  997C DD 71 06             ld (ix +baddieRecord.tileY), c              ; save the tile Y
 897  997F
 898  997F                      ; get reverse direction
 899  997F DD 7E 07             ld a, (ix + baddieRecord.dir)               ; Load current direction
 900  9982 47                   ld b, a                                     ; Backup original direction to B
 901  9983 E6 03                and %00000011                               ; Check for Left (1) / Right (2)
 902  9985 28 05                jr z, .vertMask                             ; If 0, it must be vertical (Up/Down)
 903  9987
 904  9987                      ; Horizontal Path: Swap 1 <-> 2
 905  9987                      ; 'A' already contains ONLY the horizontal bits here
 906  9987 EE 03                xor %00000011                               ; 1 becomes 2, 2 becomes 1
 907  9989 47                   ld b, a                                     ; Store final result in B
 908  998A 18 04                jr .done
 909  998C
 910  998C              .vertMask:
 911  998C                      ; Vertical Path: Swap 4 <-> 8
 912  998C                      ; Because 'A' was 0, 'B' still holds the unaltered original vertical value
 913  998C 78                   ld a, b                                     ; Bring original back to A to process
 914  998D EE 0C                xor %00001100                               ; 4 becomes 8, 8 becomes 4
 915  998F 47                   ld b, a                                     ; Store final result in B
 916  9990
 917  9990              .done:
 918  9990                      ; d holds current direction (bitmask)
 919  9990 C5                   push bc                                     ; save reverse on stack for use later
 920  9991 3E 0F                ld a, %00001111                             ; start with all directions
 921  9993 A8                   xor b                                       ; mask out reverse
 922  9994
 923  9994              ; -----------------------------------------------
 924  9994              ; Test each direction to see if a move is allowed
 925  9994              ; -----------------------------------------------
 926  9994 57                   ld d, a                                     ; D = directions to test (all except reverse)
 927  9995 1E 00                ld e, 0                                     ; E = available directions found
 928  9997
 929  9997 CB 42                bit dir_left, d
 930  9999 C4 CA 9A             call nz, chkLeft1
 931  999C
 932  999C CB 4A                bit dir_right, d
 933  999E C4 23 9B             call nz, chkRight1
 934  99A1
 935  99A1 CB 52                bit dir_down, d
 936  99A3 C4 7E 9B             call nz, chkDown1
