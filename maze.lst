 146+ 7F29             >
 146+ 7F29             >
 146+ 7F29             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 146+ 7F29 7C          >        ld   a,h                                    ; get the high byte again
 146+ 7F2A E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 146+ 7F2C             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 146+ 7F2C             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 146+ 7F2C F6 C0       >        or $C0                                      ; "add" page offset
