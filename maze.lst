1125  9B52              displayBaddie:
1126  9B52                  ; ============================================================
1127  9B52                  ; Draw baddie sprite (sprite #1) relative to the centred player.
1128  9B52                  ; Player is locked to screen centre, so:
1129  9B52                  ;     screenPos = baddieWorldPos - playerWorldPos + screenCentre
1130  9B52                  ; A 16x16 sprite is shown whenever ANY part overlaps the display,
1131  9B52                  ; so we allow up to 15px of overhang at each edge before hiding.
1132  9B52                  ; IX already points at the baddie record (set by processBaddies).
1133  9B52                  ; ============================================================
1134  9B52
1135  9B52 3A 05 93             ld a, (viewMode)
1136  9B55 B7                   or a
1137  9B56 C2 C8 9B             jp nz, radarBaddie
1138  9B59
1139  9B59                  ; ---------- SCREEN X ----------
1140  9B59                      ; HL = baddie world X
1141  9B59 DD 6E 01             ld l, (ix + baddieRecord.lowX)
1142  9B5C DD 66 02             ld h, (ix + baddieRecord.highX)
1143  9B5F ED 4B CA 8E          ld bc, (cam_px)                             ; BC = player world X
1144  9B63 B7                   or a                                        ; clear carry for a clean subtract
1145  9B64 ED 42                sbc hl, bc                                  ; HL = baddieX - playerX  (signed)
1146  9B66                  ; add screen centre AND the 15px overhang bias in one go.
1147  9B66                  ; CENTER_SCREEN_X + 15 = 152 + 15 = 167, which fits in 8 bits,
1148  9B66                  ; so we can use the Z80N "add hl,a" (cheaper to set up than add hl,bc).
1149  9B66 3E 0F                ld a,  15                                   ; A = 167  (centre + bias)
1150  9B68 ED 31                add hl, a                                   ; Z80N: HL = biased screen X
1151  9B6A                  ; HL now holds (screenX + 15). Visible-with-overhang means the
1152  9B6A                  ; UN-biased X is in -15..319, i.e. the BIASED value is in 0..334.
1153  9B6A                  ; Reject anything outside 0..334 with an unsigned range test.
1154  9B6A 7C                   ld a, h                                     ; look at high byte of biased X
1155  9B6B FE 01                cp 1                                        ; H = 0 ?  (biased X = 0..255)
1156  9B6D 38 07                jr c, .xInRange                             ; H = 0 -> definitely <= 334, in range
1157  9B6F 20 4C                jr nz, .hideBaddie                          ; H >= 2 -> biased X >= 512 -> off right
1158  9B71                  ; H = 1 here, so biased X = 256..511; allowed only up to 334 ($014E),
1159  9B71                  ; meaning the low byte must be < 79 (334 - 256 = 78).
1160  9B71 7D                   ld a, l
1161  9B72 FE 4F                cp 79
1162  9B74 30 47                jr nc, .hideBaddie                          ; low byte >= 79 -> off right edge
1163  9B76              .xInRange:
1164  9B76 E5                   push hl                                     ; save biased X (we still need it later)
1165  9B77
