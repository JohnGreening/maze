 757  97CB DD 7D                ld a, ixl
 758  97CD FE 79                cp low baddieEnd
 759  97CF 20 EC                jr nz, .loop
 760  97D1 DD 7C                ld a, ixh
 761  97D3 FE 91                cp high baddieEnd
 762  97D5 20 E6                jr nz, .loop
 763  97D7
