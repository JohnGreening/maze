  51+ 7E97 32 D1 8E    >        ld (curWorldPage), a                        ; save page for subsequent reads - likely no need to reload
  51+ 7E9A ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
  51+ 7E9D             >
  51+ 7E9D             >
  51+ 7E9D             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
  51+ 7E9D 7C          >        ld   a,h                                    ; get the high byte again
  51+ 7E9E E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
  51+ 7EA0             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
  51+ 7EA0             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
  51+ 7EA0 F6 C0       >        or $C0                                      ; "add" page offset
