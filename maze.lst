 859+ 8702 ED 91 1B 02          nextreg $1B, 2                              ; X1 = 2   → left edge  = pixel 4
 860+ 8706 ED 91 1B 9D          nextreg $1B, 157                            ; X2 = 157 → right edge = pixel 315 (319-4)
 861+ 870A ED 91 1B 40          nextreg $1b, 64                             ; Y1 = 64, top 4 border lines + top 4 ULA lines
 862+ 870E ED 91 1B FB          nextreg $1B, 251                            ; Y2 = 251 → bottom edge= pixel 251 (255-4)
 863+ 8712
 864+ 8712                  ; setSpriteClip - clip sprites to the play area (below the HUD).
 865+ 8712                  ; Over-border mode is active, so:
 866+ 8712                  ;   - X coords use the SAME doubling as the tilemap clip (copy 2,157)
 867+ 8712                  ;   - Y coords are in sprite space: ULA-origin pixel + 32
 868+ 8712                  ;       tilemap top  pixel 64  -> 64+32 = 96
 869+ 8712                  ;       tilemap bot  pixel 251 -> 283 (overflows) -> clamp to 255
 870+ 8712                  ; Requires $15 bit 5 (clip-over-border) set - see note.
 871+ 8712 ED 91 15 23          NEXTREG $15, %00100011                      ; was %00010111; bit 5 = enable sprite clip over border
 872+ 8716
 873+ 8716 ED 91 1C 02          nextreg $1C, 2                              ; bit 1 = reset the SPRITE clip index
 874+ 871A ED 91 19 00          nextreg $19, 0                              ; X1 (doubled units, same as tilemap) -> pixel 4
 875+ 871E ED 91 19 9F          nextreg $19, 159                            ; X2 -> pixel 315
 876+ 8722 ED 91 19 40          nextreg $19, 64                             ; Y1 = 64 -> top of play area
 877+ 8726 ED 91 19 FF          nextreg $19, 255                            ; Y2 = clamp (283 overflows a byte; screen edge handles bottom)
 878+ 872A C9                   ret
