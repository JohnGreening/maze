 370+ 82B8
 371+ 82B8              ; ============================================================
 372+ 82B8              ; floodFill - BFS from (floodTargetX,floodTargetY). Fills the
 373+ 82B8              ; distance field: 0 at target, increasing outward, clamped at
 374+ 82B8              ; 254. 255 = wall/unvisited/unreachable. INERT until called.
 375+ 82B8              ; ============================================================
 376+ 82B8              floodFill:
 377+ 82B8 3E 00                ld a, 0                                     ; ready to initialise
 378+ 82BA 32 00 94             ld (qHeadL), a                              ; set q head to 0
 379+ 82BD 32 01 94             ld (qTailL), a                              ; set q tail to 0
 380+ 82C0 32 02 94             ld (qCount), a                              ; set q depth to 0
 381+ 82C3
 382+ 82C3 3A 04 94             ld a, (floodTargetY)                        ; get our target cell Y
 383+ 82C6 57                   ld d, a                                     ; put in D
 384+ 82C7 3A 03 94             ld a, (floodTargetX)                        ; get out target cell X
 385+ 82CA 5F                   ld e, a                                     ; put in E
 386+ 82CB
 387+ 82CB 62                   ld h, d                                     ; Y also in H
 388+ 82CC 6B                   ld l, e                                     ; X also in L
 389+ 82CD
 390+ 82CD                      GET_WORLD_VALUE DFIELD_PAGE, USE_HL         ; use common routine to point HL to flood value we want to set
 390+ 82CD             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 390+ 82CD             >;
 390+ 82CD             >;       arg  is TILEMAP_PAGE
 390+ 82CD             >;            or DFIELD_PAGE
 390+ 82CD             >;
 390+ 82CD             >;       arg1 decides if input comes from BC or directly from HL
 390+ 82CD             >;            NB if directly from HL then L = tile X, H = tile Y
 390+ 82CD             >;
 390+ 82CD             >        if USE_HL = 0
 390+ 82CD ~           >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 390+ 82CD ~           >                                                    ; put it in H (this is the same as multiplying by 256)
 390+ 82CD ~           >        ld l, b                                     ; read the X tile coordinate into L
 390+ 82CD ~           >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 390+ 82CD ~           >                                                    ; This is the byte offset into "world" map.
 390+ 82CD             >        endif
 390+ 82CD             >
 390+ 82CD             >    ; STEP 2: Calculate which 8K physical page the data lives in
 390+ 82CD 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 390+ 82CE             >;        srl  a                                      ; divide by 2
 390+ 82CE             >;        srl  a                                      ; divide by 2 again  → now /4
 390+ 82CE             >;        srl  a                                      ; /8
 390+ 82CE             >;        srl  a                                      ; /16
 390+ 82CE             >;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 390+ 82CE             >; ------------------------------------------------------------------------
 390+ 82CE             >; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
 390+ 82CE             >; saves 21 t-state
 390+ 82CE             >; ------------------------------------------------------------------------
 390+ 82CE 07          >        rlca
 390+ 82CF 07          >        rlca
 390+ 82D0 07          >        rlca
 390+ 82D1 E6 07       >        and 7
 390+ 82D3             >                                                    ; Why divide by 32?
 390+ 82D3             >                                                    ;   Each page is 8192 bytes.
 390+ 82D3             >                                                    ;   Each row is 256 bytes.
 390+ 82D3             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 390+ 82D3             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 390+ 82D3             >
 390+ 82D3 C6 2E       >        add  a, DFIELD_PAGE                                 ; add the starting page number
 390+ 82D5 32 01 90    >        ld (curWorldPage), a                        ; save page for subsequent reads - likely no need to reload
 390+ 82D8 ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 390+ 82DB             >
 390+ 82DB             >
 390+ 82DB             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 390+ 82DB 7C          >        ld   a,h                                    ; get the high byte again
 390+ 82DC E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 390+ 82DE             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 390+ 82DE             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 390+ 82DE F6 C0       >        or $C0                                      ; "add" page offset
 390+ 82E0 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 390+ 82E1             >
 390+ 82E1             >    ; STEP 4: read the byte
 390+ 82E1             >                                                    ; HL now points directly at the first byte we want to copy
 390+ 82E1 7E          >        ld a, (hl)                                  ; so get the byte
 391+ 82E2 36 00                ld (hl), 0                                  ; set initial flood value to 0
 392+ 82E4
 393+ 82E4                      QPUSH_DE                                    ; push target (d = y, e = x)
 393+ 82E4 3A 01 94    >        ld a, (qTailL)
 393+ 82E7 6F          >        ld l, a
 393+ 82E8 26 93       >        ld h, high floodQueue       ; constant page base
 393+ 82EA 73          >        ld (hl), e                  ; store X
 393+ 82EB 2C          >        inc l                       ; wraps 255->0 within the page
 393+ 82EC 72          >        ld (hl), d                  ; store Y
 393+ 82ED 2C          >        inc l                       ; -> next slot (free 128-entry wrap)
 393+ 82EE 7D          >        ld a, l
 393+ 82EF 32 01 94    >        ld (qTailL), a
 393+ 82F2 21 02 94    >        ld hl, qCount
 393+ 82F5 34          >        inc (hl)
 394+ 82F6
 395+ 82F6              .mainLoop:
 396+ 82F6 3A 02 94             ld a, (qCount)                              ; get the count of items on the queue
 397+ 82F9 B7                   or a
 398+ 82FA C8                   ret z                                       ; empty -> done
 399+ 82FB
 400+ 82FB                      ; qPopDE is only called from here
 401+ 82FB                      ; it's effectively the driver for the processing for this tile
 402+ 82FB                      QPOP_DE                                     ; DE = current cell (D=y, E=x)
 402+ 82FB 3A 00 94    >        ld a, (qHeadL)
 402+ 82FE 6F          >        ld l, a
 402+ 82FF 26 93       >        ld h, high floodQueue
 402+ 8301 5E          >        ld e, (hl)                  ; X
 402+ 8302 2C          >        inc l
 402+ 8303 56          >        ld d, (hl)                  ; Y
 402+ 8304 2C          >        inc l
 402+ 8305 7D          >        ld a, l
 402+ 8306 32 00 94    >        ld (qHeadL), a
 402+ 8309 21 02 94    >        ld hl, qCount
 402+ 830C 35          >        dec (hl)
