 984  99B3 1E 00                ld e, 0                                     ; E = available directions found
 985  99B5
 986  99B5 CB 42                bit dir_left, d
 987  99B7 C4 E5 9A             call nz, chkLeft1
 988  99BA
 989  99BA CB 4A                bit dir_right, d
 990  99BC C4 4E 9B             call nz, chkRight1
