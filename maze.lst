1503  F380              ; ----------------------------------------------------------------
1504  F380              ; Tilemap data - 48 KB stored directly in Pages 40 - 45
1505  F380              ; ----------------------------------------------------------------
1506  F380              TILEMAP_PAGE    EQU     40
1507  F380
1508  F380              ; === Chunk 1 (bytes 0-16383) -> 8 KB Page 40/41 ===
1509  F380              MMU     6, TILEMAP_PAGE                             ; map page 40 into slot 6
1510  F380              MMU     7, TILEMAP_PAGE + 1                         ; map page 41 into slot 7
1511  F380              ORG     $C000
1512  C000              tilemap_part1:
1513  C000              INCBIN  "testmaze.map", 0, 16384                    ; first 16 KB
1514  0000
1515  0000              ; === Chunk 2 (bytes 16384-32767) -> 8 KB Page 42/43 ===
1516  0000              MMU     6, TILEMAP_PAGE + 2
1517  0000              MMU     7, TILEMAP_PAGE + 3
1518  0000              ORG     $C000
1519  C000              tilemap_part2:
1520  C000              INCBIN  "testmaze.map", 16384, 16384
1521  0000
1522  0000              ; === Chunk 3 (bytes 32768-49151) -> 8 KB Page 44/45 ===
1523  0000              MMU     6, TILEMAP_PAGE + 4
1524  0000              MMU     7, TILEMAP_PAGE + 5
1525  0000              ORG     $C000
1526  C000              tilemap_part3:
1527  C000              INCBIN  "testmaze.map", 32768, 16384
1528  0000
1529  0000              ; ----------------------------------------------------------------
1530  0000              ; Distance field - 48 KB, one byte per maze cell (256x192).
1531  0000              ; Same layout as the map (256-byte rows) but in pages 46-51, so the
1532  0000              ; tile (x,y) -> address arithmetic is identical to GET_WORLD_VALUE
1533  0000              ; with base page DFIELD_PAGE instead of TILEMAP_PAGE.
1534  0000              ; Filled by the flood-fill; 255 = wall/unvisited/unreachable.
1535  0000              ; ----------------------------------------------------------------
1536  0000              DFIELD_PAGE     EQU     TILEMAP_PAGE + 6
1537  0000
1538  0000              ; reserve the six pages so they exist in the .nex (contents set at runtime)
1539  0000              MMU     6, DFIELD_PAGE
1540  0000              MMU     7, DFIELD_PAGE + 1
1541  0000              ORG     $C000
1542  C000              dfield_part1:
1543  C000 00 00 00...  DEFS    16384
1544  0000
1545  0000              MMU     6, DFIELD_PAGE + 2
1546  0000              MMU     7, DFIELD_PAGE + 3
1547  0000              ORG     $C000
1548  C000              dfield_part2:
1549  C000 00 00 00...  DEFS    16384
1550  0000
1551  0000              MMU     6, DFIELD_PAGE + 4
1552  0000              MMU     7, DFIELD_PAGE + 5
1553  0000              ORG     $C000
1554  C000              dfield_part3:
1555  C000 00 00 00...  DEFS    16384
1556  0000
1557  0000              ; --- radar / Layer 2 ---
1558  0000              MAP_PAGE        equ TILEMAP_PAGE        ; map data lives here (40)
1559  0000              L2_PAGE         equ DFIELD_PAGE + 6     ; Layer 2 image pages (52-57), after the field
1560  0000              L2_BANK16       equ L2_PAGE / 2         ; 16K bank number for reg $12 (=26)
1561  0000
1562  0000              MMU 6, L2_PAGE
1563  0000              MMU 7, L2_PAGE + 1
1564  0000              org $C000
1565  C000 00 00 00...  DEFS 16384
1566  0000
1567  0000              MMU 6, L2_PAGE + 2
1568  0000              MMU 7, L2_PAGE + 3
1569  0000              org $C000
1570  C000 00 00 00...  DEFS 16384
1571  0000
1572  0000              MMU 6, L2_PAGE + 4
1573  0000              MMU 7, L2_PAGE + 5
1574  0000              org $C000
1575  C000 00 00 00...  DEFS 16384
1576  0000
1577  0000              ; ----------------------------------------------------------------
1578  0000              ; Build the .nex file (automatically includes all used banks)
1579  0000              ; ----------------------------------------------------------------
1580  0000              SAVENEX OPEN "maze.nex", progStart, $FF40           ; entry point + stack
1581  0000              SAVENEX AUTO                                        ; include all pages we used
1582  0000              SAVENEX CLOSE
