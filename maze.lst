 336+ 8311 28 06                jr z, .skipL                                ; branch if so, nothing to do
 337+ 8313 3D                   dec a                                       ; get x - 1
 338+ 8314 6F                   ld l, a                                     ; set L = X - 1 to test it
 339+ 8315 62                   ld h, d                                     ; set H = y  to test it
 340+ 8316 CD 3B 83             call .tryCell                               ; do the test. HL is now x-1, y
 341+ 8319              .skipL:
 342+ 8319                      ; RIGHT
