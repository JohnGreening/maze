 628  972E                      ; ... player_tile_x / player_tile_y just stored ...
 629  972E CD 85 97             call checkKeyCollect
 630  9731 30 03                jr nc, .noKey               ; carry clear -> nothing collected
 631  9733                      ; A = collected key index -> handle it
 632  9733 CD 62 7E             call collectKey             ; mark collected, clear tiles, bump count, re-flood
 633  9736              .noKey:
 634  9736                      ; ... rest of showSprite ...
 635  9736
 636  9736 3A 05 93             ld a, (viewMode)                            ; get the view mode, normal or radar
 637  9739 B7                   or a                                        ; see it it is 0 (normal)
