 603  96FF 01 3B 24             ld bc, $243B                                ; register select port
 604  9702 3E 1E                ld a, $1E
 605  9704 ED 79                out (c), a                                  ; select ULA status register
 606  9706 04                   inc b                                       ; now point to data port $253B
