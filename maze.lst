  97+ F1BF
  98+ F1BF              ; set the AY mixer value depending on ch1Flags, ch2Flags & ch3Flags
  99+ F1BF              ; these control the tone and noise flags in main AY mixer setting
 100+ F1BF              ; mapping is as follows and we negate the Ch1/2/3Flag setting
 101+ F1BF              ; Ch1Flags
 102+ F1BF              ; 0 -> 0        move bit 0 of ch1Flags to bit 0 of AYchip flag
 103+ F1BF              ; 1 -> 3        move bit 1 of ch1Flags to bit 3 of AYChip flag
 104+ F1BF              ; Ch2Flags
 105+ F1BF              ; 0 -> 1
 106+ F1BF              ; 1 -> 4
 107+ F1BF              ; Ch3Flags
 108+ F1BF              ; 0 -> 2
 109+ F1BF              ; 1 -> 5
 110+ F1BF
 111+ F1BF              ; ---- AY mixer (reg 7): 0 = enabled. tone A/B/C = bits 0-2, noise A/B/C = bits 3-5 ----
 112+ F1BF              ; ChNFlags: bit0 = tone-on, bit1 = noise-on.
 113+ F1BF              ; Gather each channel's tone bit into E and noise bit into D, then place & invert.
 114+ F1BF 16 00                ld d, 0                                     ; D = noise bits (will land in mixer bits 3-5)
 115+ F1C1 1E 00                ld e, 0                                     ; E = tone  bits (mixer bits 0-2)
 116+ F1C3
 117+ F1C3 3A F4 8F             ld a, (Ch3Flags)                            ; process 3,2,1 so channel 1 ends up in bit 0
 118+ F1C6 1F                   rra
 118+ F1C7 CB 13          rl e                                  ; tone3  -> E
 119+ F1C9 1F                   rra
 119+ F1CA CB 12          rl d                                  ; noise3 -> D
 120+ F1CC 3A EA 8F             ld a, (Ch2Flags)
 121+ F1CF 1F                   rra
 121+ F1D0 CB 13          rl e                                  ; tone2
 122+ F1D2 1F                   rra
 122+ F1D3 CB 12          rl d                                  ; noise2
 123+ F1D5 3A E0 8F             ld a, (Ch1Flags)
 124+ F1D8 1F                   rra
 124+ F1D9 CB 13          rl e                                  ; tone1
 125+ F1DB 1F                   rra
 125+ F1DC CB 12          rl d                                  ; noise1
 126+ F1DE
 127+ F1DE 7A                   ld a, d
 128+ F1DF 87                   add a,a
 128+ F1E0 87             add a,a
 128+ F1E1 87             add a,a                 ; noise bits up to positions 3-5
 129+ F1E2 B3                   or e                                        ; + tone bits 0-2  = active-high enables
 130+ F1E3 2F                   cpl                                         ; invert: 0=enable; bits 6,7 -> 1 (I/O input)
 131+ F1E4
 132+ F1E4 01 FD FF             ld bc, AYSelect
 133+ F1E7 16 07                ld d, mixerFlag
 134+ F1E9 ED 51                out (c), d
 135+ F1EB 01 FD BF             ld bc, AYrw
 136+ F1EE ED 79                out (c), a
