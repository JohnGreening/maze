 489  972B              moveSprite1:
 490  972B              ; ================================================
 491  972B                  ; FINE SCROLLING (pixel-level smooth scroll)
 492  972B                  ; Set hardware tilemap scroll registers using player_px/py
 493  972B                  ; ================================================
 494  972B CD FF 97             call wait_vblank
 495  972E
 496  972E 3A 56 8F             ld a, (cam_px)                              ; get LOW byte of camera X position
 497  9731 E6 07                and 7                                       ; keep only the bottom 3 bits (0-7 pixels)
 498  9733 ED 92 30             nextreg $30, a                              ; ← X fine offset (MUST be every frame)
 499  9736
 500  9736 3A 58 8F             ld a, (cam_py)                              ; get LOW byte of camera Y position
 501  9739 E6 07                and 7                                       ; keep only the bottom 3 bits (0-7 pixels)
 502  973B ED 92 31             nextreg $31, a                              ; ← Y fine offset (MUST be every frame)
 503  973E
 504  973E              ; ================================================
 505  973E                  ; COPY DECISION - copy ONLY when X or Y is aligned to tile boundary
 506  973E                  ; ================================================
 507  973E 2A 56 8F             ld hl, (cam_px)
 508  9741                      DIV_HL_8A
 508  9741             >; version 2, 40 t-states (8 t-states quicker than DIV_HL_8)
 508  9741             >; simple 16-bit divide without the CALL/RET overhead
 508  9741 7D          >        ld a, l                                     ; get low byte into a ready for rotate from carry   4t
 508  9742 CB 3C       >        srl h                                       ;                                                   8t
 508  9744 1F          >        rra                                         ;                                                   4t
 508  9745 CB 3C       >        srl h                                       ;                                                   8t
 508  9747 1F          >        rra                                         ;                                                   4t
 508  9748 CB 3C       >        srl h                                       ;                                                   8t
 508  974A 1F          >        rra                                         ;                                                   4t
 509  974B 47                   ld b, a
 510  974C 2A 58 8F             ld hl, (cam_py)
 511  974F                      DIV_HL_8A
 511  974F             >; version 2, 40 t-states (8 t-states quicker than DIV_HL_8)
 511  974F             >; simple 16-bit divide without the CALL/RET overhead
 511  974F 7D          >        ld a, l                                     ; get low byte into a ready for rotate from carry   4t
 511  9750 CB 3C       >        srl h                                       ;                                                   8t
 511  9752 1F          >        rra                                         ;                                                   4t
 511  9753 CB 3C       >        srl h                                       ;                                                   8t
