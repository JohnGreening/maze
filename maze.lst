 149+ 8702                      GET_WORLD_VALUE DFIELD_PAGE, USE_HL
 149+ 8702             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 149+ 8702             >;
 149+ 8702             >;       arg  is TILEMAP_PAGE
 149+ 8702             >;            or DFIELD_PAGE
 149+ 8702             >;
 149+ 8702             >;       arg1 decides if input comes from BC or directly from HL
 149+ 8702             >;            NB if directly from HL then L = tile X, H = tile Y
 149+ 8702             >;
 149+ 8702             >        if USE_HL = 0
 149+ 8702 ~           >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 149+ 8702 ~           >                                                    ; put it in H (this is the same as multiplying by 256)
 149+ 8702 ~           >        ld l, b                                     ; read the X tile coordinate into L
 149+ 8702 ~           >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 149+ 8702 ~           >                                                    ; This is the byte offset into "world" map.
 149+ 8702             >        endif
 149+ 8702             >
 149+ 8702             >    ; STEP 2: Calculate which 8K physical page the data lives in
 149+ 8702 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 149+ 8703 CB 3F       >        srl  a                                      ; divide by 2
 149+ 8705 CB 3F       >        srl  a                                      ; divide by 2 again  → now /4
 149+ 8707 CB 3F       >        srl  a                                      ; /8
 149+ 8709 CB 3F       >        srl  a                                      ; /16
 149+ 870B CB 3F       >        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 149+ 870D             >                                                    ; Why divide by 32?
 149+ 870D             >                                                    ;   Each page is 8192 bytes.
 149+ 870D             >                                                    ;   Each row is 256 bytes.
 149+ 870D             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 149+ 870D             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 149+ 870D             >
 149+ 870D C6 2E       >        add  a, DFIELD_PAGE                                 ; add the starting page number
 149+ 870F             >
 149+ 870F ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 149+ 8712             >
 149+ 8712             >
 149+ 8712             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 149+ 8712 7C          >        ld   a,h                                    ; get the high byte again
 149+ 8713 E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 149+ 8715             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 149+ 8715             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 149+ 8715 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 149+ 8716             >
 149+ 8716             >    ; STEP 4: add the page offset so we can read it
 149+ 8716 ED 34 00 C0 >        add  hl, $C000                              ; HL = $C000 + offset_inside_page
 149+ 871A             >                                                    ; HL now points directly at the first byte we want to copy
 149+ 871A 7E          >        ld a, (hl)                                  ; so get the byte
 150+ 871B              ;        call getFieldByte
 151+ 871B 01 12 00             ld bc, 18
 152+ 871E CD C3 86             call Bin8ToDec
