 768  97DC                      ; -------------------------------------------------------
 769  97DC                      ; here we just display the player if we are in Radar mode
 770  97DC                      ; -------------------------------------------------------
 771  97DC
 772  97DC                      ; tile x/y already calculated, just use them
 773  97DC 3A E0 8E             ld a, (player_tile_x)
 774  97DF 6F                   ld l, a
 775  97E0 26 00                ld h, 0
