  76+ 8F6B              playsound:
  77+ 8F6B              ; Input : A = sound fx to play
  78+ 8F6B              ;
  79+ 8F6B              ; routine will rotate next available channel (even if still playing) and copy sound fx to that channel
  80+ 8F6B              ; IM2 will then process that data
  81+ 8F6B E5                   PUSH HL
  82+ 8F6C D5                   PUSH DE
  83+ 8F6D C5                   PUSH BC
  84+ 8F6E
  85+ 8F6E                      ; source for the sound effect is: sound1 + (fx-1) * 10 (sound effect record length)
  86+ 8F6E 3D                   DEC A                                       ; do the fx-1
  87+ 8F6F 5F                   LD E, A
  88+ 8F70 87                   ADD A, A                                    ; now * 2
  89+ 8F71 87                   ADD A, A                                    ; * 4
  90+ 8F72 83                   ADD A, E                                    ; * 5 (i.e. +n)
  91+ 8F73 87                   ADD A, A                                    ; * 10
  92+ 8F74 21 9B 8F             LD HL, sound1                               ; point to base of data
  93+ 8F77 ED 31                ADD HL, A                                   ; and add the offset to get to fx
  94+ 8F79
  95+ 8F79                      ; destination is: ch1 + nextCH * 10
  96+ 8F79 3A D7 8F             LD A, (nextCH)                              ; whats the nextCH to use
  97+ 8F7C 5F                   ld e, a                                     ; save it (0, 1 or 2)
  98+ 8F7D 87                   add a, a                                    ; * 2
  99+ 8F7E 87                   add a, a                                    ; * 4
 100+ 8F7F 83                   add a, e                                    ; * 5 (i.e. +n)
 101+ 8F80 87                   add a, a                                    ; * 10
 102+ 8F81 11 D8 8F             ld de, Ch1                                  ; point to base of data
 103+ 8F84 ED 32                add de, a                                   ; and add the offset to get Ch1, Ch2 or Ch3
 104+ 8F86
 105+ 8F86 01 0A 00             LD BC, 10                                   ; we copy 10 bytes of sound setup
 106+ 8F89 ED B0                LDIR                                        ; do the copy
 107+ 8F8B
 108+ 8F8B 3A D7 8F             ld a, (nextCH)                              ; ready to rotate for next fx
 109+ 8F8E 3C                   inc a                                       ; point to next
 110+ 8F8F FE 03                cp 3                                        ; only channel values of 0, 1 or 2 are valid
 111+ 8F91 38 01                jr c, .store                                ; branch if ok
 112+ 8F93 AF                   xor a                                       ; reset to 0 (wrap 3 -> 0)
 113+ 8F94              .store
 114+ 8F94 32 D7 8F             ld (nextCH), a                              ; save it back
 115+ 8F97
 116+ 8F97 C1                   POP BC
 117+ 8F98 D1                   POP DE
 118+ 8F99 E1                   POP HL
 119+ 8F9A C9                   RET
