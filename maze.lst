 160+ F20B              melodyRoutine:
 161+ F20B 3A F6 8F             LD A, (frameCount)                  ; pick up remaining note time
 162+ F20E 3D                   DEC A                               ; decrease by 1 frame
 163+ F20F 32 F6 8F             LD (frameCount), A                  ; save it back
 164+ F212 C2 58 F3             JP NZ, melodyEnd                    ; branch to end if not zero
 165+ F215
 166+ F215                      ; timer expired, so pick up next note to play
 167+ F215                      ; - first set timer for this new note
 168+ F215              mr0:
 169+ F215 ED 5B F7 8F          LD DE, (framePointer)               ; framePointer = timer table
 170+ F219 1A                   LD A, (DE)                          ; get note length
 171+ F21A
 172+ F21A 13                   INC DE                              ; skip past high byte
 173+ F21B FE FF                CP 255                              ; is it 255 marker
 174+ F21D 20 09                JR NZ, mr1                          ; branch if not
 175+ F21F
