 467  956E              	    DIV_HL_8
 467  956E             >; simple 16-bit divide without the CALL/RET overhead
 467  956E CB 3C       >        srl h                                       ; divide by 2
 467  9570 CB 1D       >        rr l
 467  9572 CB 3C       >        srl h                                       ; divide by 4
 467  9574 CB 1D       >        rr l
 467  9576 CB 3C       >        srl h                                       ; divide by 8
 467  9578 CB 1D       >        rr l
