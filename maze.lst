   2  0000              INCLUDE "macros.inc"
# file opened: macros.inc
   1+ 0000              DEVICE ZXSPECTRUMNEXT
   2+ 0000
   3+ 0000              USE_BC              EQU 0                           ; see GET_WORLD_VALUE macro
   4+ 0000              USE_HL              EQU 1                           ; see GET_WORLD_VALUE macro
   5+ 0000
   6+ 0000              MACRO SPEED arg
   7+ 0000 ~                    ld a, arg
   8+ 0000 ~                    NEXTREG $07, A
   9+ 0000                          ENDM
  10+ 0000
  11+ 0000              MACRO DIV_HL_8
  12+ 0000 ~            ; simple 16-bit divide without the CALL/RET overhead
  13+ 0000 ~                    srl h                                       ; divide by 2
  14+ 0000 ~                    rr l
  15+ 0000 ~                    srl h                                       ; divide by 4
  16+ 0000 ~                    rr l
  17+ 0000 ~                    srl h                                       ; divide by 8
  18+ 0000 ~                    rr l
  19+ 0000                      ENDM
  20+ 0000
  21+ 0000              MACRO GET_WORLD_VALUE arg, arg1
  22+ 0000 ~            ; given B= tile X, C= tile Y, return "world" value at this position in the world map
  23+ 0000 ~            ;
  24+ 0000 ~            ;       arg  is TILEMAP_PAGE
  25+ 0000 ~            ;            or DFIELD_PAGE
  26+ 0000 ~            ;
  27+ 0000 ~            ;       arg1 decides if input comes from BC or directly from HL
  28+ 0000 ~            ;            NB if directly from HL then L = tile X, H = tile Y
  29+ 0000 ~            ;
  30+ 0000 ~                    if arg1 = 0
  31+ 0000 ~                    ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
  32+ 0000 ~                                                                ; put it in H (this is the same as multiplying by 256)
  33+ 0000 ~                    ld l, b                                     ; read the X tile coordinate into L
  34+ 0000 ~                                                                ; Result: HL now holds tile_y * 256 + tile_x
  35+ 0000 ~                                                                ; This is the byte offset into "world" map.
  36+ 0000 ~                    endif
  37+ 0000 ~
  38+ 0000 ~                ; STEP 2: Calculate which 8K physical page the data lives in
  39+ 0000 ~                    ld   a,h                                    ; take the high byte of the offset (which is tile_y)
  40+ 0000 ~                    srl  a                                      ; divide by 2
  41+ 0000 ~                    srl  a                                      ; divide by 2 again  → now /4
  42+ 0000 ~                    srl  a                                      ; /8
  43+ 0000 ~                    srl  a                                      ; /16
  44+ 0000 ~                    srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
  45+ 0000 ~                                                                ; Why divide by 32?
  46+ 0000 ~                                                                ;   Each page is 8192 bytes.
  47+ 0000 ~                                                                ;   Each row is 256 bytes.
  48+ 0000 ~                                                                ;   8192 ÷ 256 = exactly 32 rows per page.
  49+ 0000 ~                                                                ;   Therefore page number = 40 + (tile_y ÷ 32)
  50+ 0000 ~
  51+ 0000 ~                    add  a, arg                                 ; add the starting page number
  52+ 0000 ~
  53+ 0000 ~                    nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
  54+ 0000 ~
  55+ 0000 ~
  56+ 0000 ~                ; STEP 3: Keep only the part of the address that fits inside one 8K page
  57+ 0000 ~                    ld   a,h                                    ; get the high byte again
  58+ 0000 ~                    and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
  59+ 0000 ~                                                                ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
  60+ 0000 ~                                                                ; (because 8192 = 2^13 and we are discarding everything above bit 12)
  61+ 0000 ~                    ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
  62+ 0000 ~
  63+ 0000 ~                ; STEP 4: add the page offset so we can read it
  64+ 0000 ~                    add  hl, $C000                              ; HL = $C000 + offset_inside_page
  65+ 0000 ~                                                                ; HL now points directly at the first byte we want to copy
  66+ 0000 ~                    ld a, (hl)                                  ; so get the byte
  67+ 0000                      ENDM
  68+ 0000
