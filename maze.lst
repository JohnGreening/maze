 736  984D              ; ============================================================
 737  984D              ; checkKeyCollect
 738  984D              ; Tests whether the player's 2x2 footprint overlaps any
 739  984D              ; AVAILABLE key's 2x2 block.
 740  984D              ; Returns: A = key index (0..KEY_COUNT-1) and carry SET if a
 741  984D              ;          key was collected; carry CLEAR (A undefined) if none.
 742  984D              ; Uses player_tile_x / player_tile_y (must be current).
 743  984D              ; Trashes: AF, BC, DE, HL
 744  984D              ; ============================================================
 745  984D              checkKeyCollect:
 746  984D 21 3D 7E             ld hl, KEY_DATA
 747  9850 06 00                ld b, 0                         ; B = key index
 748  9852              .loop:
 749  9852 7E                   ld a, (hl)                      ; key tileX
 750  9853 23                   inc hl
 751  9854 4E                   ld c, (hl)                      ; key tileY
 752  9855 23                   inc hl
 753  9856 5E                   ld e, (hl)                      ; status
 754  9857 23                   inc hl                          ; HL -> next key record
 755  9858
 756  9858                      ; skip keys that aren't available
 757  9858 57                   ld d, a                         ; save key tileX in D (A about to be reused)
 758  9859 7B                   ld a, e
 759  985A FE 01                cp KEY_AVAILABLE
 760  985C 20 1B                jr nz, .next                    ; not available -> skip
 761  985E
 762  985E                      ; --- X overlap: abs(player_tile_x - keyX) <= 1 ? ---
 763  985E 3A C8 8E             ld a, (player_tile_x)
 764  9861 92                   sub d                           ; A = px - kx
 765  9862 30 02                jr nc, .xpos
 766  9864 ED 44                neg                             ; A = |px - kx|
 767  9866              .xpos:
 768  9866 FE 02                cp 2
 769  9868 30 0F                jr nc, .next                    ; |dx| >= 2 -> no overlap
 770  986A
 771  986A                      ; --- Y overlap: abs(player_tile_y - keyY) <= 1 ? ---
 772  986A 3A C9 8E             ld a, (player_tile_y)
 773  986D 91                   sub c                           ; A = py - ky
 774  986E 30 02                jr nc, .ypos
 775  9870 ED 44                neg
 776  9872              .ypos:
 777  9872 FE 02                cp 2
 778  9874 30 03                jr nc, .next                    ; |dy| >= 2 -> no overlap
 779  9876
 780  9876                      ; overlap on both axes -> collected this key
 781  9876 78                   ld a, b                         ; A = key index
 782  9877 37                   scf                             ; carry set = collected
 783  9878 C9                   ret
 784  9879
 785  9879              .next:
 786  9879 04                   inc b
 787  987A 78                   ld a, b
 788  987B FE 04                cp KEY_COUNT
 789  987D 20 D3                jr nz, .loop
 790  987F B7                   or a                            ; clear carry = nothing collected
 791  9880 C9                   ret
