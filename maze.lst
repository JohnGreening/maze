 528+ 840B E0                   db L2_WALL      ; 3  spare wall
 529+ 840C FC                   db L2_KEY       ; 4  key   -> yellow
 530+ 840D FC                   db L2_KEY       ; 5  key
 531+ 840E FC                   db L2_KEY       ; 6  key
