 853  9858             >; version 3, 19 t-states (21 t-states quicker than A)
 853  9858             >; simple 16-bit divide without the CALL/RET overhead
 853  9858 EB          >        EX DE, HL                                   ;                                                   4t
 853  9859 06 03       >        LD B, 3                                     ;                                                   7t
 853  985B ED 29       >        BSRA DE, B                                       ;                                                   8t
 854  985D 4B                   ld c, e                                     ; save in C, see newTile below
 855  985E
 856  985E DD 66 02             ld h, (ix +baddieRecord.highX)              ; get baddie X
 857  9861 DD 6E 01             ld l, (ix +baddieRecord.lowX)
 858  9864 22 79 91             ld (baddie_x), hl
 859  9867 7D                   ld a, l
 860  9868 E6 07                and 7
 861  986A FD 67                ld iyh, a
 862  986C                      DIV_HL_8B                                   ; div by 8 to get tile Y
 862  986C             >; version 3, 19 t-states (21 t-states quicker than A)
 862  986C             >; simple 16-bit divide without the CALL/RET overhead
 862  986C EB          >        EX DE, HL                                   ;                                                   4t
 862  986D 06 03       >        LD B, 3                                     ;                                                   7t
 862  986F ED 29       >        BSRA DE, B                                       ;                                                   8t
 863  9871 43                   ld b, e                                     ; save in B, see newTile below
 864  9872
 865  9872              ; Decide only when grid-aligned (iyh==0 AND iyl==0) - the only
 866  9872                      ; moment a turn is possible. "Tile changed" fired at the far tile
 867  9872                      ; edge when moving up/left, where the turn check is gated out.
 868  9872 FD 7C                ld a, iyh
 869  9874 FD B5                or iyl                                      ; both zero => on grid intersection
 870  9876 28 06                jr z, newTile                               ; aligned -> run the decision
 871  9878
 872  9878 DD 7E 07             ld a, (ix +baddieRecord.dir)                ; not aligned -> continue current dir
 873  987B C3 F0 98             jp gotDir                                   ; jump to do the move
