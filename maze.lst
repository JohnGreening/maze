1006  99CE              moveAvailable:
1007  99CE                      ; E = available-direction mask. Choose pick method by mode.
1008  99CE                      ; Read own-cell distance first (one field read) -> sets lastDist.
1009  99CE DD 46 05             ld b, (ix + baddieRecord.tileX)             ; B = tileX
1010  99D1 DD 4E 06             ld c, (ix + baddieRecord.tileY)             ; C = tileY
1011  99D4              ;        ld l, b
1012  99D4              ;        ld h, c
1013  99D4              ;        call getFieldByte                           ; A = own-cell distance
1014  99D4                      GET_WORLD_VALUE DFIELD_PAGE, USE_BC
1014  99D4             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
1014  99D4             >;
1014  99D4             >;       arg  is TILEMAP_PAGE
1014  99D4             >;            or DFIELD_PAGE
1014  99D4             >;
1014  99D4             >;       arg1 decides if input comes from BC or directly from HL
1014  99D4             >;            NB if directly from HL then L = tile X, H = tile Y
1014  99D4             >;
1014  99D4             >        if USE_BC = 0
1014  99D4 61          >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
1014  99D5             >                                                    ; put it in H (this is the same as multiplying by 256)
1014  99D5 68          >        ld l, b                                     ; read the X tile coordinate into L
1014  99D6             >                                                    ; Result: HL now holds tile_y * 256 + tile_x
1014  99D6             >                                                    ; This is the byte offset into "world" map.
1014  99D6             >        endif
1014  99D6             >
1014  99D6             >    ; STEP 2: Calculate which 8K physical page the data lives in
1014  99D6 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
1014  99D7 CB 3F       >        srl  a                                      ; divide by 2
1014  99D9 CB 3F       >        srl  a                                      ; divide by 2 again  → now /4
1014  99DB CB 3F       >        srl  a                                      ; /8
1014  99DD CB 3F       >        srl  a                                      ; /16
1014  99DF CB 3F       >        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
1014  99E1             >                                                    ; Why divide by 32?
1014  99E1             >                                                    ;   Each page is 8192 bytes.
1014  99E1             >                                                    ;   Each row is 256 bytes.
1014  99E1             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
1014  99E1             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
1014  99E1             >
1014  99E1 C6 2E       >        add  a, DFIELD_PAGE                                 ; add the starting page number
1014  99E3             >
1014  99E3 ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
1014  99E6             >
1014  99E6             >
1014  99E6             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
1014  99E6 7C          >        ld   a,h                                    ; get the high byte again
1014  99E7 E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
1014  99E9             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
1014  99E9             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
1014  99E9 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
1014  99EA             >
1014  99EA             >    ; STEP 4: add the page offset so we can read it
1014  99EA ED 34 00 C0 >        add  hl, $C000                              ; HL = $C000 + offset_inside_page
1014  99EE             >                                                    ; HL now points directly at the first byte we want to copy
1014  99EE 7E          >        ld a, (hl)                                  ; so get the byte
1015  99EF
1016  99EF DD 77 0A             ld (ix + baddieRecord.lastDist), a
1017  99F2 4F                   ld c, a                                     ; keep own distance in C for the mode test
1018  99F3                                                                  ; (B no longer needed; pickByField re-reads tileX/Y)
1019  99F3
1020  99F3 DD 7E 09             ld a, (ix + baddieRecord.mode)
1021  99F6 FE 02                cp mode_wander
1022  99F8 28 0F                jr z, .pickWander                           ; forced wander
1023  99FA
1024  99FA FE 01                cp mode_hunt
1025  99FC 28 05                jr z, .pickHunt                             ; forced hunt
1026  99FE
