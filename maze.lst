 470  957E              	    DIV_HL_8
 470  957E             >; simple 16-bit divide without the CALL/RET overhead
 470  957E CB 3C       >        srl h                                       ; divide by 2
 470  9580 CB 1D       >        rr l
 470  9582 CB 3C       >        srl h                                       ; divide by 4
 470  9584 CB 1D       >        rr l
 470  9586 CB 3C       >        srl h                                       ; divide by 8
 470  9588 CB 1D       >        rr l
 471  958A 4D           	    ld c, l
 472  958B              	    GET_WORLD_VALUE TILEMAP_PAGE, USE_BC
 472  958B             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 472  958B             >;
 472  958B             >;       arg  is TILEMAP_PAGE
 472  958B             >;            or DFIELD_PAGE
 472  958B             >;
 472  958B             >;       arg1 decides if input comes from BC or directly from HL
 472  958B             >;            NB if directly from HL then L = tile X, H = tile Y
 472  958B             >;
 472  958B             >        if USE_BC = 0
 472  958B 61          >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 472  958C             >                                                    ; put it in H (this is the same as multiplying by 256)
 472  958C 68          >        ld l, b                                     ; read the X tile coordinate into L
 472  958D             >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 472  958D             >                                                    ; This is the byte offset into "world" map.
 472  958D             >        endif
 472  958D             >
 472  958D             >    ; STEP 2: Calculate which 8K physical page the data lives in
 472  958D 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 472  958E CB 3F       >        srl  a                                      ; divide by 2
 472  9590 CB 3F       >        srl  a                                      ; divide by 2 again  → now /4
 472  9592 CB 3F       >        srl  a                                      ; /8
 472  9594 CB 3F       >        srl  a                                      ; /16
 472  9596 CB 3F       >        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 472  9598             >                                                    ; Why divide by 32?
 472  9598             >                                                    ;   Each page is 8192 bytes.
 472  9598             >                                                    ;   Each row is 256 bytes.
 472  9598             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 472  9598             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 472  9598             >
 472  9598 C6 28       >        add  a, TILEMAP_PAGE                                 ; add the starting page number
 472  959A             >
 472  959A ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 472  959D             >
 472  959D             >
 472  959D             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 472  959D 7C          >        ld   a,h                                    ; get the high byte again
 472  959E E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 472  95A0             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 472  95A0             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 472  95A0 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 472  95A1             >
 472  95A1             >    ; STEP 4: add the page offset so we can read it
 472  95A1 ED 34 00 C0 >        add  hl, $C000                              ; HL = $C000 + offset_inside_page
 472  95A5             >                                                    ; HL now points directly at the first byte we want to copy
 472  95A5 7E          >        ld a, (hl)                                  ; so get the byte
 473  95A6 FE 01        	    cp MAP_WALL
 474  95A8 C8           	    ret z
 475  95A9 0C           	    inc c
