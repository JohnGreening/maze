 508  965A
 509  965A 3A CE 8E             ld a, (cam_tx)                              ; get last player tile X
 510  965D B8                   cp b                                        ; compare with current
 511  965E 20 07                jr nz, copy_visible_window                  ; branch if different
 512  9660
 513  9660 3A CF 8E             ld a, (cam_ty)                              ; get last player tile Y
 514  9663 B9                   cp c                                        ; compare with current
 515  9664 20 01                jr nz, copy_visible_window                  ; branch if different
 516  9666
 517  9666 C9                   ret                                         ; otherwise return, hardware scroll is enough
 518  9667
 519  9667              copy_visible_window:
 520  9667 78                   ld a, b                                     ; get current player tile X
 521  9668 32 CE 8E             ld (cam_tx), a                              ; save it away
 522  966B 79                   ld a, c                                     ; get current player tile Y
 523  966C 32 CF 8E             ld (cam_ty), a                              ; save it away
 524  966F
 525  966F                  ; STEP 1: Build the starting linear offset in the world map
 526  966F 61                   ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 527  9670                                                                  ; put it in H (this is the same as multiplying cam_tile_y by 256)
 528  9670 68                   ld l, b                                     ; read the X tile coordinate into L
 529  9671                                                                  ; Result: HL now holds  cam_tile_y * 256 + cam_tile_x
 530  9671                                                                  ; This is the byte offset into "world" map.
 531  9671
 532  9671                  ; STEP 2: Calculate which 8K physical page the data lives in
 533  9671 7C                   ld   a, h                                   ; take the high byte of the offset (which is cam_tile_y)
 534  9672              ;        srl  a                                      ; divide by 2
 535  9672              ;        srl  a                                      ; divide by 2 again  → now /4
 536  9672              ;        srl  a                                      ; /8
 537  9672              ;        srl  a                                      ; /16
 538  9672              ;        srl  a                                      ; /32   ← this is the same as cam_tile_y ÷ 32
 539  9672              ; ------------------------------------------------------------------------
 540  9672              ; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
 541  9672              ; saves 21 t-state
 542  9672              ; ------------------------------------------------------------------------
 543  9672 07                   rlca
 544  9673 07                   rlca
 545  9674 07                   rlca
 546  9675 E6 07                and 7
 547  9677                                                                  ; Why divide by 32?
 548  9677                                                                  ;   Each page is 8192 bytes.
 549  9677                                                                  ;   Each row is 256 bytes.
 550  9677                                                                  ;   8192 ÷ 256 = exactly 32 rows per page.
 551  9677                                                                  ;   Therefore page number = 40 + (cam_tile_y ÷ 32)
 552  9677 C6 28                add  a,40                                   ; add the starting page number (your world map begins at page 40)
 553  9679 32 D0 8E             ld   (tilemapPage), a                       ; save the page number in register C for later
 554  967C
 555  967C                  ; STEP 3: Keep only the part of the address that fits inside one 8K page
 556  967C 7C                   ld   a,h                                    ; get the high byte again
 557  967D E6 1F                and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 558  967F                                                                  ; This is exactly the same as (cam_tile_y * 256 + cam_tile_x) modulo 8192
 559  967F                                                                  ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 560  967F 67                   ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 561  9680
 562  9680                  ; STEP 4: Page the correct 8K bank into slot 6 so we can read it
 563  9680 3A D0 8E             ld   a, (tilemapPage)                       ; A = page number we want
 564  9683 ED 92 56             nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 565  9686 01 00 C0             ld   bc,$C000                               ; $C000 is the start of slot 6
 566  9689 09                   add  hl,bc                                  ; HL = $C000 + offset_inside_page
 567  968A                                                                  ; HL now points directly at the first byte we want to copy
 568  968A
 569  968A                  ; STEP 5: Point DE at the hardware tilemap buffer (fixed location)
 570  968A 11 00 60             ld   de, tileMap                            ; destination is the hardware tilemap location
 571  968D
 572  968D                  ; STEP 6: Copy all 32 visible rows
 573  968D 01 00 05             ld   bc,40*32                               ; we need to copy 32 rows x 40 columns
 574  9690              .row_loop:
 575  9690              REPT 40
 576  9690 ED A0       >        LDI
 576  9692 ED A0       >        LDI
 576  9694 ED A0       >        LDI
 576  9696 ED A0       >        LDI
 576  9698 ED A0       >        LDI
 576  969A ED A0       >        LDI
 576  969C ED A0       >        LDI
 576  969E ED A0       >        LDI
