 260+ 8246 3A 75 93             ld a, (floodTargetY)                        ; get our target cell Y
 261+ 8249 57                   ld d, a                                     ; put in D
 262+ 824A 3A 74 93             ld a, (floodTargetX)                        ; get out target cell X
 263+ 824D 5F                   ld e, a                                     ; put in E
 264+ 824E
 265+ 824E 62                   ld h, d                                     ; Y also in H
 266+ 824F 6B                   ld l, e                                     ; X also in L
 267+ 8250 AF                   xor a                                       ; a = 0
 268+ 8251 CD FD 82             call putFieldByte                           ; field[target] = 0
 269+ 8254 CD 35 83             call qPushDE                                ; push target (d = y, e = x)
