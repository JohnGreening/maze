 954  99B7             >                                                    ; put it in H (this is the same as multiplying by 256)
 954  99B7 68          >        ld l, b                                     ; read the X tile coordinate into L
 954  99B8             >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 954  99B8             >                                                    ; This is the byte offset into "world" map.
 954  99B8             >        endif
 954  99B8             >
 954  99B8             >    ; STEP 2: Calculate which 8K physical page the data lives in
 954  99B8 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 954  99B9             >;        srl  a                                      ; divide by 2
 954  99B9             >;        srl  a                                      ; divide by 2 again  → now /4
 954  99B9             >;        srl  a                                      ; /8
