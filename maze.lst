 257+ 8244 FF           FILL_BYTE   db 255
 258+ 8245              DMA_PORT    equ $6B
 259+ 8245
 260+ 8245              dmaFillProg:
 261+ 8245 C3                   db $C3                  ; WR6  reset DMA
 262+ 8246 7D                   db $7D                  ; WR0  A->B, addr+len follow
 263+ 8247 44 82                dw FILL_BYTE            ; WR0  Port A start (the byte we smear)
 264+ 8249 00 20                dw 8192                 ; WR0  block length   (verify off-by-one on your core)
 265+ 824B 24                   db $24                  ; WR1  Port A = memory, FIXED  (no increment -> fill)
 266+ 824C 10                   db $10                  ; WR2  Port B = memory, increment
 267+ 824D AD                   db $AD                  ; WR4  continuous, Port B addr follows
 268+ 824E 00 C0                dw $C000               ; WR4  Port B start
 269+ 8250 82                   db $82                  ; WR5  /CE only, no auto-restart
 270+ 8251 CF                   db $CF                  ; WR6  LOAD
 271+ 8252 87                   db $87                  ; WR6  ENABLE (go)
 272+ 8253              dmaFillLen  equ $-dmaFillProg
 273+ 8253
 274+ 8253              clearFloodField:
 275+ 8253 F3                   di                              ; see below
 276+ 8254 3E 2E                ld a, DFIELD_PAGE               ; A = page   (OTIR leaves A alone)
 277+ 8256 1E 06                ld e, 6                         ; E = count  (OTIR leaves DE alone)
 278+ 8258              .pg:
 279+ 8258 ED 92 56             nextreg $56, a                  ; page field bank into slot 6
 280+ 825B 21 45 82             ld hl, dmaFillProg
 281+ 825E 01 6B 0E             ld bc, (dmaFillLen<<8) | DMA_PORT   ; B=len, C=$6B
 282+ 8261 ED B3                otir                            ; upload program + trigger fill
 283+ 8263 3C                   inc a
 284+ 8264 1D                   dec e
 285+ 8265 20 F1                jr nz, .pg
 286+ 8267 FB                   ei
 287+ 8268 C9                   ret
