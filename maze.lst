   1+ 8DF0              playsound:
   2+ 8DF0              ; Input : A = sound fx to play
   3+ 8DF0              ;
   4+ 8DF0              ; routine will choose next available channel and copy sound fx to that channel
   5+ 8DF0              ; IM2 will then process that data
   6+ 8DF0 E5                   PUSH HL
   7+ 8DF1 D5                   PUSH DE
   8+ 8DF2 C5                   PUSH BC
   9+ 8DF3
  10+ 8DF3 3D                   DEC A
  11+ 8DF4 87                   ADD A, A
  12+ 8DF5 87                   ADD A, A
  13+ 8DF6 87                   ADD A, A
  14+ 8DF7 87                   ADD A, A
  15+ 8DF8
  16+ 8DF8 21 24 8E             LD HL, sound1
  17+ 8DFB ED 31                ADD HL, A
  18+ 8DFD
  19+ 8DFD 3A 84 8E             LD A, (nextCH)                      ; whats the nextCH to use
  20+ 8E00 FE 00                CP 0                                ; is it 0?
  21+ 8E02 28 0B                JR Z, playCh1                       ; jump if so
  22+ 8E04 FE 01                CP 1                                ; is it 1?
  23+ 8E06 28 0C                JR Z, playCh2                       ; jump if so
  24+ 8E08 3E FF                LD A, 255                           ; its 2, set next so its 0
  25+ 8E0A 11 99 8E             LD DE, Ch3                          ; set AY channel to 3
  26+ 8E0D 18 08                JR play                             ; and branch to do the sound setup
  27+ 8E0F              playCh1:
  28+ 8E0F 11 85 8E             LD DE, Ch1                          ; set the AY channel to 1
  29+ 8E12 18 03                JR play                             ; and branch to do the sound setup
  30+ 8E14              playCh2:
  31+ 8E14 11 8F 8E             LD DE, Ch2                          ; set the AY channel to 2
  32+ 8E17              play:
  33+ 8E17 3C                   INC A                               ; roll on nextCH
  34+ 8E18 32 84 8E             LD (nextCH), A                      ; and save it
  35+ 8E1B 01 0A 00             LD BC, 10                           ; we copy 10 bytes of sound setup
  36+ 8E1E ED B0                LDIR                                ; do the copy
  37+ 8E20
  38+ 8E20 C1                   POP BC
  39+ 8E21 D1                   POP DE
  40+ 8E22 E1                   POP HL
  41+ 8E23 C9                   RET
