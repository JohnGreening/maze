 511  9756 CB 3C       >        srl h                                       ;                                                   8t
 511  9758 1F          >        rra                                         ;                                                   4t
 512  9759 4F                   ld c, a
 513  975A
 514  975A 3A 5A 8F             ld a, (cam_tx)                              ; get last player tile X
 515  975D B8                   cp b                                        ; compare with current
 516  975E 20 07                jr nz, copy_visible_window                  ; branch if different
 517  9760
 518  9760 3A 5B 8F             ld a, (cam_ty)                              ; get last player tile Y
 519  9763 B9                   cp c                                        ; compare with current
 520  9764 20 01                jr nz, copy_visible_window                  ; branch if different
 521  9766
 522  9766 C9                   ret                                         ; otherwise return, hardware scroll is enough
 523  9767
 524  9767              copy_visible_window:
 525  9767 78                   ld a, b                                     ; get current player tile X
 526  9768 32 5A 8F             ld (cam_tx), a                              ; save it away
 527  976B 79                   ld a, c                                     ; get current player tile Y
 528  976C 32 5B 8F             ld (cam_ty), a                              ; save it away
 529  976F
 530  976F                  ; STEP 1: Build the starting linear offset in the world map
 531  976F 61                   ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 532  9770                                                                  ; put it in H (this is the same as multiplying cam_tile_y by 256)
 533  9770 68                   ld l, b                                     ; read the X tile coordinate into L
 534  9771                                                                  ; Result: HL now holds  cam_tile_y * 256 + cam_tile_x
 535  9771                                                                  ; This is the byte offset into "world" map.
 536  9771
 537  9771                  ; STEP 2: Calculate which 8K physical page the data lives in
 538  9771 7C                   ld   a, h                                   ; take the high byte of the offset (which is cam_tile_y)
 539  9772              ;        srl  a                                      ; divide by 2
 540  9772              ;        srl  a                                      ; divide by 2 again  → now /4
 541  9772              ;        srl  a                                      ; /8
 542  9772              ;        srl  a                                      ; /16
 543  9772              ;        srl  a                                      ; /32   ← this is the same as cam_tile_y ÷ 32
 544  9772              ; ------------------------------------------------------------------------
 545  9772              ; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
 546  9772              ; saves 21 t-state
 547  9772              ; ------------------------------------------------------------------------
 548  9772 07                   rlca
 549  9773 07                   rlca
 550  9774 07                   rlca
 551  9775 E6 07                and 7
 552  9777                                                                  ; Why divide by 32?
 553  9777                                                                  ;   Each page is 8192 bytes.
 554  9777                                                                  ;   Each row is 256 bytes.
 555  9777                                                                  ;   8192 ÷ 256 = exactly 32 rows per page.
 556  9777                                                                  ;   Therefore page number = 40 + (cam_tile_y ÷ 32)
 557  9777 C6 28                add  a,40                                   ; add the starting page number (your world map begins at page 40)
 558  9779 32 5C 8F             ld   (tilemapPage), a                       ; save the page number in register C for later
 559  977C
 560  977C                  ; STEP 3: Keep only the part of the address that fits inside one 8K page
 561  977C 7C                   ld   a,h                                    ; get the high byte again
 562  977D E6 1F                and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 563  977F                                                                  ; This is exactly the same as (cam_tile_y * 256 + cam_tile_x) modulo 8192
 564  977F                                                                  ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 565  977F 67                   ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 566  9780
 567  9780                  ; STEP 4: Page the correct 8K bank into slot 6 so we can read it
 568  9780 3A 5C 8F             ld   a, (tilemapPage)                       ; A = page number we want
 569  9783 ED 92 56             nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 570  9786 01 00 C0             ld   bc,$C000                               ; $C000 is the start of slot 6
 571  9789 09                   add  hl,bc                                  ; HL = $C000 + offset_inside_page
 572  978A                                                                  ; HL now points directly at the first byte we want to copy
 573  978A
 574  978A                  ; STEP 5: Point DE at the hardware tilemap buffer (fixed location)
 575  978A 11 00 60             ld   de, tileMap                            ; destination is the hardware tilemap location
 576  978D
 577  978D                  ; STEP 6: Copy all 32 visible rows
 578  978D 01 00 05             ld   bc,40*32                               ; we need to copy 32 rows x 40 columns
 579  9790              .row_loop:
 580  9790              REPT 40
 581  9790 ED A0       >        LDI
 581  9792 ED A0       >        LDI
 581  9794 ED A0       >        LDI
 581  9796 ED A0       >        LDI
 581  9798 ED A0       >        LDI
 581  979A ED A0       >        LDI
