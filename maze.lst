 245+ 8237              ; ============================================================
 246+ 8237              ; floodFill - BFS from (floodTargetX,floodTargetY). Fills the
 247+ 8237              ; distance field: 0 at target, increasing outward, clamped at
 248+ 8237              ; 254. 255 = wall/unvisited/unreachable. INERT until called.
 249+ 8237              ; ============================================================
 250+ 8237              floodFill:
 251+ 8237 3E 00                ld a, 0                                     ; ready to initialise
 252+ 8239 32 65 93             ld (qHeadIdx), a                            ; set q head to 0
 253+ 823C 32 66 93             ld (qTailIdx), a                            ; set q tail to 0
 254+ 823F 32 67 93             ld (qCount), a                              ; set q depth to 0
