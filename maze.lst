1355  F380              ; ----------------------------------------------------------------
1356  F380              ; Tilemap data - 48 KB stored directly in Pages 40 - 45
1357  F380              ; ----------------------------------------------------------------
1358  F380              TILEMAP_PAGE    EQU     40
1359  F380
1360  F380              ; === Chunk 1 (bytes 0-16383) -> 8 KB Page 40/41 ===
1361  F380              MMU     6, TILEMAP_PAGE                             ; map page 40 into slot 6
1362  F380              MMU     7, TILEMAP_PAGE + 1                         ; map page 41 into slot 7
1363  F380              ORG     $C000
1364  C000              tilemap_part1:
1365  C000              INCBIN  "testmaze2.map", 0, 16384                    ; first 16 KB
1366  0000
1367  0000              ; === Chunk 2 (bytes 16384-32767) -> 8 KB Page 42/43 ===
1368  0000              MMU     6, TILEMAP_PAGE + 2
1369  0000              MMU     7, TILEMAP_PAGE + 3
1370  0000              ORG     $C000
1371  C000              tilemap_part2:
1372  C000              INCBIN  "testmaze2.map", 16384, 16384
1373  0000
1374  0000              ; === Chunk 3 (bytes 32768-49151) -> 8 KB Page 44/45 ===
1375  0000              MMU     6, TILEMAP_PAGE + 4
1376  0000              MMU     7, TILEMAP_PAGE + 5
1377  0000              ORG     $C000
1378  C000              tilemap_part3:
1379  C000              INCBIN  "testmaze2.map", 32768, 16384
1380  0000
1381  0000              ; ----------------------------------------------------------------
1382  0000              ; Distance field - 48 KB, one byte per maze cell (256x192).
1383  0000              ; Same layout as the map (256-byte rows) but in pages 46-51, so the
1384  0000              ; tile (x,y) -> address arithmetic is identical to GET_WORLD_VALUE
1385  0000              ; with base page DFIELD_PAGE instead of TILEMAP_PAGE.
1386  0000              ; Filled by the flood-fill; 255 = wall/unvisited/unreachable.
1387  0000              ; ----------------------------------------------------------------
1388  0000              DFIELD_PAGE     EQU     TILEMAP_PAGE + 6
1389  0000
1390  0000              ; reserve the six pages so they exist in the .nex (contents set at runtime)
1391  0000              MMU     6, DFIELD_PAGE
1392  0000              MMU     7, DFIELD_PAGE + 1
1393  0000              ORG     $C000
1394  C000              dfield_part1:
1395  C000 00 00 00...  DEFS    16384
1396  0000
1397  0000              MMU     6, DFIELD_PAGE + 2
1398  0000              MMU     7, DFIELD_PAGE + 3
1399  0000              ORG     $C000
1400  C000              dfield_part2:
1401  C000 00 00 00...  DEFS    16384
1402  0000
1403  0000              MMU     6, DFIELD_PAGE + 4
1404  0000              MMU     7, DFIELD_PAGE + 5
1405  0000              ORG     $C000
1406  C000              dfield_part3:
1407  C000 00 00 00...  DEFS    16384
1408  0000
1409  0000              ; --- radar / Layer 2 ---
1410  0000              L2_PAGE         equ DFIELD_PAGE + 6     ; Layer 2 image pages (52-57), after the field
1411  0000              L2_BANK16       equ L2_PAGE / 2         ; 16K bank number for reg $12 (=26)
1412  0000
1413  0000              MMU 6, L2_PAGE
1414  0000              MMU 7, L2_PAGE + 1
1415  0000              org $C000
1416  C000 00 00 00...  DEFS 16384
1417  0000
1418  0000              MMU 6, L2_PAGE + 2
1419  0000              MMU 7, L2_PAGE + 3
1420  0000              org $C000
1421  C000 00 00 00...  DEFS 16384
1422  0000
1423  0000              MMU 6, L2_PAGE + 4
1424  0000              MMU 7, L2_PAGE + 5
1425  0000              org $C000
1426  C000 00 00 00...  DEFS 16384
1427  0000
1428  0000              ; ----------------------------------------------------------------
1429  0000              ; Build the .nex file (automatically includes all used banks)
1430  0000              ; ----------------------------------------------------------------
1431  0000              SAVENEX OPEN "maze.nex", progStart, $FF40           ; entry point + stack
1432  0000              SAVENEX AUTO                                        ; include all pages we used
1433  0000              SAVENEX CLOSE
