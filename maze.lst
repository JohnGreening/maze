  33+ 7E67 80                   add a, b                                    ; add on the original index, e.g. 2 => 6
  34+ 7E68 ED 31                add hl, a                                   ; now we point to this keys data
  35+ 7E6A 56                   ld d, (hl)                                  ; get the tile x
  36+ 7E6B 23                   inc hl
