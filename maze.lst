 822  9828 B7                   or a
 823  9829 ED 52                sbc hl, de
 824  982B D0                   ret nc                                      ; |dx| >= threshold -> no hit (carry clear)
 825  982C
 826  982C                      ; --- Y: |player_py - baddie_y| < COLLIDE_DY ? ---
 827  982C 2A DE 8E             ld hl, (player_py)
 828  982F DD 5E 03             ld e, (ix + baddieRecord.lowY)
 829  9832 DD 56 04             ld d, (ix + baddieRecord.highY)
 830  9835 B7                   or a
 831  9836 ED 52                sbc hl, de
 832  9838 CB 7C                bit 7, h
 833  983A 28 07                jr z, .yAbs
 834  983C EB                   ex de, hl
 835  983D 21 00 00             ld hl, 0
 836  9840 B7                   or a
 837  9841 ED 52                sbc hl, de
