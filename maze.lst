 485  962B              ; ================================================
 486  962B                  ; FINE SCROLLING (pixel-level smooth scroll)
 487  962B                  ; Set hardware tilemap scroll registers using player_px/py
 488  962B                  ; ================================================
 489  962B CD FF 96             call wait_vblank
 490  962E
 491  962E 3A CA 8E             ld a, (cam_px)                              ; get LOW byte of camera X position
 492  9631 E6 07                and 7                                       ; keep only the bottom 3 bits (0-7 pixels)
 493  9633 ED 92 30             nextreg $30, a                              ; ← X fine offset (MUST be every frame)
 494  9636
 495  9636 3A CC 8E             ld a, (cam_py)                              ; get LOW byte of camera Y position
 496  9639 E6 07                and 7                                       ; keep only the bottom 3 bits (0-7 pixels)
 497  963B ED 92 31             nextreg $31, a                              ; ← Y fine offset (MUST be every frame)
 498  963E
