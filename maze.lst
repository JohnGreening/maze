 177+ F222 ED 53 F7 8F          LD (framePointer), DE               ; save in framePointer
 178+ F226 18 ED                JR mr0                              ; and test again !
 179+ F228              mr1:
 180+ F228 32 F6 8F             LD (frameCount), A                  ; save note length
 181+ F22B
