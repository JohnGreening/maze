 146+ 7F19                      GET_WORLD_VALUE TILEMAP_PAGE, USE_BC        ; (tx, ty)
 146+ 7F19             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 146+ 7F19             >;
 146+ 7F19             >;       arg  is TILEMAP_PAGE
 146+ 7F19             >;            or DFIELD_PAGE
 146+ 7F19             >;
 146+ 7F19             >;       arg1 decides if input comes from BC or directly from HL
 146+ 7F19             >;            NB if directly from HL then L = tile X, H = tile Y
 146+ 7F19             >;
 146+ 7F19             >        if USE_BC = 0
 146+ 7F19 61          >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 146+ 7F1A             >                                                    ; put it in H (this is the same as multiplying by 256)
 146+ 7F1A 68          >        ld l, b                                     ; read the X tile coordinate into L
 146+ 7F1B             >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 146+ 7F1B             >                                                    ; This is the byte offset into "world" map.
 146+ 7F1B             >        endif
 146+ 7F1B             >
 146+ 7F1B             >    ; STEP 2: Calculate which 8K physical page the data lives in
 146+ 7F1B 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 146+ 7F1C             >;        srl  a                                      ; divide by 2
 146+ 7F1C             >;        srl  a                                      ; divide by 2 again  → now /4
 146+ 7F1C             >;        srl  a                                      ; /8
 146+ 7F1C             >;        srl  a                                      ; /16
 146+ 7F1C             >;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 146+ 7F1C             >; ------------------------------------------------------------------------
 146+ 7F1C             >; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
 146+ 7F1C             >; saves 21 t-state
 146+ 7F1C             >; ------------------------------------------------------------------------
 146+ 7F1C 07          >        rlca
 146+ 7F1D 07          >        rlca
 146+ 7F1E 07          >        rlca
 146+ 7F1F E6 07       >        and 7
 146+ 7F21             >                                                    ; Why divide by 32?
 146+ 7F21             >                                                    ;   Each page is 8192 bytes.
 146+ 7F21             >                                                    ;   Each row is 256 bytes.
 146+ 7F21             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 146+ 7F21             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 146+ 7F21             >
 146+ 7F21 C6 28       >        add  a, TILEMAP_PAGE                                 ; add the starting page number
 146+ 7F23 32 D1 8E    >        ld (curWorldPage), a                        ; save page for subsequent reads - likely no need to reload
