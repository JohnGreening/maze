 407  9592              ; ============================================================
 408  9592              ; updateCameraXY - recompute camera from player, clamped to map.
 409  9592              ;   cam = player - CENTRE, then clamped to [0 .. CAM_MAX]
 410  9592              ; Low clamp: if (player - CENTRE) < 0  -> 0   (sign test)
 411  9592              ; High clamp: if value > CAM_MAX       -> CAM_MAX
 412  9592              ; ============================================================
 413  9592              updateCameraXY:
