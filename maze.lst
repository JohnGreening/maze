1079  9ADE 61          >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
1079  9ADF             >                                                    ; put it in H (this is the same as multiplying by 256)
1079  9ADF 68          >        ld l, b                                     ; read the X tile coordinate into L
1079  9AE0             >                                                    ; Result: HL now holds tile_y * 256 + tile_x
1079  9AE0             >                                                    ; This is the byte offset into "world" map.
1079  9AE0             >        endif
1079  9AE0             >
1079  9AE0             >    ; STEP 2: Calculate which 8K physical page the data lives in
1079  9AE0 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
1079  9AE1             >;        srl  a                                      ; divide by 2
1079  9AE1             >;        srl  a                                      ; divide by 2 again  → now /4
1079  9AE1             >;        srl  a                                      ; /8
1079  9AE1             >;        srl  a                                      ; /16
1079  9AE1             >;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
1079  9AE1             >; ------------------------------------------------------------------------
1079  9AE1             >; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
1079  9AE1             >; saves 21 t-state
1079  9AE1             >; ------------------------------------------------------------------------
1079  9AE1 07          >        rlca
1079  9AE2 07          >        rlca
1079  9AE3 07          >        rlca
1079  9AE4 E6 07       >        and 7
1079  9AE6             >                                                    ; Why divide by 32?
1079  9AE6             >                                                    ;   Each page is 8192 bytes.
1079  9AE6             >                                                    ;   Each row is 256 bytes.
1079  9AE6             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
1079  9AE6             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
1079  9AE6             >
1079  9AE6 C6 28       >        add  a, TILEMAP_PAGE                                 ; add the starting page number
1079  9AE8 32 D1 8E    >        ld (curWorldPage), a                        ; save page for subsequent reads - likely no need to reload
1079  9AEB ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
1079  9AEE             >
1079  9AEE             >
1079  9AEE             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
1079  9AEE 7C          >        ld   a,h                                    ; get the high byte again
1079  9AEF E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
1079  9AF1             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
1079  9AF1             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
1079  9AF1 F6 C0       >        or $C0                                      ; "add" page offset
1079  9AF3 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
1079  9AF4             >
1079  9AF4             >    ; STEP 4: read the byte
1079  9AF4             >                                                    ; HL now points directly at the first byte we want to copy
1079  9AF4 7E          >        ld a, (hl)                                  ; so get the byte
1079  9AF5 FE 01       >        cp MAP_WALL                                 ; is it a wall?
1079  9AF7 C8          >        ret z                                       ; return if so, do nothing
1079  9AF8             >
1079  9AF8             >; ----------------------------------------------------------------
1079  9AF8             >; worldAdjacent - read the map/field byte one tile to the right
1079  9AF8             >; GET_WORLD_VALUE just fetched. HL still points at that byte.
1079  9AF8             >; guaranteed to be on same page, so just inc HL
1079  9AF8             >; ----------------------------------------------------------------
