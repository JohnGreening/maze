 121+ 8195              ;===========================================================
 122+ 8195              ; routine called when player collides with a skull
 123+ 8195              ; it
 124+ 8195              ;   reduces health value and shows result
 125+ 8195              ;   on zero health, falls into lost life and shows result
 126+ 8195              ;===========================================================
 127+ 8195              takeDamage:
 128+ 8195 3A D2 8E             ld a, (playerHealth)                        ; get current health value
 129+ 8198 3D                   dec a                                       ; take damage !
 130+ 8199 32 D2 8E             ld (playerHealth), a                        ; set it back
 131+ 819C 5F                   ld e,  a                                    ; preserve in E
 132+ 819D
 133+ 819D 06 02                ld b, 2                                     ; set row 2
 134+ 819F 3A D3 8E             ld a, (healthBlock)                         ; get current health block
 135+ 81A2 C6 07                add a, 7                                    ; add starting column
 136+ 81A4 4F                   ld c, a                                     ; set column for display
 137+ 81A5 3E 88                ld a, 136                                   ; udg graphic to use, 136 is 0 length, 128 is full block strength
 138+ 81A7 93                   sub e                                       ; deduct current health block value
 139+ 81A8 CD 31 86             call displayChar                            ; display the char
 140+ 81AB 7B                   ld a, e                                     ; get health value back
 141+ 81AC A7                   and a                                       ; was it 0?
 142+ 81AD C0                   ret nz                                      ; return if not
 143+ 81AE
 144+ 81AE              ; block now empty -> redraw it as fully empty (136), then move left
 145+ 81AE 3E 08                ld a, initHealth                            ; full health block value
 146+ 81B0 32 D2 8E             ld (playerHealth), a                        ; set it
 147+ 81B3 3A D3 8E             ld a, (healthBlock)                         ; but health block value needs to reduce
 148+ 81B6 3D                   dec a                                       ; deduct 1
 149+ 81B7 32 D3 8E             ld (healthBlock), a                         ; save health block value
 150+ 81BA C0                   ret nz                                      ; return if still alive
