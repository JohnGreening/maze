 554+ 8421 07                   rlca
 555+ 8422 07                   rlca
 556+ 8423 07                   rlca
 557+ 8424 E6 07                and 7
 558+ 8426
 559+ 8426 47                   ld b, a                                     ; B = page offset (held for the whole row)
 560+ 8427
 561+ 8427 79                   ld a, c
 562+ 8428 E6 1F                and $1F                                     ; low 5 bits of Y = row within the 32-row page
 563+ 842A F6 C0                or $C0                                      ; high byte of slot-6 address = (Y&$1F) | $C0
 564+ 842C 67                   ld h, a                                     ; H = row-base high byte (constant this row)
 565+ 842D 2E 00                ld l, 0                                     ; L = X = 0  -> HL now = start of this row
