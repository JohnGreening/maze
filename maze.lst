  93+ 86B7              ; 8-Bit Binary to Decimal Digits Extraction
  94+ 86B7              ; Input:  A  = 8-bit binary number (0 - 255)
  95+ 86B7              ;         B  = char row (0..23), C = char col (0..31)
  96+ 86B7              ; Calls displayChar with A to display each digit
  97+ 86B7              Bin8ToDec:
  98+ 86B7              ; --- Step 1: Extract 100s Digit ---
  99+ 86B7 1E 2F                ld      e, '0' - 1                          ; Initialize ASCII counter
 100+ 86B9              .Loop100:
 101+ 86B9 1C                   inc     e                                   ; Increment ASCII character
 102+ 86BA D6 64                sub     100                                 ; Subtract 100
 103+ 86BC 30 FB                jr      nc, .Loop100                        ; Repeat if no underflow (result >= 0)
 104+ 86BE C6 64                add     a, 100                              ; Restore the remainder (add 100 back)
 105+ 86C0
 106+ 86C0 57                   ld      d, a                                ; Temporarily save remainder in B
 107+ 86C1 7B                   ld      a, e                                ; Get 100s digit
 108+ 86C2 CD 79 86             call displayChar
 109+ 86C5 7A                   ld      a, d                                ; Restore remainder to A
 110+ 86C6
 111+ 86C6              ; --- Step 2: Extract 10s Digit ---
 112+ 86C6 1E 2F                ld      e, '0' - 1                          ; Re-initialize ASCII counter
 113+ 86C8              .Loop10:
 114+ 86C8 1C                   inc     e                                   ; Increment ASCII character
 115+ 86C9 D6 0A                sub     10                                  ; Subtract 10
 116+ 86CB 30 FB                jr      nc, .Loop10                         ; Repeat if no underflow (result >= 0)
 117+ 86CD C6 0A                add     a, 10                               ; Restore the remainder (add 10 back)
 118+ 86CF
 119+ 86CF 57                   ld      d, a                                ; Temporarily save 1s digit in B
 120+ 86D0 7B                   ld      a, e                                ; Get 10s digit
 121+ 86D1 CD 79 86             call displayChar
 122+ 86D4
 123+ 86D4              ; --- Step 3: Extract 1s Digit ---
 124+ 86D4 7A                   ld      a, d                                ; Restore 1s digit to A
 125+ 86D5              DisplayDigit:
 126+ 86D5                      ; if calling from here then BC must be set with B=row, C=Column
 127+ 86D5 C6 30                add     a, '0'                              ; Convert the leftover 1s digit to ASCII
 128+ 86D7 CD 79 86             call displayChar
 129+ 86DA C9                   ret
