 261+ 824A 62                   ld h, d                                     ; Y also in H
 262+ 824B 6B                   ld l, e                                     ; X also in L
 263+ 824C AF                   xor a                                       ; a = 0
 264+ 824D CD F9 82             call putFieldByte                           ; field[target] = 0
 265+ 8250 CD 31 83             call qPushDE                                ; push target (d = y, e = x)
