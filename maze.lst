 254+ 8294              dmaFillProg:
 255+ 8294 C3                   db $C3                  ; WR6  reset DMA
 256+ 8295 7D                   db $7D                  ; WR0  A->B, addr+len follow
 257+ 8296 93 82                dw FILL_BYTE            ; WR0  Port A start (the byte we smear)
 258+ 8298 00 20                dw 8192                 ; WR0  block length   (verify off-by-one on your core)
 259+ 829A 24                   db $24                  ; WR1  Port A = memory, FIXED  (no increment -> fill)
 260+ 829B 10                   db $10                  ; WR2  Port B = memory, increment
 261+ 829C AD                   db $AD                  ; WR4  continuous, Port B addr follows
 262+ 829D 00 C0                dw $C000               ; WR4  Port B start
 263+ 829F 82                   db $82                  ; WR5  /CE only, no auto-restart
 264+ 82A0 CF                   db $CF                  ; WR6  LOAD
