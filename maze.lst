 450  955C              	    DIV_HL_8
 450  955C             >; simple 16-bit divide without the CALL/RET overhead
 450  955C CB 3C       >        srl h                                       ; divide by 2
 450  955E CB 1D       >        rr l
 450  9560 CB 3C       >        srl h                                       ; divide by 4
 450  9562 CB 1D       >        rr l
 450  9564 CB 3C       >        srl h                                       ; divide by 8
