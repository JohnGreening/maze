1170  9B7D ED 4B CC 8E          ld bc, (cam_py)             ; BC = player world Y
1171  9B81 B7                   or a                           ; clear carry
1172  9B82 ED 42                sbc hl, bc                     ; HL = baddieY - playerY  (signed)
1173  9B84                  ; centre + bias again: CENTER_SCREEN_Y + 15 = 120 + 15 = 135, fits in 8 bits.
1174  9B84 3E 0F                ld a, 15     ; A = 135
1175  9B86 ED 31                add hl, a                      ; Z80N: HL = biased screen Y
1176  9B88                  ; Visible-with-overhang: un-biased Y in -15..255, i.e. biased Y in 0..270.
1177  9B88 7C                   ld a, h                        ; high byte of biased Y
1178  9B89 FE 01                cp 1                           ; H = 0 ?
1179  9B8B 38 07                jr c, .yInRange                ; H = 0 -> <= 270, in range
1180  9B8D 20 2D                jr nz, .hidePop                ; H >= 2 -> off bottom
1181  9B8F                  ; H = 1: biased Y = 256..511, allowed only up to 270 ($010E),
1182  9B8F                  ; so low byte must be < 15 (270 - 256 = 14).
1183  9B8F 7D                   ld a, l
1184  9B90 FE 0F                cp 15
1185  9B92 30 28                jr nc, .hidePop                ; low byte >= 15 -> off bottom edge
1186  9B94              .yInRange:
1187  9B94                  ; ---------- BADDIE IS ON SCREEN ----------
1188  9B94                  ; Un-bias Y by 15 to get the real Y the hardware wants.
1189  9B94                  ; The sprite Y register is 8-bit and takes the value mod 256,
1190  9B94                  ; which is exactly what we need: a baddie 15px above the top
1191  9B94                  ; (real Y = -15) writes 241, and the hardware draws it overhanging.
1192  9B94 7D                   ld a, l                        ; low byte of biased Y
1193  9B95 D6 0F                sub 15                         ; A = real screen Y (mod 256)
1194  9B97 5F                   ld e, a                        ; stash Y in E for the moment
1195  9B98
1196  9B98 E1                   pop hl                         ; recover biased X
1197  9B99 01 0F 00             ld bc, 15
1198  9B9C B7                   or a                           ; clear carry
1199  9B9D ED 42                sbc hl, bc                     ; HL = real screen X (full 9-bit value)
