 798+ 85DA              ; ============================================================
 799+ 85DA              checkAnyKey:
 800+ 85DA 0E FE                ld c, $FE                   ; keyboard port low byte (constant)
 801+ 85DC 1E FE                ld e, $FE                   ; row-select pattern: one bit low, rotates
 802+ 85DE 16 08                ld d, 8                     ; 8 rows to check
 803+ 85E0              .scanRow:
 804+ 85E0 43                   ld b, e                     ; B = current row-select (high address byte)
 805+ 85E1 ED 78                in a, (c)                   ; read this half-row
 806+ 85E3 E6 1F                and $1F                     ; keep only the 5 key bits
 807+ 85E5 FE 1F                cp $1F                      ; all 1s = no key in this row
 808+ 85E7 20 07                jr nz, .pressed             ; a 0 bit = a key down -> pressed
 809+ 85E9 CB 03                rlc e                       ; rotate the zero bit to the next row
 810+ 85EB 15                   dec d
