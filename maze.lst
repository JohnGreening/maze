 578+ 83D6             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 578+ 83D6             >;
 578+ 83D6             >;       arg  is TILEMAP_PAGE
 578+ 83D6             >;            or DFIELD_PAGE
 578+ 83D6             >;
 578+ 83D6             >;       arg1 decides if input comes from BC or directly from HL
