1280  9CE3              displayBaddie:
1281  9CE3                  ; ============================================================
1282  9CE3                  ; Draw baddie sprite (sprite #1) relative to the centred player.
1283  9CE3                  ; Player is locked to screen centre, so:
1284  9CE3                  ;     screenPos = baddieWorldPos - playerWorldPos + screenCentre
1285  9CE3                  ; A 16x16 sprite is shown whenever ANY part overlaps the display,
1286  9CE3                  ; so we allow up to 15px of overhang at each edge before hiding.
1287  9CE3                  ; IX already points at the baddie record (set by processBaddies).
1288  9CE3                  ; ============================================================
1289  9CE3
1290  9CE3 3A 76 93             ld a, (viewMode)
1291  9CE6 B7                   or a
1292  9CE7 C2 59 9D             jp nz, radarBaddie
1293  9CEA
1294  9CEA                  ; ---------- SCREEN X ----------
1295  9CEA                      ; HL = baddie world X
1296  9CEA DD 6E 01             ld l, (ix + baddieRecord.lowX)
1297  9CED DD 66 02             ld h, (ix + baddieRecord.highX)
1298  9CF0 ED 4B BF 8E          ld bc, (cam_px)                             ; BC = player world X
1299  9CF4 B7                   or a                                        ; clear carry for a clean subtract
1300  9CF5 ED 42                sbc hl, bc                                  ; HL = baddieX - playerX  (signed)
1301  9CF7                  ; add screen centre AND the 15px overhang bias in one go.
1302  9CF7                  ; CENTER_SCREEN_X + 15 = 152 + 15 = 167, which fits in 8 bits,
1303  9CF7                  ; so we can use the Z80N "add hl,a" (cheaper to set up than add hl,bc).
1304  9CF7 3E 0F                ld a,  15                                   ; A = 167  (centre + bias)
1305  9CF9 ED 31                add hl, a                                   ; Z80N: HL = biased screen X
1306  9CFB                  ; HL now holds (screenX + 15). Visible-with-overhang means the
1307  9CFB                  ; UN-biased X is in -15..319, i.e. the BIASED value is in 0..334.
1308  9CFB                  ; Reject anything outside 0..334 with an unsigned range test.
1309  9CFB 7C                   ld a, h                                     ; look at high byte of biased X
1310  9CFC FE 01                cp 1                                        ; H = 0 ?  (biased X = 0..255)
1311  9CFE 38 07                jr c, .xInRange                             ; H = 0 -> definitely <= 334, in range
1312  9D00 20 4C                jr nz, .hideBaddie                          ; H >= 2 -> biased X >= 512 -> off right
1313  9D02                  ; H = 1 here, so biased X = 256..511; allowed only up to 334 ($014E),
1314  9D02                  ; meaning the low byte must be < 79 (334 - 256 = 78).
1315  9D02 7D                   ld a, l
1316  9D03 FE 4F                cp 79
1317  9D05 30 47                jr nc, .hideBaddie                          ; low byte >= 79 -> off right edge
1318  9D07              .xInRange:
1319  9D07 E5                   push hl                                     ; save biased X (we still need it later)
1320  9D08
1321  9D08                  ; ---------- SCREEN Y ----------
1322  9D08                  ; HL = baddie world Y
1323  9D08 DD 6E 03             ld l, (ix + baddieRecord.lowY)
1324  9D0B DD 66 04             ld h, (ix + baddieRecord.highY)
1325  9D0E ED 4B C1 8E          ld bc, (cam_py)             ; BC = player world Y
1326  9D12 B7                   or a                           ; clear carry
1327  9D13 ED 42                sbc hl, bc                     ; HL = baddieY - playerY  (signed)
1328  9D15                  ; centre + bias again: CENTER_SCREEN_Y + 15 = 120 + 15 = 135, fits in 8 bits.
1329  9D15 3E 0F                ld a, 15     ; A = 135
1330  9D17 ED 31                add hl, a                      ; Z80N: HL = biased screen Y
1331  9D19                  ; Visible-with-overhang: un-biased Y in -15..255, i.e. biased Y in 0..270.
1332  9D19 7C                   ld a, h                        ; high byte of biased Y
1333  9D1A FE 01                cp 1                           ; H = 0 ?
1334  9D1C 38 07                jr c, .yInRange                ; H = 0 -> <= 270, in range
1335  9D1E 20 2D                jr nz, .hidePop                ; H >= 2 -> off bottom
1336  9D20                  ; H = 1: biased Y = 256..511, allowed only up to 270 ($010E),
1337  9D20                  ; so low byte must be < 15 (270 - 256 = 14).
1338  9D20 7D                   ld a, l
1339  9D21 FE 0F                cp 15
1340  9D23 30 28                jr nc, .hidePop                ; low byte >= 15 -> off bottom edge
1341  9D25              .yInRange:
1342  9D25                  ; ---------- BADDIE IS ON SCREEN ----------
1343  9D25                  ; Un-bias Y by 15 to get the real Y the hardware wants.
1344  9D25                  ; The sprite Y register is 8-bit and takes the value mod 256,
1345  9D25                  ; which is exactly what we need: a baddie 15px above the top
1346  9D25                  ; (real Y = -15) writes 241, and the hardware draws it overhanging.
1347  9D25 7D                   ld a, l                        ; low byte of biased Y
1348  9D26 D6 0F                sub 15                         ; A = real screen Y (mod 256)
1349  9D28 5F                   ld e, a                        ; stash Y in E for the moment
1350  9D29
1351  9D29 E1                   pop hl                         ; recover biased X
1352  9D2A 01 0F 00             ld bc, 15
1353  9D2D B7                   or a                           ; clear carry
1354  9D2E ED 42                sbc hl, bc                     ; HL = real screen X (full 9-bit value)
1355  9D30
1356  9D30                  ; ---------- WRITE SPRITE 1 ----------
1357  9D30 DD 7E 00             ld a, (ix +baddieRecord.index)
1358  9D33 ED 92 34             NEXTREG $34, a                 ; select sprite slot 1
1359  9D36 7D                   ld a, l
1360  9D37 ED 92 35             NEXTREG $35, a                 ; attr 0: X low 8 bits
1361  9D3A 7B                   ld a, e
1362  9D3B ED 92 36             NEXTREG $36, a                 ; attr 1: Y (8-bit)
1363  9D3E 7C                   ld a, h
1364  9D3F E6 01                and 1                          ; X is 9-bit; keep only bit 8
1365  9D41 ED 92 37             NEXTREG $37, a                 ; attr 2: X MSB in bit 0
1366  9D44 DD 7E 08             ld a, (ix + baddieRecord.pattern)
1367  9D47 F6 80                or %10000000                   ; bit 7 = visible
1368  9D49 ED 92 38             NEXTREG $38, a                 ; attr 3: pattern + visible flag
1369  9D4C
1370  9D4C C9                   ret
1371  9D4D
1372  9D4D              .hidePop:
1373  9D4D E1                   pop hl                         ; balance the stack (biased X was pushed)
1374  9D4E              .hideBaddie:
1375  9D4E DD 7E 00             ld a, (ix +baddieRecord.index)
1376  9D51 ED 92 34             NEXTREG $34, a                 ; select sprite slot 1
1377  9D54 ED 91 38 00          NEXTREG $38, 0                 ; clear visible bit -> sprite hidden
1378  9D58
1379  9D58 C9                   ret
