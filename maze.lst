 288+ 82B8              ; ---- push cell in BC (B=Y, C=X) onto the ring ----
 289+ 82B8              ; corrupts A, HL ; preserves DE
 290+ 82B8              MACRO QPUSH_BC
 291+ 82B8 ~                    ld a, (qTailL)
 292+ 82B8 ~                    ld l, a
 293+ 82B8 ~                    ld h, high floodQueue
 294+ 82B8 ~                    ld (hl), c                  ; store X
 295+ 82B8 ~                    inc l
 296+ 82B8 ~                    ld (hl), b                  ; store Y
 297+ 82B8 ~                    inc l
 298+ 82B8 ~                    ld a, l
 299+ 82B8 ~                    ld (qTailL), a
 300+ 82B8 ~                    ld hl, qCount
 301+ 82B8 ~                    inc (hl)
 302+ 82B8                      ENDM
 303+ 82B8
 304+ 82B8              ; ---- push cell in DE (D=Y, E=X) onto the ring ----
 305+ 82B8              ; corrupts A, HL ; preserves DE
 306+ 82B8              MACRO QPUSH_DE
 307+ 82B8 ~                    ld a, (qTailL)
 308+ 82B8 ~                    ld l, a
 309+ 82B8 ~                    ld h, high floodQueue       ; constant page base
 310+ 82B8 ~                    ld (hl), e                  ; store X
 311+ 82B8 ~                    inc l                       ; wraps 255->0 within the page
 312+ 82B8 ~                    ld (hl), d                  ; store Y
 313+ 82B8 ~                    inc l                       ; -> next slot (free 128-entry wrap)
 314+ 82B8 ~                    ld a, l
 315+ 82B8 ~                    ld (qTailL), a
 316+ 82B8 ~                    ld hl, qCount
 317+ 82B8 ~                    inc (hl)
 318+ 82B8                      ENDM
 319+ 82B8
 320+ 82B8              ; ---- pop cell from the ring into DE (D=Y, E=X) ----
 321+ 82B8              ; corrupts A, HL
 322+ 82B8              MACRO QPOP_DE
 323+ 82B8 ~                    ld a, (qHeadL)
 324+ 82B8 ~                    ld l, a
 325+ 82B8 ~                    ld h, high floodQueue
 326+ 82B8 ~                    ld e, (hl)                  ; X
 327+ 82B8 ~                    inc l
 328+ 82B8 ~                    ld d, (hl)                  ; Y
 329+ 82B8 ~                    inc l
 330+ 82B8 ~                    ld a, l
 331+ 82B8 ~                    ld (qHeadL), a
 332+ 82B8 ~                    ld hl, qCount
 333+ 82B8 ~                    dec (hl)
 334+ 82B8                      ENDM
 335+ 82B8
 336+ 82B8              MACRO TRY_CELL
 337+ 82B8 ~            ; test one of the x +/- 1, y+/- 1 tiles
 338+ 82B8 ~            ; here DE = yx of the tile taken off the queue
 339+ 82B8 ~            ;      HL = tile being tested, i.e. +/- 1 of x or y
 340+ 82B8 ~                    ld b, h                                     ; temp preserve h = tile Y being tested
 341+ 82B8 ~                    ld c, l                                     ; temp preserve l = tile X being tested
 342+ 82B8 ~                    GET_WORLD_VALUE TILEMAP_PAGE, USE_HL        ; get tile at this tested location
 343+ 82B8 ~                    cp MAP_WALL                                 ; is it a wall?
 344+ 82B8 ~                    jr z, .tcDone                               ; branch if its a wall, done
 345+ 82B8 ~
 346+ 82B8 ~                    ; get distance value for this tile. Page in the equivalent distance field data
 347+ 82B8 ~                    ld a, (curWorldPage)
 348+ 82B8 ~                    add a, DFIELD_PAGE - TILEMAP_PAGE
 349+ 82B8 ~                    nextreg $56, a
 350+ 82B8 ~                    ld a, (hl)                                  ; get distance field for this tile
 351+ 82B8 ~
 352+ 82B8 ~            ;        cp 255                                      ; is it untouched? i.e. path but value = 255
 353+ 82B8 ~            ; performance tweak, saves 3 t-states !
 354+ 82B8 ~                    inc a
 355+ 82B8 ~                    jr nz, .tcDone                              ; branch if we've already visited this tile
 356+ 82B8 ~
 357+ 82B8 ~                    ld a, (dist)                                ; get distance for original tile XY (from mainloop)
 358+ 82B8 ~                    cp 254                                      ; is it already at max
 359+ 82B8 ~                    jr nc, .clampMax                            ; C >= 254 -> store 254
 360+ 82B8 ~                    inc a                                       ; C+1
 361+ 82B8 ~                    jr .storeDist
 362+ 82B8 ~            .clampMax:
 363+ 82B8 ~                    ld a, 254
 364+ 82B8 ~            .storeDist:
 365+ 82B8 ~                    ld (hl), a                                  ; set distance for this tile
 366+ 82B8 ~                    QPUSH_BC                                ; push this tested tile onto the queue
 367+ 82B8 ~            .tcDone:
 368+ 82B8                      ENDM                                         ; done
