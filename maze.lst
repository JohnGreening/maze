  81+ 86B6 77                   ld (hl), a                                  ; put it onto ULA
  82+ 86B7 13                   inc de                                      ; next row
  83+ 86B8 24                   inc h                                       ; down one pixel line within the cell
  84+ 86B9 10 FA                djnz dcLine                                 ; loop for all 8 lines
  85+ 86BB D1                   pop de
