   1+ 8E93              playsound:
   2+ 8E93              ; Input : A = sound fx to play
   3+ 8E93              ;
   4+ 8E93              ; routine will choose next available channel and copy sound fx to that channel
   5+ 8E93              ; IM2 will then process that data
   6+ 8E93 E5                   PUSH HL
   7+ 8E94 D5                   PUSH DE
   8+ 8E95 C5                   PUSH BC
   9+ 8E96
  10+ 8E96 3D                   DEC A
  11+ 8E97 87                   ADD A, A
  12+ 8E98 87                   ADD A, A
  13+ 8E99 87                   ADD A, A
  14+ 8E9A 87                   ADD A, A
  15+ 8E9B
  16+ 8E9B 21 C7 8E             LD HL, sound1
  17+ 8E9E ED 31                ADD HL, A
  18+ 8EA0
  19+ 8EA0 3A 27 8F             LD A, (nextCH)                      ; whats the nextCH to use
  20+ 8EA3 FE 00                CP 0                                ; is it 0?
  21+ 8EA5 28 0B                JR Z, playCh1                       ; jump if so
  22+ 8EA7 FE 01                CP 1                                ; is it 1?
  23+ 8EA9 28 0C                JR Z, playCh2                       ; jump if so
  24+ 8EAB 3E FF                LD A, 255                           ; its 2, set next so its 0
  25+ 8EAD 11 3C 8F             LD DE, Ch3                          ; set AY channel to 3
  26+ 8EB0 18 08                JR play                             ; and branch to do the sound setup
  27+ 8EB2              playCh1:
  28+ 8EB2 11 28 8F             LD DE, Ch1                          ; set the AY channel to 1
  29+ 8EB5 18 03                JR play                             ; and branch to do the sound setup
  30+ 8EB7              playCh2:
  31+ 8EB7 11 32 8F             LD DE, Ch2                          ; set the AY channel to 2
  32+ 8EBA              play:
  33+ 8EBA 3C                   INC A                               ; roll on nextCH
  34+ 8EBB 32 27 8F             LD (nextCH), A                      ; and save it
  35+ 8EBE 01 0A 00             LD BC, 10                           ; we copy 10 bytes of sound setup
  36+ 8EC1 ED B0                LDIR                                ; do the copy
  37+ 8EC3
  38+ 8EC3 C1                   POP BC
  39+ 8EC4 D1                   POP DE
  40+ 8EC5 E1                   POP HL
  41+ 8EC6 C9                   RET
