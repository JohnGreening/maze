   8  8DFC              INCLUDE "soundEffects.inc"
# file opened: soundEffects.inc
   1+ 8DFC              playsound:
   2+ 8DFC              ; Input : A = sound fx to play
   3+ 8DFC              ;
   4+ 8DFC              ; routine will choose next available channel and copy sound fx to that channel
   5+ 8DFC              ; IM2 will then process that data
   6+ 8DFC E5                   PUSH HL
   7+ 8DFD D5                   PUSH DE
   8+ 8DFE C5                   PUSH BC
   9+ 8DFF
  10+ 8DFF 3D                   DEC A
  11+ 8E00 87                   ADD A, A
  12+ 8E01 87                   ADD A, A
  13+ 8E02 87                   ADD A, A
  14+ 8E03 87                   ADD A, A
  15+ 8E04
  16+ 8E04 21 30 8E             LD HL, sound1
  17+ 8E07 ED 31                ADD HL, A
  18+ 8E09
  19+ 8E09 3A 90 8E             LD A, (nextCH)                      ; whats the nextCH to use
  20+ 8E0C FE 00                CP 0                                ; is it 0?
  21+ 8E0E 28 0B                JR Z, playCh1                       ; jump if so
  22+ 8E10 FE 01                CP 1                                ; is it 1?
  23+ 8E12 28 0C                JR Z, playCh2                       ; jump if so
  24+ 8E14 3E FF                LD A, 255                           ; its 2, set next so its 0
  25+ 8E16 11 A5 8E             LD DE, Ch3                          ; set AY channel to 3
  26+ 8E19 18 08                JR play                             ; and branch to do the sound setup
  27+ 8E1B              playCh1:
  28+ 8E1B 11 91 8E             LD DE, Ch1                          ; set the AY channel to 1
  29+ 8E1E 18 03                JR play                             ; and branch to do the sound setup
  30+ 8E20              playCh2:
  31+ 8E20 11 9B 8E             LD DE, Ch2                          ; set the AY channel to 2
  32+ 8E23              play:
  33+ 8E23 3C                   INC A                               ; roll on nextCH
  34+ 8E24 32 90 8E             LD (nextCH), A                      ; and save it
  35+ 8E27 01 0A 00             LD BC, 10                           ; we copy 10 bytes of sound setup
  36+ 8E2A ED B0                LDIR                                ; do the copy
  37+ 8E2C
  38+ 8E2C C1                   POP BC
  39+ 8E2D D1                   POP DE
  40+ 8E2E E1                   POP HL
  41+ 8E2F C9                   RET
