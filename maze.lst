 547+ 84E0              tileColour:
 548+ 84E0 00                   db L2_PATH      ; 0  path  (entry unused - path goes through flood check)
 549+ 84E1 E0                   db L2_WALL      ; 1  wall  -> red
 550+ 84E2 E0                   db L2_WALL      ; 2  spare wall
 551+ 84E3 E0                   db L2_WALL      ; 3  spare wall
 552+ 84E4 FC                   db L2_KEY       ; 4  key   -> yellow
 553+ 84E5 FC                   db L2_KEY       ; 5  key
 554+ 84E6 FC                   db L2_KEY       ; 6  key
 555+ 84E7 FC                   db L2_KEY       ; 7  key
