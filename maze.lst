 469  964A 01 02 00    >        ld bc, move_delta                         ; move pixel delta
 469  964D 09          >        add hl, bc                                  ; simulate move Right
 469  964E ED 34 0F 00 >        add hl, 15                                  ; the sprite extends 0-15px right
