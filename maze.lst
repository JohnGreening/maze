 272+ 8258                      ; qPopDE is only called from here
 273+ 8258                      ; it's effectively the driver for the processing for this tile
 274+ 8258 CD 4E 83             call qPopDE                                 ; DE = current cell (D=y, E=x)
 275+ 825B 43                   ld b, e                                     ; b = X    ** note opposite of DE
 276+ 825C 4A                   ld c, d                                     ; c = Y
