1173  9B86 CB 3F       >        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
1173  9B88             >                                                    ; Why divide by 32?
1173  9B88             >                                                    ;   Each page is 8192 bytes.
1173  9B88             >                                                    ;   Each row is 256 bytes.
1173  9B88             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
1173  9B88             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
1173  9B88             >
1173  9B88 C6 28       >        add  a, TILEMAP_PAGE                                 ; add the starting page number
1173  9B8A             >
1173  9B8A ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
1173  9B8D             >
1173  9B8D             >
1173  9B8D             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
1173  9B8D 7C          >        ld   a,h                                    ; get the high byte again
1173  9B8E E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
1173  9B90             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
1173  9B90             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
1173  9B90 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
1173  9B91             >
1173  9B91             >    ; STEP 4: add the page offset so we can read it
1173  9B91 ED 34 00 C0 >        add  hl, $C000                              ; HL = $C000 + offset_inside_page
1173  9B95             >                                                    ; HL now points directly at the first byte we want to copy
1173  9B95 7E          >        ld a, (hl)                                  ; so get the byte
1174  9B96 FE 01                cp MAP_WALL
1175  9B98 C8                   ret z
1176  9B99 0C                   inc c
