 177+ 87AD             >;       arg1 decides if input comes from BC or directly from HL
 177+ 87AD             >;            NB if directly from HL then L = tile X, H = tile Y
 177+ 87AD             >;
 177+ 87AD             >        if USE_HL = 0
 177+ 87AD ~           >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 177+ 87AD ~           >                                                    ; put it in H (this is the same as multiplying by 256)
 177+ 87AD ~           >        ld l, b                                     ; read the X tile coordinate into L
 177+ 87AD ~           >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 177+ 87AD ~           >                                                    ; This is the byte offset into "world" map.
 177+ 87AD             >        endif
 177+ 87AD             >
 177+ 87AD             >    ; STEP 2: Calculate which 8K physical page the data lives in
 177+ 87AD 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 177+ 87AE             >;        srl  a                                      ; divide by 2
 177+ 87AE             >;        srl  a                                      ; divide by 2 again  → now /4
 177+ 87AE             >;        srl  a                                      ; /8
 177+ 87AE             >;        srl  a                                      ; /16
 177+ 87AE             >;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 177+ 87AE             >; ------------------------------------------------------------------------
 177+ 87AE             >; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
 177+ 87AE             >; saves 21 t-state
 177+ 87AE             >; ------------------------------------------------------------------------
 177+ 87AE 07          >        rlca
 177+ 87AF 07          >        rlca
 177+ 87B0 07          >        rlca
 177+ 87B1 E6 07       >        and 7
 177+ 87B3             >                                                    ; Why divide by 32?
 177+ 87B3             >                                                    ;   Each page is 8192 bytes.
 177+ 87B3             >                                                    ;   Each row is 256 bytes.
 177+ 87B3             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 177+ 87B3             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 177+ 87B3             >
 177+ 87B3 C6 2E       >        add  a, DFIELD_PAGE                                 ; add the starting page number
 177+ 87B5 32 6B 8F    >        ld (curWorldPage), a                        ; save page for subsequent reads - likely no need to reload
 177+ 87B8 ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 177+ 87BB             >
 177+ 87BB             >
 177+ 87BB             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 177+ 87BB 7C          >        ld   a,h                                    ; get the high byte again
 177+ 87BC E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 177+ 87BE             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 177+ 87BE             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 177+ 87BE F6 C0       >        or $C0                                      ; "add" page offset
 177+ 87C0 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 177+ 87C1             >
 177+ 87C1             >    ; STEP 4: read the byte
 177+ 87C1             >                                                    ; HL now points directly at the first byte we want to copy
 177+ 87C1 7E          >        ld a, (hl)                                  ; so get the byte
 178+ 87C2 CD 09 87             call Bin8ToDec
 179+ 87C5 E1                   pop hl
 180+ 87C6 C9                   ret
 181+ 87C7
 182+ 87C7              getTileY
 183+ 87C7 2A 78 8F             ld hl, (player_py)
 184+ 87CA                      DIV_HL_8
 184+ 87CA             >; version 1, 48 t-states
 184+ 87CA             >; simple 16-bit divide without the CALL/RET overhead
 184+ 87CA CB 3C       >        srl h                                       ; divide by 2
 184+ 87CC CB 1D       >        rr l
 184+ 87CE CB 3C       >        srl h                                       ; divide by 4
 184+ 87D0 CB 1D       >        rr l
 184+ 87D2 CB 3C       >        srl h                                       ; divide by 8
 184+ 87D4 CB 1D       >        rr l
 185+ 87D6 7D                   ld a, l
 186+ 87D7 C9                   ret
 187+ 87D8
 188+ 87D8              getTileX
 189+ 87D8 2A 76 8F             ld hl, (player_px)
 190+ 87DB                      DIV_HL_8
 190+ 87DB             >; version 1, 48 t-states
 190+ 87DB             >; simple 16-bit divide without the CALL/RET overhead
 190+ 87DB CB 3C       >        srl h                                       ; divide by 2
 190+ 87DD CB 1D       >        rr l
 190+ 87DF CB 3C       >        srl h                                       ; divide by 4
 190+ 87E1 CB 1D       >        rr l
 190+ 87E3 CB 3C       >        srl h                                       ; divide by 8
 190+ 87E5 CB 1D       >        rr l
 191+ 87E7 7D                   ld a, l
 192+ 87E8 C9                   ret
