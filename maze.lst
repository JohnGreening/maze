 289+ 82B8              ; ============================================================
 290+ 82B8              ; floodFill - BFS from (floodTargetX,floodTargetY). Fills the
 291+ 82B8              ; distance field: 0 at target, increasing outward, clamped at
 292+ 82B8              ; 254. 255 = wall/unvisited/unreachable. INERT until called.
 293+ 82B8              ; ============================================================
 294+ 82B8              floodFill:
 295+ 82B8 3E 00                ld a, 0                                     ; ready to initialise
 296+ 82BA 32 00 94             ld (qHeadL), a                              ; set q head to 0
 297+ 82BD 32 01 94             ld (qTailL), a                              ; set q tail to 0
 298+ 82C0 32 02 94             ld (qCount), a                              ; set q depth to 0
