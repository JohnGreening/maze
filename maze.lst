 152+ 86B1                      GET_WORLD_VALUE DFIELD_PAGE, USE_HL
 152+ 86B1             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 152+ 86B1             >;
 152+ 86B1             >;       arg  is TILEMAP_PAGE
 152+ 86B1             >;            or DFIELD_PAGE
 152+ 86B1             >;
 152+ 86B1             >;       arg1 decides if input comes from BC or directly from HL
 152+ 86B1             >;            NB if directly from HL then L = tile X, H = tile Y
 152+ 86B1             >;
 152+ 86B1             >        if USE_HL = 0
 152+ 86B1 ~           >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 152+ 86B1 ~           >                                                    ; put it in H (this is the same as multiplying by 256)
 152+ 86B1 ~           >        ld l, b                                     ; read the X tile coordinate into L
 152+ 86B1 ~           >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 152+ 86B1 ~           >                                                    ; This is the byte offset into "world" map.
 152+ 86B1             >        endif
 152+ 86B1             >
 152+ 86B1             >    ; STEP 2: Calculate which 8K physical page the data lives in
 152+ 86B1 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 152+ 86B2             >;        srl  a                                      ; divide by 2
 152+ 86B2             >;        srl  a                                      ; divide by 2 again  → now /4
 152+ 86B2             >;        srl  a                                      ; /8
 152+ 86B2             >;        srl  a                                      ; /16
 152+ 86B2             >;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 152+ 86B2             >; ------------------------------------------------------------------------
 152+ 86B2             >; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
 152+ 86B2             >; saves 21 t-state
 152+ 86B2             >; ------------------------------------------------------------------------
 152+ 86B2 07          >        rlca
 152+ 86B3 07          >        rlca
 152+ 86B4 07          >        rlca
 152+ 86B5 E6 07       >        and 7
 152+ 86B7             >                                                    ; Why divide by 32?
 152+ 86B7             >                                                    ;   Each page is 8192 bytes.
 152+ 86B7             >                                                    ;   Each row is 256 bytes.
 152+ 86B7             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 152+ 86B7             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 152+ 86B7             >
 152+ 86B7 C6 2E       >        add  a, DFIELD_PAGE                                 ; add the starting page number
 152+ 86B9 32 D1 8E    >        ld (curWorldPage), a                        ; save page for subsequent reads - likely no need to reload
 152+ 86BC ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 152+ 86BF             >
 152+ 86BF             >
 152+ 86BF             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 152+ 86BF 7C          >        ld   a,h                                    ; get the high byte again
 152+ 86C0 E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 152+ 86C2             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 152+ 86C2             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 152+ 86C2 F6 C0       >        or $C0                                      ; "add" page offset
 152+ 86C4 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 152+ 86C5             >
 152+ 86C5             >    ; STEP 4: read the byte
 152+ 86C5             >                                                    ; HL now points directly at the first byte we want to copy
 152+ 86C5 7E          >        ld a, (hl)                                  ; so get the byte
