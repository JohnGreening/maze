1425  0000              org $C000
1426  C000 00 00 00...  DEFS 16384
1427  0000
1428  0000              ; ----------------------------------------------------------------
1429  0000              ; Build the .nex file (automatically includes all used banks)
1430  0000              ; ----------------------------------------------------------------
1431  0000              SAVENEX OPEN "maze.nex", progStart, $FF40           ; entry point + stack
1432  0000              SAVENEX AUTO                                        ; include all pages we used
1433  0000              SAVENEX CLOSE
