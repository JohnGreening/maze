 639  973B
 640  973B
 641  973B AF                   xor a                                       ; sprite index = 0
 642  973C ED 92 34             NEXTREG $34, A
 643  973F 2A DC 8E             ld hl, (player_px)
 644  9742 ED 4B CA 8E          ld bc, (cam_px)
 645  9746 ED 42                sbc hl, bc
 646  9748 5C                   ld e, h
 647  9749
 648  9749 7D                   LD A, l                                     ; set the low byte of player X
 649  974A ED 92 35             NEXTREG $35, A
 650  974D
 651  974D 2A DE 8E             ld hl, (player_py)
 652  9750 ED 4B CC 8E          ld bc, (cam_py)
 653  9754 ED 42                sbc hl, bc
 654  9756
 655  9756 7D                   LD A, l                                     ; set the low byte of player Y
 656  9757 ED 92 36             NEXTREG $36, A
 657  975A 7B                   LD A, e                                     ; get the high byte of player X
 658  975B E6 01                AND 1                                       ; we only need bit 0
 659  975D ED 92 37             NEXTREG $37, A                              ; set it
