1349  F380              ; Tilemap data - 48 KB stored directly in Pages 40 - 45
1350  F380              ; ----------------------------------------------------------------
1351  F380              TILEMAP_PAGE    EQU     40
1352  F380
1353  F380              ; === Chunk 1 (bytes 0-16383) -> 8 KB Page 40/41 ===
1354  F380              MMU     6, TILEMAP_PAGE                             ; map page 40 into slot 6
1355  F380              MMU     7, TILEMAP_PAGE + 1                         ; map page 41 into slot 7
1356  F380              ORG     $C000
1357  C000              tilemap_part1:
1358  C000              INCBIN  "testmaze2.map", 0, 16384                    ; first 16 KB
1359  0000
1360  0000              ; === Chunk 2 (bytes 16384-32767) -> 8 KB Page 42/43 ===
1361  0000              MMU     6, TILEMAP_PAGE + 2
1362  0000              MMU     7, TILEMAP_PAGE + 3
1363  0000              ORG     $C000
1364  C000              tilemap_part2:
1365  C000              INCBIN  "testmaze2.map", 16384, 16384
1366  0000
1367  0000              ; === Chunk 3 (bytes 32768-49151) -> 8 KB Page 44/45 ===
1368  0000              MMU     6, TILEMAP_PAGE + 4
1369  0000              MMU     7, TILEMAP_PAGE + 5
1370  0000              ORG     $C000
1371  C000              tilemap_part3:
1372  C000              INCBIN  "testmaze2.map", 32768, 16384
1373  0000
1374  0000              ; ----------------------------------------------------------------
1375  0000              ; Distance field - 48 KB, one byte per maze cell (256x192).
1376  0000              ; Same layout as the map (256-byte rows) but in pages 46-51, so the
1377  0000              ; tile (x,y) -> address arithmetic is identical to GET_WORLD_VALUE
1378  0000              ; with base page DFIELD_PAGE instead of TILEMAP_PAGE.
1379  0000              ; Filled by the flood-fill; 255 = wall/unvisited/unreachable.
1380  0000              ; ----------------------------------------------------------------
1381  0000              DFIELD_PAGE     EQU     TILEMAP_PAGE + 6
1382  0000
1383  0000              ; reserve the six pages so they exist in the .nex (contents set at runtime)
1384  0000              MMU     6, DFIELD_PAGE
1385  0000              MMU     7, DFIELD_PAGE + 1
1386  0000              ORG     $C000
1387  C000              dfield_part1:
1388  C000 00 00 00...  DEFS    16384
1389  0000
1390  0000              MMU     6, DFIELD_PAGE + 2
1391  0000              MMU     7, DFIELD_PAGE + 3
1392  0000              ORG     $C000
1393  C000              dfield_part2:
1394  C000 00 00 00...  DEFS    16384
1395  0000
1396  0000              MMU     6, DFIELD_PAGE + 4
1397  0000              MMU     7, DFIELD_PAGE + 5
1398  0000              ORG     $C000
1399  C000              dfield_part3:
1400  C000 00 00 00...  DEFS    16384
1401  0000
1402  0000              ; --- radar / Layer 2 ---
1403  0000              L2_PAGE         equ DFIELD_PAGE + 6     ; Layer 2 image pages (52-57), after the field
1404  0000              L2_BANK16       equ L2_PAGE / 2         ; 16K bank number for reg $12 (=26)
1405  0000
1406  0000              MMU 6, L2_PAGE
1407  0000              MMU 7, L2_PAGE + 1
1408  0000              org $C000
1409  C000 00 00 00...  DEFS 16384
1410  0000
1411  0000              MMU 6, L2_PAGE + 2
1412  0000              MMU 7, L2_PAGE + 3
1413  0000              org $C000
1414  C000 00 00 00...  DEFS 16384
1415  0000
