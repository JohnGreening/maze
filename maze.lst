 829+ 8626              setClipping:
 830+ 8626 ED 91 1C 08          nextreg $1C, %00001000                      ; Reset tilemap clip window index (bit 3 = 1)
 831+ 862A
 832+ 862A                  ; Write the four clip coordinates to register $1B
 833+ 862A                  ; X values are in 2-pixel units (0-159 = full 320px width)
 834+ 862A                  ; Y values are 1:1 pixels (0-255)
 835+ 862A                  ; 4px border = inset of 2 X-units and 4 Y-pixels
 836+ 862A ED 91 1B 02          nextreg $1B, 2                              ; X1 = 2   → left edge  = pixel 4
 837+ 862E ED 91 1B 9D          nextreg $1B, 157                            ; X2 = 157 → right edge = pixel 315 (319-4)
 838+ 8632 ED 91 1B 40          nextreg $1b, 64                             ; Y1 = 64, top 4 border lines + top 4 ULA lines
 839+ 8636 ED 91 1B FB          nextreg $1B, 251                            ; Y2 = 251 → bottom edge= pixel 251 (255-4)
 840+ 863A
 841+ 863A                  ; setSpriteClip - clip sprites to the play area (below the HUD).
 842+ 863A                  ; Over-border mode is active, so:
 843+ 863A                  ;   - X coords use the SAME doubling as the tilemap clip (copy 2,157)
 844+ 863A                  ;   - Y coords are in sprite space: ULA-origin pixel + 32
 845+ 863A                  ;       tilemap top  pixel 64  -> 64+32 = 96
 846+ 863A                  ;       tilemap bot  pixel 251 -> 283 (overflows) -> clamp to 255
 847+ 863A                  ; Requires $15 bit 5 (clip-over-border) set - see note.
 848+ 863A ED 91 15 23          NEXTREG $15, %00100011                      ; was %00010111; bit 5 = enable sprite clip over border
 849+ 863E
 850+ 863E ED 91 1C 02          nextreg $1C, 2                              ; bit 1 = reset the SPRITE clip index
 851+ 8642 ED 91 19 00          nextreg $19, 0                              ; X1 (doubled units, same as tilemap) -> pixel 4
 852+ 8646 ED 91 19 9F          nextreg $19, 159                            ; X2 -> pixel 315
 853+ 864A ED 91 19 40          nextreg $19, 64                             ; Y1 = 64 -> top of play area
 854+ 864E ED 91 19 FF          nextreg $19, 255                            ; Y2 = clamp (283 overflows a byte; screen edge handles bottom)
 855+ 8652 C9                   ret
