1260  9CC1              displayBaddie:
1261  9CC1                  ; ============================================================
1262  9CC1                  ; Draw baddie sprite (sprite #1) relative to the centred player.
1263  9CC1                  ; Player is locked to screen centre, so:
1264  9CC1                  ;     screenPos = baddieWorldPos - playerWorldPos + screenCentre
1265  9CC1                  ; A 16x16 sprite is shown whenever ANY part overlaps the display,
1266  9CC1                  ; so we allow up to 15px of overhang at each edge before hiding.
1267  9CC1                  ; IX already points at the baddie record (set by processBaddies).
1268  9CC1                  ; ============================================================
1269  9CC1
1270  9CC1 3A 6A 93             ld a, (viewMode)
1271  9CC4 B7                   or a
1272  9CC5 C2 37 9D             jp nz, radarBaddie
1273  9CC8
1274  9CC8                  ; ---------- SCREEN X ----------
1275  9CC8                      ; HL = baddie world X
1276  9CC8 DD 6E 01             ld l, (ix + baddieRecord.lowX)
1277  9CCB DD 66 02             ld h, (ix + baddieRecord.highX)
1278  9CCE ED 4B B3 8E          ld bc, (cam_px)                             ; BC = player world X
1279  9CD2 B7                   or a                                        ; clear carry for a clean subtract
1280  9CD3 ED 42                sbc hl, bc                                  ; HL = baddieX - playerX  (signed)
1281  9CD5                  ; add screen centre AND the 15px overhang bias in one go.
1282  9CD5                  ; CENTER_SCREEN_X + 15 = 152 + 15 = 167, which fits in 8 bits,
1283  9CD5                  ; so we can use the Z80N "add hl,a" (cheaper to set up than add hl,bc).
1284  9CD5 3E 0F                ld a,  15                                   ; A = 167  (centre + bias)
1285  9CD7 ED 31                add hl, a                                   ; Z80N: HL = biased screen X
1286  9CD9                  ; HL now holds (screenX + 15). Visible-with-overhang means the
1287  9CD9                  ; UN-biased X is in -15..319, i.e. the BIASED value is in 0..334.
1288  9CD9                  ; Reject anything outside 0..334 with an unsigned range test.
1289  9CD9 7C                   ld a, h                                     ; look at high byte of biased X
1290  9CDA FE 01                cp 1                                        ; H = 0 ?  (biased X = 0..255)
1291  9CDC 38 07                jr c, .xInRange                             ; H = 0 -> definitely <= 334, in range
1292  9CDE 20 4C                jr nz, .hideBaddie                          ; H >= 2 -> biased X >= 512 -> off right
1293  9CE0                  ; H = 1 here, so biased X = 256..511; allowed only up to 334 ($014E),
1294  9CE0                  ; meaning the low byte must be < 79 (334 - 256 = 78).
1295  9CE0 7D                   ld a, l
1296  9CE1 FE 4F                cp 79
1297  9CE3 30 47                jr nc, .hideBaddie                          ; low byte >= 79 -> off right edge
1298  9CE5              .xInRange:
1299  9CE5 E5                   push hl                                     ; save biased X (we still need it later)
1300  9CE6
1301  9CE6                  ; ---------- SCREEN Y ----------
1302  9CE6                  ; HL = baddie world Y
1303  9CE6 DD 6E 03             ld l, (ix + baddieRecord.lowY)
1304  9CE9 DD 66 04             ld h, (ix + baddieRecord.highY)
1305  9CEC ED 4B B5 8E          ld bc, (cam_py)             ; BC = player world Y
1306  9CF0 B7                   or a                           ; clear carry
1307  9CF1 ED 42                sbc hl, bc                     ; HL = baddieY - playerY  (signed)
1308  9CF3                  ; centre + bias again: CENTER_SCREEN_Y + 15 = 120 + 15 = 135, fits in 8 bits.
1309  9CF3 3E 0F                ld a, 15     ; A = 135
1310  9CF5 ED 31                add hl, a                      ; Z80N: HL = biased screen Y
1311  9CF7                  ; Visible-with-overhang: un-biased Y in -15..255, i.e. biased Y in 0..270.
1312  9CF7 7C                   ld a, h                        ; high byte of biased Y
1313  9CF8 FE 01                cp 1                           ; H = 0 ?
1314  9CFA 38 07                jr c, .yInRange                ; H = 0 -> <= 270, in range
1315  9CFC 20 2D                jr nz, .hidePop                ; H >= 2 -> off bottom
1316  9CFE                  ; H = 1: biased Y = 256..511, allowed only up to 270 ($010E),
1317  9CFE                  ; so low byte must be < 15 (270 - 256 = 14).
1318  9CFE 7D                   ld a, l
1319  9CFF FE 0F                cp 15
1320  9D01 30 28                jr nc, .hidePop                ; low byte >= 15 -> off bottom edge
1321  9D03              .yInRange:
1322  9D03                  ; ---------- BADDIE IS ON SCREEN ----------
1323  9D03                  ; Un-bias Y by 15 to get the real Y the hardware wants.
1324  9D03                  ; The sprite Y register is 8-bit and takes the value mod 256,
1325  9D03                  ; which is exactly what we need: a baddie 15px above the top
1326  9D03                  ; (real Y = -15) writes 241, and the hardware draws it overhanging.
1327  9D03 7D                   ld a, l                        ; low byte of biased Y
1328  9D04 D6 0F                sub 15                         ; A = real screen Y (mod 256)
1329  9D06 5F                   ld e, a                        ; stash Y in E for the moment
1330  9D07
1331  9D07 E1                   pop hl                         ; recover biased X
1332  9D08 01 0F 00             ld bc, 15
1333  9D0B B7                   or a                           ; clear carry
1334  9D0C ED 42                sbc hl, bc                     ; HL = real screen X (full 9-bit value)
