 540  96C2             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 540  96C2             >;
 540  96C2             >;       arg  is TILEMAP_PAGE
 540  96C2             >;            or DFIELD_PAGE
 540  96C2             >;
 540  96C2             >;       arg1 decides if input comes from BC or directly from HL
