 651  97C0              wait_vblank:
 652  97C0              .loop
 653  97C0 01 3B 24             ld bc, $243B                                ; register select port
 654  97C3 3E 1E                ld a, $1E
 655  97C5 ED 79                out (c), a                                  ; select ULA status register
 656  97C7 04                   inc b                                       ; now point to data port $253B
 657  97C8 ED 78                in a, (c)                                   ; read status
 658  97CA CB 47                bit 0, a
 659  97CC 28 F2                jr z, .loop
 660  97CE C9                   ret
