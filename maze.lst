 449  94D7 3C                   inc a
 450  94D8 32 E4 8E             ld (playerAnimTick), a
 451  94DB FE 04                cp ANIM_SPEED
 452  94DD 38 0D                jr c, .noAdvance                            ; not time to advance frame yet
 453  94DF AF                   xor a
 454  94E0 32 E4 8E             ld (playerAnimTick), a
 455  94E3 3A E3 8E             ld a, (playerAnimFrame)
 456  94E6 3C                   inc a
 457  94E7 E6 03                and 3                                        ; cycle 0-3
 458  94E9 32 E3 8E             ld (playerAnimFrame), a
 459  94EC              .noAdvance:
 460  94EC CD 0E 97             call showSprite                             ; write new pattern (direction + frame)
 461  94EF C3 28 96             jp moveSprite
