  93+ 86FB              ; 8-Bit Binary to Decimal Digits Extraction
  94+ 86FB              ; Input:  A  = 8-bit binary number (0 - 255)
  95+ 86FB              ;         B  = char row (0..23), C = char col (0..31)
  96+ 86FB              ; Calls displayChar with A to display each digit
  97+ 86FB              Bin8ToDec:
  98+ 86FB              ; --- Step 1: Extract 100s Digit ---
  99+ 86FB 1E 2F                ld      e, '0' - 1                          ; Initialize ASCII counter
 100+ 86FD              .Loop100:
 101+ 86FD 1C                   inc     e                                   ; Increment ASCII character
 102+ 86FE D6 64                sub     100                                 ; Subtract 100
 103+ 8700 30 FB                jr      nc, .Loop100                        ; Repeat if no underflow (result >= 0)
 104+ 8702 C6 64                add     a, 100                              ; Restore the remainder (add 100 back)
 105+ 8704
 106+ 8704 57                   ld      d, a                                ; Temporarily save remainder in B
 107+ 8705 7B                   ld      a, e                                ; Get 100s digit
 108+ 8706 CD BD 86             call displayChar
 109+ 8709 7A                   ld      a, d                                ; Restore remainder to A
 110+ 870A
 111+ 870A              ; --- Step 2: Extract 10s Digit ---
 112+ 870A 1E 2F                ld      e, '0' - 1                          ; Re-initialize ASCII counter
 113+ 870C              .Loop10:
 114+ 870C 1C                   inc     e                                   ; Increment ASCII character
 115+ 870D D6 0A                sub     10                                  ; Subtract 10
 116+ 870F 30 FB                jr      nc, .Loop10                         ; Repeat if no underflow (result >= 0)
 117+ 8711 C6 0A                add     a, 10                               ; Restore the remainder (add 10 back)
 118+ 8713
 119+ 8713 57                   ld      d, a                                ; Temporarily save 1s digit in B
 120+ 8714 7B                   ld      a, e                                ; Get 10s digit
 121+ 8715 CD BD 86             call displayChar
 122+ 8718
 123+ 8718              ; --- Step 3: Extract 1s Digit ---
 124+ 8718 7A                   ld      a, d                                ; Restore 1s digit to A
 125+ 8719              DisplayDigit:
 126+ 8719                      ; if calling from here then BC must be set with B=row, C=Column
 127+ 8719 C6 30                add     a, '0'                              ; Convert the leftover 1s digit to ASCII
 128+ 871B CD BD 86             call displayChar
 129+ 871E C9                   ret
