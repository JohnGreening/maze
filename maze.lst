 298+ 7DC8              ; Configure tilemap control
 299+ 7DC8 ED 91 6B A1      NEXTREG $6b, %10100001
 300+ 7DCC              ; bit 7 1= enable tilemap
 301+ 7DCC              ; bit 6 1= 80x32, 0=40x32
 302+ 7DCC              ; bit 5 1= use 6c for attributes (i.e. 1 byte tilemap mode)
 303+ 7DCC              ; bit 4 1= 2nd tilemap palette, 0= first
 304+ 7DCC              ; bit 3 1= activate text mode
 305+ 7DCC              ; bit 2 reserved, set to 0
 306+ 7DCC              ; bit 1 1=512, 0=256 tilemap mode
 307+ 7DCC              ; bit 0 1= force tilemap ontop of ULA
 308+ 7DCC
 309+ 7DCC              ; Default tilemap attribute for 8bit maps
 310+ 7DCC              ; i.e. when using 1 byte tilemap mode
 311+ 7DCC              ; NB limits colours to 0-15
 312+ 7DCC ED 91 6C 01      NEXTREG $6c, %00000001
 313+ 7DD0              ; bit 7-4 Palette offset
 314+ 7DD0              ; bit 3 1=mirror in X direction
 315+ 7DD0              ; bit 2 1=mirror in Y direction
 316+ 7DD0              ; bit 1 1=rotate 90deg clockwise
 317+ 7DD0              ; bit 0 1=ula overtilemap, 0=tilemap over ULA
 318+ 7DD0
 319+ 7DD0              ; ULA control
 320+ 7DD0 ED 91 68 00      NEXTREG $68, $0
 321+ 7DD4              ; bit 7 1=disable ULA output
 322+ 7DD4              ; bit 6 concerned with blending in SLU modes 6/7
 323+ 7DD4              ;       1=select ULA/tilemap mix
 324+ 7DD4              ;       0=select ULA colour
 325+ 7DD4              ; bits 5-1 reserved, always 0
 326+ 7DD4              ; bit 0 1=enable stencil mode when ULA & tilemap enabled
 327+ 7DD4
 328+ 7DD4              ; point to the tilemap and tile pattern data
 329+ 7DD4 ED 91 6E 60      NEXTREG $6e, tileMap / 256
 330+ 7DD8 ED 91 6F 65      NEXTREG $6f, TilePatterns / 256
 331+ 7DDC
 332+ 7DDC              ; Palette Control
 333+ 7DDC              ; set values for Tilemap palette 0
 334+ 7DDC ED 91 43 30      NEXTREG $43, %00110000
 335+ 7DE0              ; bit 7 1=disable palette auto inc
 336+ 7DE0              ; bit 6-4 select palette for r/w
 337+ 7DE0              ; 000 = ULA palette 1
 338+ 7DE0              ; 100 = ULA palette 2
 339+ 7DE0              ; 001 = Layer 2 palette 1
 340+ 7DE0              ; 101 = Layer 2 palette 2
 341+ 7DE0              ; 010 = Sprites palette 1
 342+ 7DE0              ; 110 = Sprites palette 2
 343+ 7DE0              ; 011 = Tilemap palette 1
 344+ 7DE0              ; 111 = Tilemap palette 2
 345+ 7DE0              ; bit 3
 346+ 7DE0              ; bit 2
 347+ 7DE0              ; bit 1
 348+ 7DE0              ; bit 0
 349+ 7DE0
 350+ 7DE0              ; set index of transparent colour in the tile palette
 351+ 7DE0 ED 91 4C 0F    NEXTREG $4C, 015
 352+ 7DE4
 353+ 7DE4
 354+ 7DE4              ; load the colours into the palette memory
 355+ 7DE4              ; here we are using 9 bit colours, so use $44 to do the load
 356+ 7DE4
 357+ 7DE4              ; first initialise the palette index to 0
 358+ 7DE4 ED 91 40 00      NEXTREG $40, 0
 359+ 7DE8
 360+ 7DE8              ; set the number of colours
 361+ 7DE8              ; set location of Tilemap palette data
