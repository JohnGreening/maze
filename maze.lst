  11+ 0000              MACRO DIV_HL_8
  12+ 0000 ~            ; version 1, 48 t-states
  13+ 0000 ~            ; simple 16-bit divide without the CALL/RET overhead
  14+ 0000 ~                    srl h                                       ; divide by 2
  15+ 0000 ~                    rr l
  16+ 0000 ~                    srl h                                       ; divide by 4
  17+ 0000 ~                    rr l
  18+ 0000 ~                    srl h                                       ; divide by 8
  19+ 0000 ~                    rr l
  20+ 0000                      ENDM
  21+ 0000
  22+ 0000              MACRO DIV_HL_8A
  23+ 0000 ~            ; version 2, 40 t-states (8 t-states quicker than DIV_HL_8)
  24+ 0000 ~            ; simple 16-bit divide without the CALL/RET overhead
  25+ 0000 ~                    ld a, l                                     ; get low byte into a ready for rotate from carry   4t
  26+ 0000 ~                    srl h                                       ;                                                   8t
  27+ 0000 ~                    rra                                         ;                                                   4t
  28+ 0000 ~                    srl h                                       ;                                                   8t
  29+ 0000 ~                    rra                                         ;                                                   4t
  30+ 0000 ~                    srl h                                       ;                                                   8t
  31+ 0000 ~                    rra                                         ;                                                   4t
  32+ 0000                      ENDM
  33+ 0000
  34+ 0000              MACRO DIV_HL_8B
  35+ 0000 ~            ; version 3, 19 t-states (21 t-states quicker than A)
  36+ 0000 ~            ; simple 16-bit divide without the CALL/RET overhead
  37+ 0000 ~                    EX DE, HL                                   ;                                                   4t
  38+ 0000 ~                    LD B, 3                                     ;                                                   7t
  39+ 0000 ~                    BSRA DE, B                                       ;                                                   8t
  40+ 0000                      ENDM
  41+ 0000
  42+ 0000              MACRO GET_WORLD_VALUE arg, arg1
  43+ 0000 ~            ; given B= tile X, C= tile Y, return "world" value at this position in the world map
  44+ 0000 ~            ;
  45+ 0000 ~            ;       arg  is TILEMAP_PAGE
  46+ 0000 ~            ;            or DFIELD_PAGE
  47+ 0000 ~            ;
  48+ 0000 ~            ;       arg1 decides if input comes from BC or directly from HL
  49+ 0000 ~            ;            NB if directly from HL then L = tile X, H = tile Y
  50+ 0000 ~            ;
  51+ 0000 ~                    if arg1 = 0
  52+ 0000 ~                    ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
  53+ 0000 ~                                                                ; put it in H (this is the same as multiplying by 256)
  54+ 0000 ~                    ld l, b                                     ; read the X tile coordinate into L
  55+ 0000 ~                                                                ; Result: HL now holds tile_y * 256 + tile_x
  56+ 0000 ~                                                                ; This is the byte offset into "world" map.
  57+ 0000 ~                    endif
  58+ 0000 ~
  59+ 0000 ~                ; STEP 2: Calculate which 8K physical page the data lives in
  60+ 0000 ~                    ld   a,h                                    ; take the high byte of the offset (which is tile_y)
  61+ 0000 ~            ;        srl  a                                      ; divide by 2
  62+ 0000 ~            ;        srl  a                                      ; divide by 2 again  → now /4
  63+ 0000 ~            ;        srl  a                                      ; /8
  64+ 0000 ~            ;        srl  a                                      ; /16
  65+ 0000 ~            ;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
  66+ 0000 ~            ; ------------------------------------------------------------------------
  67+ 0000 ~            ; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
  68+ 0000 ~            ; saves 21 t-state
  69+ 0000 ~            ; ------------------------------------------------------------------------
  70+ 0000 ~                    rlca
  71+ 0000 ~                    rlca
  72+ 0000 ~                    rlca
  73+ 0000 ~                    and 7
  74+ 0000 ~                                                                ; Why divide by 32?
  75+ 0000 ~                                                                ;   Each page is 8192 bytes.
  76+ 0000 ~                                                                ;   Each row is 256 bytes.
  77+ 0000 ~                                                                ;   8192 ÷ 256 = exactly 32 rows per page.
  78+ 0000 ~                                                                ;   Therefore page number = 40 + (tile_y ÷ 32)
  79+ 0000 ~
  80+ 0000 ~                    add  a, arg                                 ; add the starting page number
  81+ 0000 ~                    ld (curWorldPage), a                        ; save page for subsequent reads - likely no need to reload
  82+ 0000 ~                    nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
  83+ 0000 ~
  84+ 0000 ~
  85+ 0000 ~                ; STEP 3: Keep only the part of the address that fits inside one 8K page
  86+ 0000 ~                    ld   a,h                                    ; get the high byte again
  87+ 0000 ~                    and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
  88+ 0000 ~                                                                ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
  89+ 0000 ~                                                                ; (because 8192 = 2^13 and we are discarding everything above bit 12)
  90+ 0000 ~                    or $C0                                      ; "add" page offset
  91+ 0000 ~                    ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
  92+ 0000 ~
  93+ 0000 ~                ; STEP 4: read the byte
  94+ 0000 ~                                                                ; HL now points directly at the first byte we want to copy
  95+ 0000 ~                    ld a, (hl)                                  ; so get the byte
  96+ 0000                      ENDM
  97+ 0000
  98+ 0000              MACRO checkLeftM argX, argY, argMoveDelta
  99+ 0000 ~                    ld hl, (argX)                               ; get X pixel
 100+ 0000 ~                    ld bc, argMoveDelta                         ; move pixel delta
 101+ 0000 ~                    or a                                        ; clear carry
 102+ 0000 ~                    sbc hl, bc                                  ; simulate move left
 103+ 0000 ~                    DIV_HL_8A                                   ; divide by 8 to get tile X
 104+ 0000 ~                    ld b, a                                     ; B = tile X
 105+ 0000 ~
 106+ 0000 ~                    ld hl, (argY)                               ; get Y pixel
 107+ 0000 ~                    DIV_HL_8A                                   ; divide by 8 to get tile Y
 108+ 0000 ~                    ld c, a                                     ; C = tile Y
 109+ 0000 ~
 110+ 0000 ~                    GET_WORLD_VALUE TILEMAP_PAGE, USE_BC        ; see what tile is here
 111+ 0000 ~                    cp MAP_WALL                                 ; is it a wall?
 112+ 0000 ~                    ret z                                       ; return if so, do nothing
 113+ 0000 ~
 114+ 0000 ~            ; ----------------------------------------------------------------
 115+ 0000 ~            ; worldBelow - read the map/field byte one tile-row below the byte
 116+ 0000 ~            ; GET_WORLD_VALUE just fetched. HL still points at that byte.
 117+ 0000 ~            ; Handles the (rare) 8K page cross. Returns tile in A.
 118+ 0000 ~            ; ----------------------------------------------------------------
 119+ 0000 ~            .worldBelow:
 120+ 0000 ~                    inc  h                                      ; +256 bytes = one map row down
 121+ 0000 ~                    ld   a, h                                   ; put in a for compare
 122+ 0000 ~                    cp   $E0                                    ; walked past the end of slot 6 ($C000-$DFFF)?
 123+ 0000 ~                    jr   nz, .same                              ; branch if not
 124+ 0000 ~                    ld   h, $C0                                 ; wrap back to slot-6 base
 125+ 0000 ~                    ld   a, (curWorldPage)                      ; get last saved page
 126+ 0000 ~                    inc  a                                      ; advance it
 127+ 0000 ~                    ld   (curWorldPage), a                      ; save it back
 128+ 0000 ~                    nextreg $56, a                              ; page in new block
 129+ 0000 ~            .same:
 130+ 0000 ~                    ld   a, (hl)                                ; see what tile is here
 131+ 0000 ~                    cp MAP_WALL                                 ; is it a wall?
 132+ 0000 ~                    ret z                                       ; return if so, do nothing
 133+ 0000 ~
 134+ 0000 ~                    set dir_left, e                             ; set bit in E indicating move is allowed
 135+ 0000 ~                    ret
 136+ 0000                      ENDM
 137+ 0000
