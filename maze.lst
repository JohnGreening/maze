 308+ 82CD                      GET_WORLD_VALUE DFIELD_PAGE, USE_HL         ; use common routine to point HL to flood value we want to set
 308+ 82CD             >; given B= tile X, C= tile Y, return "world" value at this position in the world map
 308+ 82CD             >;
 308+ 82CD             >;       arg  is TILEMAP_PAGE
 308+ 82CD             >;            or DFIELD_PAGE
 308+ 82CD             >;
 308+ 82CD             >;       arg1 decides if input comes from BC or directly from HL
 308+ 82CD             >;            NB if directly from HL then L = tile X, H = tile Y
 308+ 82CD             >;
 308+ 82CD             >        if USE_HL = 0
 308+ 82CD ~           >        ld h, c                                     ; read the Y tile coordinate of the top-left corner we want
 308+ 82CD ~           >                                                    ; put it in H (this is the same as multiplying by 256)
 308+ 82CD ~           >        ld l, b                                     ; read the X tile coordinate into L
 308+ 82CD ~           >                                                    ; Result: HL now holds tile_y * 256 + tile_x
 308+ 82CD ~           >                                                    ; This is the byte offset into "world" map.
 308+ 82CD             >        endif
 308+ 82CD             >
 308+ 82CD             >    ; STEP 2: Calculate which 8K physical page the data lives in
 308+ 82CD 7C          >        ld   a,h                                    ; take the high byte of the offset (which is tile_y)
 308+ 82CE             >;        srl  a                                      ; divide by 2
 308+ 82CE             >;        srl  a                                      ; divide by 2 again  → now /4
 308+ 82CE             >;        srl  a                                      ; /8
 308+ 82CE             >;        srl  a                                      ; /16
 308+ 82CE             >;        srl  a                                      ; /32   ← this is the same as tile_y ÷ 32
 308+ 82CE             >; ------------------------------------------------------------------------
 308+ 82CE             >; performance fix, 5 shifts is equiv to 3 in opposite direction (with and)
 308+ 82CE             >; saves 21 t-state
 308+ 82CE             >; ------------------------------------------------------------------------
 308+ 82CE 07          >        rlca
 308+ 82CF 07          >        rlca
 308+ 82D0 07          >        rlca
 308+ 82D1 E6 07       >        and 7
 308+ 82D3             >                                                    ; Why divide by 32?
 308+ 82D3             >                                                    ;   Each page is 8192 bytes.
 308+ 82D3             >                                                    ;   Each row is 256 bytes.
 308+ 82D3             >                                                    ;   8192 ÷ 256 = exactly 32 rows per page.
 308+ 82D3             >                                                    ;   Therefore page number = 40 + (tile_y ÷ 32)
 308+ 82D3             >
 308+ 82D3 C6 2E       >        add  a, DFIELD_PAGE                                 ; add the starting page number
 308+ 82D5 32 6B 8F    >        ld (curWorldPage), a                        ; save page for subsequent reads - likely no need to reload
 308+ 82D8 ED 92 56    >        nextreg $56,a                               ; set MMU slot 6 ($C000-$DFFF) to that page
 308+ 82DB             >
 308+ 82DB             >
 308+ 82DB             >    ; STEP 3: Keep only the part of the address that fits inside one 8K page
 308+ 82DB 7C          >        ld   a,h                                    ; get the high byte again
 308+ 82DC E6 1F       >        and  $1F                                    ; $1F is binary 00011111 → keeps only the lowest 5 bits
 308+ 82DE             >                                                    ; This is exactly the same as (tile_y * 256 + tile_x) modulo 8192
 308+ 82DE             >                                                    ; (because 8192 = 2^13 and we are discarding everything above bit 12)
 308+ 82DE F6 C0       >        or $C0                                      ; "add" page offset
 308+ 82E0 67          >        ld   h,a                                    ; HL now holds the offset *inside* the current 8K page
 308+ 82E1             >
 308+ 82E1             >    ; STEP 4: read the byte
 308+ 82E1             >                                                    ; HL now points directly at the first byte we want to copy
 308+ 82E1 7E          >        ld a, (hl)                                  ; so get the byte
 309+ 82E2 36 00                ld (hl), 0                                  ; set initial flood value to 0
