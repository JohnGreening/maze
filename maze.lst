1396  9D71 7B                   ld a, e
1397  9D72 ED 92 36             NEXTREG $36, a                 ; attr 1: Y (8-bit)
1398  9D75 7C                   ld a, h
1399  9D76 E6 01                and 1                          ; X is 9-bit; keep only bit 8
1400  9D78 ED 92 37             NEXTREG $37, a                 ; attr 2: X MSB in bit 0
1401  9D7B 3E 03                ld a, 3
1402  9D7D F6 80                or %10000000                   ; bit 7 = visible
1403  9D7F ED 92 38             NEXTREG $38, a                 ; attr 3: pattern + visible flag
