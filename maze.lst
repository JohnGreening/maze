 785+ 859A              setClipping:
 786+ 859A ED 91 1C 08          nextreg $1C, %00001000                      ; Reset tilemap clip window index (bit 3 = 1)
 787+ 859E
 788+ 859E                  ; Write the four clip coordinates to register $1B
 789+ 859E                  ; X values are in 2-pixel units (0-159 = full 320px width)
 790+ 859E                  ; Y values are 1:1 pixels (0-255)
 791+ 859E                  ; 4px border = inset of 2 X-units and 4 Y-pixels
 792+ 859E ED 91 1B 02          nextreg $1B, 2                              ; X1 = 2   → left edge  = pixel 4
 793+ 85A2 ED 91 1B 9D          nextreg $1B, 157                            ; X2 = 157 → right edge = pixel 315 (319-4)
 794+ 85A6 ED 91 1B 40          nextreg $1b, 64                             ; Y1 = 64, top 4 border lines + top 4 ULA lines
 795+ 85AA ED 91 1B FB          nextreg $1B, 251                            ; Y2 = 251 → bottom edge= pixel 251 (255-4)
 796+ 85AE
 797+ 85AE                  ; setSpriteClip - clip sprites to the play area (below the HUD).
 798+ 85AE                  ; Over-border mode is active, so:
 799+ 85AE                  ;   - X coords use the SAME doubling as the tilemap clip (copy 2,157)
 800+ 85AE                  ;   - Y coords are in sprite space: ULA-origin pixel + 32
 801+ 85AE                  ;       tilemap top  pixel 64  -> 64+32 = 96
 802+ 85AE                  ;       tilemap bot  pixel 251 -> 283 (overflows) -> clamp to 255
 803+ 85AE                  ; Requires $15 bit 5 (clip-over-border) set - see note.
 804+ 85AE ED 91 15 23          NEXTREG $15, %00100011                      ; was %00010111; bit 5 = enable sprite clip over border
 805+ 85B2
 806+ 85B2 ED 91 1C 02          nextreg $1C, 2                              ; bit 1 = reset the SPRITE clip index
 807+ 85B6 ED 91 19 00          nextreg $19, 0                              ; X1 (doubled units, same as tilemap) -> pixel 4
 808+ 85BA ED 91 19 9F          nextreg $19, 159                            ; X2 -> pixel 315
 809+ 85BE ED 91 19 40          nextreg $19, 64                             ; Y1 = 64 -> top of play area
 810+ 85C2 ED 91 19 FF          nextreg $19, 255                            ; Y2 = clamp (283 overflows a byte; screen edge handles bottom)
 811+ 85C6 C9                   ret
