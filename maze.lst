 526+ 8416              ; ============================================================
 527+ 8416              ; buildMapImage - render the whole 256x192 map into Layer 2
 528+ 8416              ;
 529+ 8416              ; Optimised: the slot-6 page offset (y/32) and the in-page
 530+ 8416              ; address high byte ((y&$1F)|$C0) are constant for a whole row,
 531+ 8416              ; so they are computed ONCE per row. Columns are walked with
 532+ 8416              ; INC L (L = x, wraps 255->0). The three per-cell bank switches
 533+ 8416              ; (map / field / radar, all at the same $C000 address) are
 534+ 8416              ; unavoidable and remain.
 535+ 8416              ;
 536+ 8416              ; Trashes: AF, BC, DE, HL
 537+ 8416              ; ============================================================
 538+ 8416              tileColour:
 539+ 8416 00                   db L2_PATH      ; 0  path  (entry unused - path goes through flood check)
 540+ 8417 E0                   db L2_WALL      ; 1  wall  -> red
 541+ 8418 E0                   db L2_WALL      ; 2  spare wall
 542+ 8419 E0                   db L2_WALL      ; 3  spare wall
 543+ 841A FC                   db L2_KEY       ; 4  key   -> yellow
 544+ 841B FC                   db L2_KEY       ; 5  key
 545+ 841C FC                   db L2_KEY       ; 6  key
 546+ 841D FC                   db L2_KEY       ; 7  key
