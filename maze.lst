  21+ 869B              displayText:
  22+ 869B              ; IY = text string, terminate with $FF, set AT with 22, Y, X
  23+ 869B              ; corrupts IY, AF, BC
  24+ 869B 01 00 00             ld bc, 0                                    ; set B (y) = 0 and C (x) = 0
  25+ 869E              .loop
  26+ 869E FD 7E 00             ld a, (IY +0)                               ; get control or char to display
  27+ 86A1 FE FF                cp $ff                                      ; end of string
  28+ 86A3 C8                   ret z                                       ; return if so
  29+ 86A4
  30+ 86A4 FE 16                cp 22                                       ; AT control
  31+ 86A6 28 07                jr z, .at                                   ; branch if so
  32+ 86A8
  33+ 86A8 CD BD 86             call displayChar                            ; display char and advance column
  34+ 86AB FD 23                inc iy                                      ; point to next in string
  35+ 86AD 18 EF                jr .loop                                    ; and loop
  36+ 86AF              .at
  37+ 86AF FD 23                inc iy                                      ; point to YX parameters
  38+ 86B1 FD 46 00             ld b, (iy +0)                               ; store Y
  39+ 86B4 FD 23                inc iy                                      ; point to next in string
  40+ 86B6 FD 4E 00             ld c, (iy +0)                               ; store X
  41+ 86B9 FD 23                inc iy                                      ; point to next in string
  42+ 86BB 18 E1                jr .loop                                    ; loop
  43+ 86BD
  44+ 86BD              displayChar:
  45+ 86BD              ; B = char row (0..23), C = char col (0..31), A = char (32..127)
  46+ 86BD              ; corrupts AF, DE, HL
  47+ 86BD C5                   push bc                                     ; save the running Y/X screen positions
  48+ 86BE D5                   push de                                     ; save DE in case of call from Bin8ToDec
